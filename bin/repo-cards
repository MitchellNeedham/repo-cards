#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml"]
# ///
"""Leitner review over per-repo card decks.

Decks live outside the repos they describe, so nothing is written into a working tree.
Content and scheduling state are separate files: regenerating a deck never costs progress.

  repo-cards                       due cards across every registered repo
  repo-cards --repo billing        one repo
  repo-cards --tag outbox,retry    one or more themes
  repo-cards --all                 ignore due dates (cram)
  repo-cards brief --topic payouts read up on one feature before a meeting
  repo-cards topics                what topics a deck defines
  repo-cards stats                 deck health and box distribution
  repo-cards drift                 what changed since a deck was last updated
  repo-cards register PATH         add a repo
  repo-cards home                  print where everything lives
"""

from __future__ import annotations

import argparse
import collections
import datetime as dt
import json
import os
import random
import re
import shutil
import subprocess
import sys
from pathlib import Path

import yaml

# Leitner box -> days until due again. Box 5 is "known", not "finished".
INTERVALS = {1: 1, 2: 2, 3: 4, 4: 8, 5: 16}
MAX_BOX = 5

# Ordering weights. Priority decides what you see first in a capped session; it deliberately
# does NOT touch the intervals above, so a card you demonstrably know still backs off to 16
# days however load-bearing it is.
#
# JITTER is wider than the gap between tiers on purpose: a priority-2 card can beat a
# priority-1 card on any given day, so the order varies and you are not drilling the same
# fifteen in the same sequence forever.
#
# OVERDUE_PER_DAY is the starvation guard, and it is not optional. Simulated over 180 days
# at 15 cards a day across eight decks (~640 cards), a weighted order with no escalation
# left 455 cards never seen at all: the tail cannot out-rank 185 foundational cards, ever.
# A gentle slope with a high cap fixes it without flattening the weighting, because a card
# only overtakes a tier after weeks of neglect rather than days. The same simulation puts
# the starvation cliff just above a 1.0 tier gap, so the gap here stays well clear of it.
PRIORITY_WEIGHT = {1: 0.0, 2: 0.6, 3: 1.2}
DEFAULT_PRIORITY = 2
JITTER = 1.4
RECENT_DAYS = 30        # a card added or rewritten this recently is still bedding in
RECENT_BOOST = 0.6
OVERDUE_PER_DAY = 0.05
OVERDUE_CAP = 3.5

# Churn. A card whose anchor is being edited every week is knowledge at risk: the code is
# live, people are making decisions against it now, and being wrong about it costs today.
# A card anchored on a file nobody has touched in three years is settled, and worth less of
# a short session. Normalised against the deck's own 90th percentile, because "a lot of
# commits" means something different in a two-month-old repo and a ten-year-old one, and
# floored so a repo where nothing moves hands out no boosts at all.
CHURN_WINDOW_DAYS = 180
CHURN_FLOOR = 3
CHURN_WEIGHT = 0.5

C = {
    "dim": "\033[2m", "bold": "\033[1m", "reset": "\033[0m",
    "green": "\033[32m", "red": "\033[31m", "yellow": "\033[33m", "cyan": "\033[36m",
}
if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
    C = dict.fromkeys(C, "")
if sys.platform == "win32":
    # Windows terminals only interpret these once a process asks for it.
    os.system("")  # noqa: S605, S607


def data_home() -> Path:
    """Where decks, state and notes live.

    REPO_CARDS_HOME wins, then XDG_DATA_HOME on any platform (a user who sets it means it),
    then the platform's own convention.
    """
    if env := os.environ.get("REPO_CARDS_HOME"):
        return Path(env).expanduser()
    if xdg := os.environ.get("XDG_DATA_HOME"):
        return Path(xdg).expanduser() / "repo-cards"
    if sys.platform == "win32":
        base = os.environ.get("LOCALAPPDATA") or os.environ.get("APPDATA")
        return (Path(base) if base else Path.home() / "AppData" / "Local") / "repo-cards"
    if sys.platform == "darwin":
        return Path.home() / "Library" / "Application Support" / "repo-cards"
    return Path.home() / ".local" / "share" / "repo-cards"


def registry_path() -> Path:
    return data_home() / "registry.json"


def deck_dir(name: str) -> Path:
    return data_home() / name


def deck_path(name: str) -> Path:
    return deck_dir(name) / "deck.yaml"


def state_file(name: str) -> Path:
    return deck_dir(name) / "state.json"


def today() -> dt.date:
    return dt.date.today()


# --- registry and decks ------------------------------------------------------

def load_registry() -> list[dict]:
    p = registry_path()
    if not p.exists():
        return []
    try:
        return json.loads(p.read_text()).get("repos", [])
    except json.JSONDecodeError:
        print(f"{C['red']}! registry is not valid JSON: {p}{C['reset']}")
        return []


def save_registry(repos: list[dict]) -> None:
    p = registry_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps({"repos": repos}, indent=2) + "\n")


def load_deck(entry: dict, quiet: bool = False) -> tuple[dict, list[dict]] | None:
    path = deck_path(entry["name"])
    if not path.exists():
        if not quiet:
            print(f"{C['yellow']}! no deck for {entry['name']} at {path}{C['reset']}")
        return None
    try:
        deck = yaml.safe_load(path.read_text()) or {}
    except yaml.YAMLError as err:
        print(f"{C['red']}! deck for {entry['name']} does not parse: {err}{C['reset']}")
        return None
    return deck, deck.get("cards") or []


def load_state(name: str) -> dict:
    p = state_file(name)
    if not p.exists():
        return {}
    try:
        return json.loads(p.read_text())
    except json.JSONDecodeError:
        # A corrupt state file costs scheduling, not cards. Start over rather than refuse to run.
        print(f"{C['yellow']}! state unreadable, starting fresh: {p}{C['reset']}")
        return {}


def save_state(name: str, state: dict) -> None:
    # Only graded cards are persisted. Scheduling a card nobody has seen is the same as having
    # no row for it, and 80 identical defaults make the file unreadable.
    seen = {cid: cs for cid, cs in state.items() if cs.get("seen", 0) > 0}
    p = state_file(name)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(seen, indent=2, sort_keys=True) + "\n")


def card_state(state: dict, card_id: str) -> dict:
    return state.setdefault(card_id, {"box": 1, "due": today().isoformat(), "seen": 0, "lapses": 0})


def is_due(cs: dict) -> bool:
    return dt.date.fromisoformat(cs["due"]) <= today()


def look_entries(card: dict) -> list[tuple[str, str]]:
    """`look` as (path[#symbol], what you would find there).

    Distinct from `anchor`, which names the one place the fact is *defined* and is what
    drift tracks precisely. `look` is the route you would take to answer the question
    yourself: the test that pins it, the decision that argued it, the caller that shows why.
    """
    look = card.get("look") or {}
    if isinstance(look, dict):
        return [(str(k), str(v)) for k, v in look.items()]
    # A bare list is accepted so a hand-edited card with no descriptions still works.
    return [(str(x), "") for x in look]


def all_paths(card: dict) -> list[str]:
    """Every repo path a card points at, anchor first, symbols stripped."""
    out = [str(card.get("anchor", "")).split("#")[0]]
    out += [pth.split("#")[0] for pth, _ in look_entries(card)]
    return [x for x in out if x]


def priority_of(card: dict) -> int:
    pri = card.get("priority", DEFAULT_PRIORITY)
    return pri if pri in PRIORITY_WEIGHT else DEFAULT_PRIORITY


def card_date(card: dict, deck: dict) -> dt.date | None:
    """When this card last changed. Falls back to the deck's first generation.

    The deck is not in git, so nothing else can answer this: `added` and `updated` are
    written by the skill, and a card carrying neither is as old as the deck.
    """
    raw = card.get("updated") or card.get("added") or deck.get("generated")
    if not raw:
        return None
    try:
        return dt.date.fromisoformat(str(raw))
    except ValueError:
        return None


def repo_churn(root: Path, days: int = CHURN_WINDOW_DAYS) -> dict[str, int]:
    """Commits touching each path in the window. One git call for the whole repo."""
    out = git(root, "log", f"--since={days} days ago", "--name-only", "--pretty=format:")
    counts: dict[str, int] = {}
    for line in out.split("\n"):
        if line := line.strip():
            counts[line] = counts.get(line, 0) + 1
    return counts


def churn_context(entry: dict, cards: list[dict]) -> tuple[dict[str, int], float]:
    """Churn counts plus the deck's own 90th percentile, which is what normalises them."""
    root = Path(entry["root"]).expanduser()
    if not root.is_dir():
        return {}, 0.0
    counts = repo_churn(root)
    vals = sorted(counts.get(str(c.get("anchor", "")).split("#")[0], 0) for c in cards)
    p90 = vals[int(len(vals) * 0.9)] if vals else 0
    return counts, float(p90)


def churn_boost(card: dict, counts: dict[str, int], p90: float) -> float:
    """How much this card's anchor is moving, as a 0..CHURN_WEIGHT bonus."""
    if p90 <= CHURN_FLOOR:
        return 0.0
    n = counts.get(str(card.get("anchor", "")).split("#")[0], 0)
    if n <= CHURN_FLOOR:
        return 0.0
    return CHURN_WEIGHT * min(1.0, (n - CHURN_FLOOR) / (p90 - CHURN_FLOOR))


def order_score(card: dict, deck: dict, cs: dict, churn: tuple[dict, float] = ({}, 0.0)) -> float:
    """Lower sorts earlier. Weighted, not absolute: see JITTER and OVERDUE_PER_DAY."""
    score = PRIORITY_WEIGHT[priority_of(card)]
    when = card_date(card, deck)
    if when is not None and (today() - when).days <= RECENT_DAYS:
        score -= RECENT_BOOST
    score -= churn_boost(card, churn[0], churn[1])
    try:
        overdue = (today() - dt.date.fromisoformat(cs["due"])).days
    except (KeyError, ValueError):
        overdue = 0
    if overdue > 0:
        score -= min(overdue * OVERDUE_PER_DAY, OVERDUE_CAP)
    return score + random.random() * JITTER


def wanted_tags(args) -> set[str]:
    """--tag takes one name or a comma-separated list, matched as OR."""
    return {t.strip() for t in (args.tag or "").split(",") if t.strip()}


def compile_grep(pattern: str | None):
    """--grep is a regex, falling back to a literal search when it does not compile.

    A pattern like `plan(` is a typo in one reading and a literal in the other. Searching for
    it literally is the answer nobody has to debug.
    """
    if not pattern:
        return None
    try:
        return re.compile(pattern, re.IGNORECASE)
    except re.error:
        return re.compile(re.escape(pattern), re.IGNORECASE)


def card_matches(card: dict, tags: set[str], grep) -> bool:
    if tags and not (tags & set(card.get("tags", []))):
        return False
    if grep:
        hay = " ".join([
            card["id"], str(card.get("q", "")), str(card.get("a", "")),
            str(card.get("anchor", "")), " ".join(card.get("tags", [])),
        ])
        if not grep.search(hay):
            return False
    return True


def topic_cards(deck: dict, name: str) -> tuple[dict | None, list[dict], list[str]]:
    """A topic's cards in the order the topic declares, plus any ids that no longer exist.

    Order is the point: a topic is read to rebuild a mental model, and the story runs in a
    direction. Missing ids are returned rather than skipped silently, because they mean the
    topic outlived a card and the deck needs an update.
    """
    topic = (deck.get("topics") or {}).get(name)
    if topic is None:
        return None, [], []
    by_id = {c["id"]: c for c in deck.get("cards") or []}
    wanted = topic.get("cards") or []
    return topic, [by_id[cid] for cid in wanted if cid in by_id], [cid for cid in wanted if cid not in by_id]


def collect(args) -> list[tuple[dict, dict, dict, dict, tuple]]:
    """Gather (entry, card, state, deck, churn) in scope. State and churn are per deck."""
    out, states = [], {}
    tags, grep = wanted_tags(args), compile_grep(args.grep)
    for entry in load_registry():
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=not args.repo)
        if loaded is None:
            continue
        deck, cards = loaded
        if args.topic:
            _topic, cards, _missing = topic_cards(deck, args.topic)
            if not cards:
                continue
        state = states.setdefault(entry["name"], load_state(entry["name"]))
        churn = churn_context(entry, cards)
        for card in cards:
            if not card_matches(card, tags, grep):
                continue
            cs = card_state(state, card["id"])
            if args.priority and priority_of(card) != args.priority:
                continue
            if args.new and cs["seen"] > 0:
                continue
            if not args.all and not args.new and not is_due(cs):
                continue
            out.append((entry, card, state, deck, churn))
    return out


# --- rendering ---------------------------------------------------------------

LIST_MARKER = re.compile(r"^(\s*)((?:\d+[.)]|[-*\u2022])\s+)")


def wrap(text: str, width: int, indent: str = "  ") -> str:
    """Indent and wrap, leaving deliberate layout intact.

    A value written as a YAML literal block (`|-`) is multi-line because the author laid it
    out. Reflowing a table destroys the thing that made it readable, so a multi-line value
    is only indented, and wrapped per line if a line is genuinely too long.

    A numbered or bulleted list is the exception: its items are prose that happens to be
    numbered, so they are rejoined and refilled under a hanging indent. A table has no list
    marker, which is what keeps the two apart.
    """
    raw = str(text).rstrip()
    preformatted = "\n" in raw

    def fill(para: str, hang: str, first: str | None = None) -> list[str]:
        out, cur = [], ""
        lead = first if first is not None else hang
        for word in para.split():
            if cur and len(cur) + len(word) + 1 + len(lead if not out else hang) > width:
                out.append((lead if not out else hang) + cur)
                cur = word
            else:
                cur = f"{cur} {word}".strip()
        if cur:
            out.append((lead if not out else hang) + cur)
        return out

    if not preformatted:
        return "\n".join(fill(raw, indent))

    if any(LIST_MARKER.match(ln) for ln in raw.split("\n")):
        # Regroup into items, so a wrapped item does not leave orphan fragments behind.
        items: list[tuple[str, str]] = []   # (marker prefix, text)
        for ln in raw.split("\n"):
            if m := LIST_MARKER.match(ln):
                items.append((m.group(1) + m.group(2), ln[m.end():]))
            elif items and ln.strip():
                items[-1] = (items[-1][0], items[-1][1] + " " + ln.strip())
            elif not ln.strip():
                items.append(("", ""))
        out: list[str] = []
        for prefix, body in items:
            if not prefix and not body:
                out.append("")
                continue
            out.extend(fill(body, indent + " " * len(prefix), first=indent + prefix))
        return "\n".join(out)

    # A block can be a table with prose under it. A line carrying an internal run of two or
    # more spaces is column alignment; consecutive prose lines are otherwise rejoined before
    # filling, so no orphan fragments are left behind.
    #
    # If the block contains ANY aligned line it is treated as a table throughout and nothing
    # is joined. A row whose first column is long enough to eat its own padding looks like
    # prose to this test, and merging a table row into a paragraph is far worse than leaving
    # a short line where a fill would have tidied it.
    def aligned(ln: str) -> bool:
        return "  " in ln.strip()

    if any(aligned(ln) for ln in raw.split("\n") if ln.strip()):
        # Emitted verbatim even when a row is wider than the terminal. Filling it would
        # collapse the padding that makes it a table, and a soft-wrapped row still carries
        # its data; a reflowed one does not.
        return "\n".join(indent + ln if ln.strip() else "" for ln in raw.split("\n"))

    lines, buf = [], []

    def flush() -> None:
        if buf:
            lines.extend(fill(" ".join(buf), indent))
            buf.clear()

    for para in raw.split("\n"):
        if not para.strip():
            flush()
            lines.append("")
        elif aligned(para):
            flush()
            if len(para) + len(indent) <= width:
                lines.append(indent + para)
            else:
                lead = " " * (len(para) - len(para.lstrip()))
                lines.extend(fill(para, indent + lead))
        else:
            buf.append(para.strip())
    flush()
    return "\n".join(lines)


def prompt(msg: str) -> str:
    try:
        return input(msg).strip().lower()
    except (EOFError, KeyboardInterrupt):
        return "q"


# --- review ------------------------------------------------------------------

def cmd_review(args) -> int:
    queue = collect(args)
    if not queue:
        scope = f" tagged {args.tag}" if args.tag else ""
        if not load_registry():
            print("No repos registered. Add one with: repo-cards register /path/to/repo")
            return 0
        print(f"{C['green']}Nothing due{scope}.{C['reset']} {C['dim']}--all to cram, --new for unseen.{C['reset']}")
        return 0

    # Weighted, not shuffled: load-bearing and recently-changed cards land near the front,
    # so a capped session spends its budget on what costs most to be wrong about.
    queue.sort(key=lambda row: order_score(row[1], row[3], card_state(row[2], row[1]["id"]), row[4]))
    if args.limit:
        queue = queue[: args.limit]

    width = min(shutil.get_terminal_size((90, 24)).columns, 96)
    touched: dict[str, dict] = {}
    right = wrong = skipped = 0

    print(f"\n{C['bold']}{len(queue)} card(s){C['reset']} {C['dim']}[enter] reveal  y got it  n missed  s skip  q quit{C['reset']}\n")

    for n, (entry, card, state, deck, _churn) in enumerate(queue, 1):
        cs = card_state(state, card["id"])
        print("─" * width)
        star = "★" * (4 - priority_of(card))
        print(f"{C['dim']}{n}/{len(queue)}  {entry['name']}  box {cs['box']}  {star}  {' '.join(card.get('tags', []))}{C['reset']}\n")
        print(f"{C['bold']}{wrap(card['q'], width)}{C['reset']}\n")
        # Under the question, not under the answer: the point is that you could go and find
        # it, which only helps before the answer is on screen.
        for n_, (pth, what) in enumerate(look_entries(card)):
            label = "  look:  " if n_ == 0 else "         "
            print(f"{C['dim']}{label}{pth}{('  ' + what) if what else ''}{C['reset']}")
        if look_entries(card):
            print()

        if (ans := prompt(f"{C['dim']}  [enter] reveal, s skip, q quit > {C['reset']}")) == "q":
            break
        if ans == "s":
            skipped += 1
            print()
            continue

        print(f"\n{C['cyan']}{wrap(card['a'], width)}{C['reset']}")
        print(f"\n{C['dim']}  anchor: {card.get('anchor', '-')}{C['reset']}\n")

        while (grade := prompt(f"  {C['green']}y{C['reset']} got it / {C['red']}n{C['reset']} missed / s skip / q quit > ")) not in ("y", "n", "s", "q"):
            pass
        if grade == "q":
            break
        if grade == "s":
            skipped += 1
            print()
            continue

        # Marked dirty here, not on display: quitting before grading anything should leave
        # no state file at all, rather than one that says nothing.
        touched[entry["name"]] = state
        cs["seen"] += 1
        cs["last_seen"] = today().isoformat()
        if grade == "y":
            right += 1
            cs["box"] = min(cs["box"] + 1, MAX_BOX)
        else:
            wrong += 1
            cs["lapses"] += 1
            cs["box"] = 1  # a fact you have lost is not most of the way to known
        cs["due"] = (today() + dt.timedelta(days=INTERVALS[cs["box"]])).isoformat()
        print()

    for name, state in touched.items():
        save_state(name, state)

    graded = right + wrong
    print("─" * width)
    print(f"{C['bold']}{right} right, {wrong} missed, {skipped} skipped{C['reset']}"
          f"  {C['dim']}({round(100 * right / graded)}%){C['reset']}" if graded else
          f"{C['bold']}{skipped} skipped{C['reset']}")
    if wrong:
        print(f"{C['dim']}Missed cards are back in box 1 and due tomorrow.{C['reset']}")
    return 0


# --- stats, list -------------------------------------------------------------

def cmd_stats(args) -> int:
    repos = load_registry()
    if not repos:
        print("No repos registered. Add one with: repo-cards register /path/to/repo")
        return 0
    for entry in repos:
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=not args.repo)
        if loaded is None:
            continue
        deck, cards = loaded
        state = load_state(entry["name"])
        boxes = dict.fromkeys(range(1, MAX_BOX + 1), 0)
        due = unseen = 0
        for card in cards:
            cs = state.get(card["id"])
            if cs is None:
                unseen += 1
                due += 1
                boxes[1] += 1
                continue
            boxes[cs["box"]] += 1
            if is_due(cs):
                due += 1
        bar = "  ".join(f"{'▁▃▅▆█'[b - 1]} box{b} {C['dim']}{boxes[b]}{C['reset']}" for b in range(1, MAX_BOX + 1))
        print(f"\n{C['bold']}{entry['name']}{C['reset']}  {C['dim']}{len(cards)} cards, {deck.get('last_update_sha', '?')}{C['reset']}")
        print(f"  {C['yellow']}{due} due{C['reset']}, {unseen} never seen")
        print(f"  {bar}")
        pri = collections.Counter(priority_of(c) for c in cards)
        routed = sum(1 for c in cards if look_entries(c))
        recent = sum(1 for c in cards if (d := card_date(c, deck)) and (today() - d).days <= RECENT_DAYS)
        print(f"  {C['dim']}★★★ {pri[1]} foundational · ★★ {pri[2]} core · ★ {pri[3]} detail"
              f"{f' · {recent} changed in the last {RECENT_DAYS}d' if recent else ''}{C['reset']}")
        print(f"  {C['dim']}{routed}/{len(cards)} carry a `look` route{C['reset']}")
        counts, p90 = churn_context(entry, cards)
        hot = sorted(((churn_boost(c, counts, p90), c) for c in cards), key=lambda kv: -kv[0])[:3]
        if hot and hot[0][0] > 0:
            names = ", ".join(c["id"] for b, c in hot if b > 0)
            print(f"  {C['dim']}anchors moving most ({CHURN_WINDOW_DAYS}d): {names}{C['reset']}")
        lapsed = sorted(((c, s["lapses"]) for c, s in state.items() if s.get("lapses", 0) >= 2), key=lambda kv: -kv[1])[:5]
        if lapsed:
            print(f"  {C['dim']}stickiest: {', '.join(f'{c} (x{n})' for c, n in lapsed)}{C['reset']}")
    print()
    return 0


def cmd_list(args) -> int:
    for entry in load_registry():
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=not args.repo)
        if loaded is None:
            continue
        _deck, cards = loaded
        state = load_state(entry["name"])
        tags, grep = wanted_tags(args), compile_grep(args.grep)
        for card in sorted(cards, key=priority_of):
            if not card_matches(card, tags, grep):
                continue
            if args.priority and priority_of(card) != args.priority:
                continue
            cs = state.get(card["id"], {"box": 1, "due": "never"})
            flag = f"{C['yellow']}due{C['reset']}" if cs["due"] == "never" or is_due(cs) else f"{C['dim']}{cs['due']}{C['reset']}"
            star = ("★" * (4 - priority_of(card))).ljust(3)
            print(f"  {star} {C['dim']}box{cs['box']}{C['reset']} {flag:>22}  {card['id']:<38} {C['dim']}{','.join(card.get('tags', []))}{C['reset']}")
    return 0


# --- drift: the mechanical half of `update` ----------------------------------

def git(root: Path, *args: str) -> str:
    try:
        return subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True, check=True).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return ""


def drift_facts(entry: dict) -> dict:
    """Everything drift knows about one repo, before deciding how much of it to print."""
    root = Path(entry["root"]).expanduser()
    f = {"name": entry["name"], "root": root, "sha": None, "cards": [], "head": "", "log": "",
         "changed": [], "hot": [], "cold": [], "routes": [], "dead": [], "uncovered": [], "status": ""}

    def note_dead() -> None:
        """Paths a card points at that are not in the repo any more.

        Worth checking whatever the deck's sha says: a path can be wrong from the day it was
        written, and a route that 404s teaches the reader nothing.
        """
        for c in f["cards"]:
            for pth in all_paths(c):
                if not (root / pth).exists():
                    f["dead"].append((c["id"], pth))

    loaded = load_deck(entry, quiet=True)
    if loaded is None:
        # Registered but never generated. A normal state, and the one the summary most needs
        # to surface: it is the list of repos still waiting on /repo-cards:generate.
        f["status"] = "no deck"
        return f
    deck, cards = loaded
    f["cards"] = cards
    f["sha"] = deck.get("last_update_sha")
    sha = f["sha"]

    if not root.is_dir():
        f["status"] = "root missing"
        return f
    note_dead()
    f["head"] = git(root, "rev-parse", "--short", "HEAD")
    if not sha or not f["head"]:
        f["status"] = "no baseline"
        return f
    if sha == f["head"]:
        f["status"] = "up to date"
        return f

    f["status"] = "behind"
    f["log"] = git(root, "log", "--oneline", f"{sha}..HEAD")
    f["changed"] = [x for x in git(root, "diff", "--name-only", f"{sha}..HEAD").split("\n") if x]

    # An anchor carrying #symbol is narrowed further: one commit to a 700-line module
    # should not flag every card drawn from it, or the update drowns in false positives.
    changed_set, diff_cache = set(f["changed"]), {}
    for c in cards:
        path, _, symbol = str(c.get("anchor", "")).partition("#")
        if not path:
            continue
        if not (path in changed_set or any(x.startswith(path.rstrip("/") + "/") for x in changed_set)):
            continue
        if not symbol:
            f["hot"].append(c)
            continue
        if path not in diff_cache:
            diff_cache[path] = git(root, "diff", "-U5", f"{sha}..HEAD", "--", path)
        # Hunk headers carry the enclosing function name, so a symbol absent from the
        # whole diff was very likely not touched.
        (f["hot"] if symbol in diff_cache[path] else f["cold"]).append(c)

    hot_ids = {c["id"] for c in f["hot"]}
    for c in cards:
        if c["id"] in hot_ids:
            continue
        touched = [pth for pth, _ in look_entries(c)
                   if pth.split("#")[0] in changed_set]
        if touched:
            f["routes"].append((c, touched))

    covered = {pth for c in cards for pth in all_paths(c)}
    f["uncovered"] = [x for x in f["changed"] if x not in covered]
    return f


def print_drift_detail(f: dict) -> None:
    print(f"\n{C['bold']}=== {f['name']} ==={C['reset']}")
    print(f"root: {f['root']}")
    print(f"deck: {deck_path(f['name'])}")
    if f["status"] == "no deck":
        print(f"{C['yellow']}no deck yet. Generate one with /repo-cards:generate{C['reset']}")
        return
    print(f"deck generated at: {f['sha'] or '(unrecorded)'}")
    if f["status"] == "root missing":
        print(f"{C['red']}root does not exist on this machine; re-register it{C['reset']}")
        return
    print(f"HEAD now: {f['head'] or '(not a git repo)'}")
    if f["status"] == "no baseline":
        print("no baseline to diff against; treat every card as unverified")
        return
    if f["status"] == "up to date":
        print(f"{C['green']}up to date, no commits since the deck was generated{C['reset']}")
        return

    print(f"\n--- commits since {f['sha']} ({len(f['log'].splitlines())}) ---\n{f['log']}")
    print(f"\n--- files changed ({len(f['changed'])}) ---")
    print("\n".join(f"  {x}" for x in f["changed"]) or "  (none)")
    print(f"\n--- cards whose anchor changed ({len(f['hot'])}) : VERIFY THESE ---")
    print("\n".join(f"  {c['id']:<40} {c['anchor']}" for c in f["hot"]) or "  (none)")
    if f["cold"]:
        print(f"\n--- file changed but the anchored symbol was not touched ({len(f['cold'])}) : likely fine ---")
        print("\n".join(f"  {c['id']:<40} {c['anchor']}" for c in f["cold"]))
    if f["routes"]:
        print(f"\n--- cards whose `look` route changed ({len(f['routes'])}) : directions may be stale ---")
        for c, touched in f["routes"]:
            print(f"  {c['id']:<40} {', '.join(touched)}")
    if f["dead"]:
        print(f"\n--- paths that no longer exist ({len(f['dead'])}) : FIX THESE ---")
        for cid, pth in f["dead"]:
            print(f"  {cid:<40} {pth}")
    print(f"\n--- changed files no card points at ({len(f['uncovered'])}) : CANDIDATES ---")
    print("\n".join(f"  {x}" for x in f["uncovered"]) or "  (none)")


def cmd_drift(args) -> int:
    """What changed since each deck was generated, and which cards that touches.

    Deliberately mechanical: it says what to look at, and the skill decides what a card
    should now say. Written to be read by Claude as well as by a person.

    One repo prints in full. Every repo prints a summary instead, because eight repos of
    detail is not a triage, and the point of a sweep is deciding where to spend the effort.
    """
    entries = [e for e in load_registry() if not args.repo or e["name"] == args.repo]
    if not entries:
        print("No repos registered. Add one with: repo-cards register /path/to/repo")
        return 0

    facts = [drift_facts(e) for e in entries]
    if args.repo or args.full or len(facts) == 1:
        for f in facts:
            print_drift_detail(f)
        print()
        return 0

    behind = [f for f in facts if f["status"] == "behind"]
    ungenerated = [f for f in facts if f["status"] == "no deck"]
    rank = {"behind": 0, "no deck": 1, "root missing": 2, "no baseline": 3, "up to date": 4}
    colours = {"behind": C["yellow"], "up to date": C["green"], "no deck": C["dim"]}

    print(f"\n  {'repo':<20} {'commits':>8} {'verify':>7} {'routes':>7} {'dead':>5} {'new files':>10}   state")
    for f in sorted(facts, key=lambda x: (rank.get(x["status"], 9), -len(x["hot"]))):
        colour = colours.get(f["status"], C["red"])
        dead = f"{C['red']}{len(f['dead'])}{C['reset']}" if f["dead"] else "-"
        if f["status"] == "behind":
            cols = (str(len(f["log"].splitlines())), str(len(f["hot"])), str(len(f["routes"])), str(len(f["uncovered"])))
        else:
            cols = ("-", "-", "-", "-")
        print(f"  {f['name']:<20} {cols[0]:>8} {cols[1]:>7} {cols[2]:>7} {dead:>5} {cols[3]:>10}   {colour}{f['status']}{C['reset']}")

    print()
    if behind:
        print(f"  {len(behind)} deck(s) behind. Detail: repo-cards drift --repo <name>   (--full for all)")
    if ungenerated:
        print(f"  {len(ungenerated)} repo(s) registered with no deck: {', '.join(f['name'] for f in ungenerated)}")
        print(f"  {C['dim']}Generate one by running /repo-cards:generate from inside it.{C['reset']}")
    if not behind and not ungenerated:
        print(f"  {C['green']}Every deck is current.{C['reset']}")
    print()
    return 0


# --- brief: read up on one area, without touching the schedule ---------------

def cmd_topics(args) -> int:
    """List the curated topics each deck defines."""
    found = False
    for entry in load_registry():
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=not args.repo)
        if loaded is None:
            continue
        deck, _cards = loaded
        topics = deck.get("topics") or {}
        if not topics:
            print(f"\n{C['bold']}{entry['name']}{C['reset']}  {C['dim']}no topics defined{C['reset']}")
            continue
        found = True
        print(f"\n{C['bold']}{entry['name']}{C['reset']}")
        for name, topic in topics.items():
            _t, cards, missing = topic_cards(deck, name)
            warn = f"  {C['yellow']}({len(missing)} card(s) no longer in the deck){C['reset']}" if missing else ""
            print(f"  {C['cyan']}{name:<22}{C['reset']} {len(cards):>3} cards  {C['dim']}{topic.get('description', '')}{C['reset']}{warn}")
    if found:
        print(f"\n{C['dim']}Read one with: repo-cards brief --topic <name>{C['reset']}")
    print()
    return 0


def cmd_brief(args) -> int:
    """Read an area end to end, question and answer together, in order.

    Deliberately not a review: it writes no state. Cramming before a meeting is a different
    mental mode from recall practice, and letting it reschedule cards you already know would
    corrupt the one signal the boxes carry. Order is the deck's or the topic's, never
    shuffled, because this is for rebuilding a mental model rather than testing it.
    """
    if not (args.topic or args.tag or args.grep):
        print(f"{C['dim']}Pick an area: --topic NAME, --tag a,b or --grep PATTERN.{C['reset']}\n")
        return cmd_topics(args)

    width = min(shutil.get_terminal_size((90, 24)).columns, 96)
    tags, grep = wanted_tags(args), compile_grep(args.grep)
    shown = 0

    for entry in load_registry():
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=not args.repo)
        if loaded is None:
            continue
        deck, cards = loaded
        heading, missing = "", []

        if args.topic:
            topic, cards, missing = topic_cards(deck, args.topic)
            if topic is None:
                continue
            heading = topic.get("description", "")
            notes = topic.get("notes")
        else:
            notes = None
        cards = [c for c in cards if card_matches(c, tags, grep)]
        if not cards:
            continue

        label = f"{entry['name']} · {args.topic}" if args.topic else entry["name"]
        print(f"\n{C['bold']}{label}{C['reset']}")
        if heading:
            print(f"{C['dim']}{heading}{C['reset']}")
        line = f"{len(cards)} card(s)"
        if notes:
            note_path = deck_dir(entry["name"]) / notes
            line += f" · notes: {note_path}" + ("" if note_path.exists() else f"  {C['yellow']}(missing){C['reset']}")
        print(f"{C['dim']}{line}{C['reset']}")
        if missing:
            print(f"{C['yellow']}{len(missing)} card(s) in this topic are no longer in the deck: {', '.join(missing)}{C['reset']}")
        print()

        for n, card in enumerate(cards, 1):
            # Wrapped at the answer's indent, then the first line's indent is replaced by the
            # number, so continuation lines stay aligned under it instead of hitting column 0.
            q = wrap(card["q"], width, "     ")
            print(f"{C['bold']}{n:>3}. {q[5:]}{C['reset']}")
            for pth, what in look_entries(card) or [(card.get("anchor", "-"), "")]:
                print(f"{C['dim']}     ↳ {pth}{('  ' + what) if what else ''}{C['reset']}")
            print(f"{C['cyan']}{wrap(card['a'], width, '     ')}{C['reset']}\n")
            shown += 1

    if not shown:
        scope = args.topic or args.tag or args.grep
        print(f"{C['yellow']}Nothing matched {scope!r}.{C['reset']} {C['dim']}Try: repo-cards topics{C['reset']}")
        return 1
    print(f"{C['dim']}{shown} card(s). Nothing was rescheduled.{C['reset']}\n")
    return 0


# --- registry management -----------------------------------------------------

def cmd_register(args) -> int:
    if not args.path:
        print(f"{C['red']}usage: repo-cards register /path/to/repo [--name NAME]{C['reset']}")
        return 1
    root = Path(args.path).expanduser().resolve()
    if not root.is_dir():
        print(f"{C['red']}no such directory: {root}{C['reset']}")
        return 1
    name = args.name or root.name
    repos = [r for r in load_registry() if r["name"] != name]
    repos.append({"name": name, "root": str(root)})
    repos.sort(key=lambda r: r["name"])
    save_registry(repos)
    (deck_dir(name) / "notes").mkdir(parents=True, exist_ok=True)
    print(f"{C['green']}registered {name}{C['reset']}\n  root: {root}\n  deck: {deck_path(name)}")
    if not deck_path(name).exists():
        print(f"{C['yellow']}  no deck yet: ask Claude to \"generate repo cards\" in that repo{C['reset']}")
    return 0


def cmd_forget(args) -> int:
    if not args.path:
        print(f"{C['red']}usage: repo-cards forget NAME{C['reset']}")
        return 1
    name = args.path
    repos = load_registry()
    if not any(r["name"] == name for r in repos):
        print(f"{C['yellow']}{name} is not registered{C['reset']}")
        return 1
    save_registry([r for r in repos if r["name"] != name])
    print(f"{C['green']}unregistered {name}{C['reset']}")
    print(f"{C['dim']}Its deck and progress are kept at {deck_dir(name)}; delete that by hand if you meant to.{C['reset']}")
    return 0


def cmd_repos(args) -> int:
    repos = load_registry()
    if not repos:
        print("No repos registered. Add one with: repo-cards register /path/to/repo")
        return 0
    for r in repos:
        has_deck = deck_path(r["name"]).exists()
        has_root = Path(r["root"]).expanduser().is_dir()
        status = f"{C['green']}ok{C['reset']}" if has_deck and has_root else (
            f"{C['red']}no deck{C['reset']}" if not has_deck else f"{C['red']}root missing{C['reset']}")
        print(f"  {r['name']:<20} {status:<20} {r['root']}")
    return 0


def cmd_home(args) -> int:
    d = data_home()
    print(f"platform:  {sys.platform}")
    print(f"data home: {d}{'' if d.exists() else '  (not created yet)'}")
    print(f"registry:  {registry_path()}")
    print(f"decks:     {d}/<name>/deck.yaml")
    print(f"state:     {d}/<name>/state.json")
    print(f"notes:     {d}/<name>/notes/")
    print(f"\n{C['dim']}Override with REPO_CARDS_HOME, or XDG_DATA_HOME on any platform.{C['reset']}")
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="repo-cards", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("command", nargs="?", default="review",
                   choices=["review", "brief", "topics", "stats", "list", "drift",
                            "register", "forget", "repos", "home"])
    p.add_argument("path", nargs="?", help="for `register`: repo root. for `forget`: the name")
    p.add_argument("--name", help="for `register`: deck name (default: directory name)")
    p.add_argument("--repo", help="limit to one registered repo")
    p.add_argument("--tag", help="limit to these tags (one name, or a comma-separated list)")
    p.add_argument("--grep", help="limit to cards matching this regex (question, answer, anchor, tags)")
    p.add_argument("--topic", help="limit to a curated topic (see `repo-cards topics`)")
    p.add_argument("--limit", type=int, help="cap the session length")
    p.add_argument("--all", action="store_true", help="ignore due dates (cram)")
    p.add_argument("--new", action="store_true", help="only cards never seen")
    p.add_argument("--full", action="store_true", help="for `drift`: full detail for every repo, not a summary")
    p.add_argument("--priority", type=int, choices=[1, 2, 3],
                   help="only cards at this priority (1 foundational, 2 core, 3 detail)")
    args = p.parse_args()
    return {
        "review": cmd_review, "brief": cmd_brief, "topics": cmd_topics,
        "stats": cmd_stats, "list": cmd_list, "drift": cmd_drift,
        "register": cmd_register, "forget": cmd_forget, "repos": cmd_repos, "home": cmd_home,
    }[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
