#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml"]
# ///
"""Leitner review over per-repo card decks.

Decks live outside the repos they describe, so nothing is written into a working tree.
Content and scheduling state are separate files: regenerating a deck never costs progress.

  repo-cards                       due cards across every registered repo
  repo-cards --repo billing        one repo
  repo-cards --tag outbox,retry    one or more themes
  repo-cards --all                 ignore due dates (cram)
  repo-cards brief --topic payouts read up on one feature before a meeting
  repo-cards topics                what topics a deck defines
  repo-cards stats                 deck health and box distribution
  repo-cards drift                 what changed since a deck was last updated
  repo-cards register PATH         add a repo
  repo-cards home                  print where everything lives
"""

from __future__ import annotations

import argparse
import collections
import datetime as dt
import zlib
import json
import os
import random
import re
import shutil
import subprocess
import sys
from pathlib import Path

import yaml

# Leitner box -> days until due again. Box 5 is "known", not "finished".
INTERVALS = {1: 1, 2: 2, 3: 4, 4: 8, 5: 16}
MAX_BOX = 5

# Ordering weights. Priority decides what you see first in a capped session; it deliberately
# does NOT touch the intervals above, so a card you demonstrably know still backs off to 16
# days however load-bearing it is.
#
# JITTER is wider than the gap between tiers on purpose: a priority-2 card can beat a
# priority-1 card on any given day, so the order varies and you are not drilling the same
# fifteen in the same sequence forever.
#
# OVERDUE_PER_DAY is the starvation guard, and it is not optional. Simulated over 180 days
# at 15 cards a day across eight decks (~640 cards), a weighted order with no escalation
# left 455 cards never seen at all: the tail cannot out-rank 185 foundational cards, ever.
# A gentle slope with a high cap fixes it without flattening the weighting, because a card
# only overtakes a tier after weeks of neglect rather than days. The same simulation puts
# the starvation cliff just above a 1.0 tier gap, so the gap here stays well clear of it.
PRIORITY_WEIGHT = {1: 0.0, 2: 0.6, 3: 1.2}
DEFAULT_PRIORITY = 2
JITTER = 1.4
RECENT_DAYS = 30        # a card added or rewritten this recently is still bedding in
RECENT_BOOST = 0.6
OVERDUE_PER_DAY = 0.05
OVERDUE_CAP = 3.5

# Churn. A card whose anchor is being edited every week is knowledge at risk: the code is
# live, people are making decisions against it now, and being wrong about it costs today.
# A card anchored on a file nobody has touched in three years is settled, and worth less of
# a short session. Normalised against the deck's own 90th percentile, because "a lot of
# commits" means something different in a two-month-old repo and a ten-year-old one, and
# floored so a repo where nothing moves hands out no boosts at all.
# A card is prose, so it gets a comfortable measure rather than the whole terminal: a line
# 160 columns wide is hard to read back to. The box then shrinks to whatever the content
# actually needs, and is centred, so a short card on a big screen is not a wide box with a
# lot of air in it.
TARGET_WIDTH = 78
PICKER_WIDTH = 104
MIN_WIDTH = 44


# When a deck is this far behind, an incremental update is the wrong tool: verifying a
# hundred anchors one at a time is slower than rereading the repo, and a deck that has
# drifted that far is usually missing whole areas rather than a few facts.
REGEN_COMMITS = 60
REGEN_DEAD_FRACTION = 0.25

CHURN_WINDOW_DAYS = 180
CHURN_FLOOR = 3
CHURN_WEIGHT = 0.5

C = {
    "dim": "\033[2m", "bold": "\033[1m", "reset": "\033[0m",
    "green": "\033[32m", "red": "\033[31m", "yellow": "\033[33m", "cyan": "\033[36m",
}
if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
    C = dict.fromkeys(C, "")
if sys.platform == "win32":
    # Windows terminals only interpret these once a process asks for it.
    os.system("")  # noqa: S605, S607


def data_home() -> Path:
    """Where decks, state and notes live.

    REPO_CARDS_HOME wins, then XDG_DATA_HOME on any platform (a user who sets it means it),
    then the platform's own convention.
    """
    if env := os.environ.get("REPO_CARDS_HOME"):
        return Path(env).expanduser()
    if xdg := os.environ.get("XDG_DATA_HOME"):
        return Path(xdg).expanduser() / "repo-cards"
    if sys.platform == "win32":
        base = os.environ.get("LOCALAPPDATA") or os.environ.get("APPDATA")
        return (Path(base) if base else Path.home() / "AppData" / "Local") / "repo-cards"
    if sys.platform == "darwin":
        return Path.home() / "Library" / "Application Support" / "repo-cards"
    return Path.home() / ".local" / "share" / "repo-cards"


def registry_path() -> Path:
    return data_home() / "registry.json"


def deck_dir(name: str) -> Path:
    return data_home() / name


def deck_path(name: str) -> Path:
    return deck_dir(name) / "deck.yaml"


def prefs_path() -> Path:
    return data_home() / "session.json"


def load_prefs() -> dict:
    """What you picked last time. Preferences, not data: losing them costs one keypress."""
    p = prefs_path()
    if not p.exists():
        return {}
    try:
        return json.loads(p.read_text())
    except (json.JSONDecodeError, OSError):
        return {}


def save_prefs(**changes) -> None:
    prefs = {**load_prefs(), **changes}
    p = prefs_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(prefs, indent=2, sort_keys=True) + "\n")


def state_file(name: str) -> Path:
    return deck_dir(name) / "state.json"


def today() -> dt.date:
    return dt.date.today()


# --- registry and decks ------------------------------------------------------

def load_registry() -> list[dict]:
    p = registry_path()
    if not p.exists():
        return []
    try:
        return json.loads(p.read_text()).get("repos", [])
    except json.JSONDecodeError:
        print(f"{C['red']}! registry is not valid JSON: {p}{C['reset']}")
        return []


def save_registry(repos: list[dict]) -> None:
    p = registry_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps({"repos": repos}, indent=2) + "\n")


def load_deck(entry: dict, quiet: bool = False) -> tuple[dict, list[dict]] | None:
    path = deck_path(entry["name"])
    if not path.exists():
        if not quiet:
            print(f"{C['yellow']}! no deck for {entry['name']} at {path}{C['reset']}")
        return None
    try:
        deck = yaml.safe_load(path.read_text()) or {}
    except yaml.YAMLError as err:
        print(f"{C['red']}! deck for {entry['name']} does not parse: {err}{C['reset']}")
        return None
    cards = deck.get("cards") or []
    deck["_computed"] = compute_topics(Path(entry["root"]).expanduser(), cards)
    return deck, cards


def load_state(name: str) -> dict:
    p = state_file(name)
    if not p.exists():
        return {}
    try:
        return json.loads(p.read_text())
    except json.JSONDecodeError:
        # A corrupt state file costs scheduling, not cards. Start over rather than refuse to run.
        print(f"{C['yellow']}! state unreadable, starting fresh: {p}{C['reset']}")
        return {}


def save_state(name: str, state: dict) -> None:
    # Only graded cards are persisted. Scheduling a card nobody has seen is the same as having
    # no row for it, and 80 identical defaults make the file unreadable.
    seen = {cid: cs for cid, cs in state.items() if cs.get("seen", 0) > 0}
    p = state_file(name)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(seen, indent=2, sort_keys=True) + "\n")


def card_state(state: dict, card_id: str) -> dict:
    return state.setdefault(card_id, {"box": 1, "due": today().isoformat(), "seen": 0, "lapses": 0})


def is_due(cs: dict) -> bool:
    return dt.date.fromisoformat(cs["due"]) <= today()


def look_entries(card: dict) -> list[tuple[str, str]]:
    """`look` as (path[#symbol], what you would find there).

    Distinct from `anchor`, which names the one place the fact is *defined* and is what
    drift tracks precisely. `look` is the route you would take to answer the question
    yourself: the test that pins it, the decision that argued it, the caller that shows why.
    """
    look = card.get("look") or {}
    if isinstance(look, dict):
        return [(str(k), str(v)) for k, v in look.items()]
    # A bare list is accepted so a hand-edited card with no descriptions still works.
    return [(str(x), "") for x in look]


def all_paths(card: dict) -> list[str]:
    """Every repo path a card points at, anchor first, symbols stripped."""
    out = [str(card.get("anchor", "")).split("#")[0]]
    out += [pth.split("#")[0] for pth, _ in look_entries(card)]
    return [x for x in out if x]


def priority_of(card: dict) -> int:
    pri = card.get("priority", DEFAULT_PRIORITY)
    return pri if pri in PRIORITY_WEIGHT else DEFAULT_PRIORITY


def card_date(card: dict, deck: dict) -> dt.date | None:
    """When this card last changed. Falls back to the deck's first generation.

    The deck is not in git, so nothing else can answer this: `added` and `updated` are
    written by the skill, and a card carrying neither is as old as the deck.
    """
    raw = card.get("updated") or card.get("added") or deck.get("generated")
    if not raw:
        return None
    try:
        return dt.date.fromisoformat(str(raw))
    except ValueError:
        return None


def repo_churn(root: Path, days: int = CHURN_WINDOW_DAYS) -> dict[str, int]:
    """Commits touching each path in the window. One git call for the whole repo."""
    out = git(root, "log", f"--since={days} days ago", "--name-only", "--pretty=format:")
    counts: dict[str, int] = {}
    for line in out.split("\n"):
        if line := line.strip():
            counts[line] = counts.get(line, 0) + 1
    return counts


def churn_context(entry: dict, cards: list[dict]) -> tuple[dict[str, int], float]:
    """Churn counts plus the deck's own 90th percentile, which is what normalises them."""
    root = Path(entry["root"]).expanduser()
    if not root.is_dir():
        return {}, 0.0
    counts = repo_churn(root)
    vals = sorted(counts.get(str(c.get("anchor", "")).split("#")[0], 0) for c in cards)
    p90 = vals[int(len(vals) * 0.9)] if vals else 0
    return counts, float(p90)


def churn_boost(card: dict, counts: dict[str, int], p90: float) -> float:
    """How much this card's anchor is moving, as a 0..CHURN_WEIGHT bonus."""
    if p90 <= CHURN_FLOOR:
        return 0.0
    n = counts.get(str(card.get("anchor", "")).split("#")[0], 0)
    if n <= CHURN_FLOOR:
        return 0.0
    return CHURN_WEIGHT * min(1.0, (n - CHURN_FLOOR) / (p90 - CHURN_FLOOR))


def order_score(card: dict, deck: dict, cs: dict, churn: tuple[dict, float] = ({}, 0.0)) -> float:
    """Lower sorts earlier. Weighted, not absolute: see JITTER and OVERDUE_PER_DAY."""
    score = PRIORITY_WEIGHT[priority_of(card)]
    when = card_date(card, deck)
    if when is not None and (today() - when).days <= RECENT_DAYS:
        score -= RECENT_BOOST
    score -= churn_boost(card, churn[0], churn[1])
    try:
        overdue = (today() - dt.date.fromisoformat(cs["due"])).days
    except (KeyError, ValueError):
        overdue = 0
    if overdue > 0:
        score -= min(overdue * OVERDUE_PER_DAY, OVERDUE_CAP)
    return score + random.random() * JITTER


def wanted_tags(args) -> set[str]:
    """--tag takes one name or a comma-separated list, matched as OR."""
    return {t.strip() for t in (args.tag or "").split(",") if t.strip()}


def compile_grep(pattern: str | None):
    """--grep is a regex, falling back to a literal search when it does not compile.

    A pattern like `plan(` is a typo in one reading and a literal in the other. Searching for
    it literally is the answer nobody has to debug.
    """
    if not pattern:
        return None
    try:
        return re.compile(pattern, re.IGNORECASE)
    except re.error:
        return re.compile(re.escape(pattern), re.IGNORECASE)


def card_matches(card: dict, tags: set[str], grep) -> bool:
    if tags and not (tags & set(card.get("tags", []))):
        return False
    if grep:
        hay = " ".join([
            card["id"], str(card.get("q", "")), str(card.get("a", "")),
            str(card.get("anchor", "")), " ".join(card.get("tags", [])),
        ])
        if not grep.search(hay):
            return False
    return True


#: Computed topics, by how far back they look. The point of these is coming back after time
#: away: what has the repo actually been doing, not what the deck last recorded.
RECENT_WINDOWS = (("last-week", 7), ("last-month", 30))

_TOUCH_CACHE: dict[tuple[str, int], dict[str, int]] = {}


def repo_touch(root: Path, days: int) -> dict[str, int]:
    """When each path was last touched by a commit in the window, as a unix timestamp.

    One `git log` for the whole repo rather than one per card. The NUL prefix marks a
    timestamp line: a filename can be all digits, and using that as the discriminator would
    silently misattribute it.
    """
    key = (str(root), days)
    if key in _TOUCH_CACHE:
        return _TOUCH_CACHE[key]
    out = git(root, "log", f"--since={days} days ago", "--name-only", "--pretty=format:%x00%ct")
    touched: dict[str, int] = {}
    stamp = 0
    for line in out.split("\n"):
        if line.startswith("\x00"):
            stamp = int(line[1:] or 0)
        elif line.strip():
            touched[line.strip()] = max(touched.get(line.strip(), 0), stamp)
    _TOUCH_CACHE[key] = touched
    return touched


def compute_topics(root: Path, cards: list[dict]) -> dict:
    """Topics derived from the repository's own history rather than from the deck.

    Membership is "this card's anchor was touched by a commit in the window", which is what
    somebody means when they ask what has changed. Deriving it from the deck's own `added`
    and `updated` stamps only ever said when the deck was last edited, which is bookkeeping
    rather than news.
    """
    if not root.is_dir():
        return {}
    out = {}
    for name, days in RECENT_WINDOWS:
        touched = repo_touch(root, days)
        hits = [(ts, c) for c in cards
                if (ts := touched.get(str(c.get("anchor", "")).split("#")[0], 0))]
        # A window that covers the whole deck is not a filter, and a big refactor makes that
        # happen easily. It starts being useful when it narrows something.
        if not hits or len(hits) > 0.8 * len(cards):
            continue
        hits.sort(key=lambda tc: tc[0], reverse=True)
        out[name] = {
            "description": f"Anchors touched by commits in the last {days} days, newest first",
            "cards": [c["id"] for _ts, c in hits],
            "synthetic": True,
        }
    return out


def all_topics(deck: dict) -> dict:
    """Declared topics plus computed ones. A declared topic wins on a name clash.

    The computed set is attached by `load_deck`, which is the only place that knows the
    repo root, so every reader gets them without threading a path through.
    """
    return {**(deck.get("_computed") or {}), **(deck.get("topics") or {})}


def topic_cards(deck: dict, name: str) -> tuple[dict | None, list[dict], list[str]]:
    """A topic's cards in the order the topic declares, plus any ids that no longer exist.

    Order is the point: a topic is read to rebuild a mental model, and the story runs in a
    direction. Missing ids are returned rather than skipped silently, because they mean the
    topic outlived a card and the deck needs an update.
    """
    topic = all_topics(deck).get(name)
    if topic is None:
        return None, [], []
    by_id = {c["id"]: c for c in deck.get("cards") or []}
    wanted = topic.get("cards") or []
    return topic, [by_id[cid] for cid in wanted if cid in by_id], [cid for cid in wanted if cid not in by_id]


def collect(args) -> list[tuple[dict, dict, dict, dict, tuple]]:
    """Gather (entry, card, state, deck, churn) in scope. State and churn are per deck."""
    out, states = [], {}
    tags, grep = wanted_tags(args), compile_grep(args.grep)
    for entry in load_registry():
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=not args.repo)
        if loaded is None:
            continue
        deck, cards = loaded
        if args.topic:
            _topic, cards, _missing = topic_cards(deck, args.topic)
            if not cards:
                continue
        state = states.setdefault(entry["name"], load_state(entry["name"]))
        churn = churn_context(entry, cards)
        for card in cards:
            if not card_matches(card, tags, grep):
                continue
            cs = card_state(state, card["id"])
            if args.priority and priority_of(card) != args.priority:
                continue
            if args.new and cs["seen"] > 0:
                continue
            if not args.all and not args.new and not is_due(cs):
                continue
            out.append((entry, card, state, deck, churn))
    return out


# --- rendering ---------------------------------------------------------------

LIST_MARKER = re.compile(r"^(\s*)((?:\d+[.)]|[-*•])\s+)")


def wrap(text: str, width: int, indent: str = "  ", style: str = "") -> str:
    """Indent and wrap, leaving deliberate layout intact.

    A value written as a YAML literal block (`|-`) is multi-line because the author laid it
    out. Reflowing a table destroys the thing that made it readable, so a multi-line value
    is only indented, and wrapped per line if a line is genuinely too long.

    A numbered or bulleted list is the exception: its items are prose that happens to be
    numbered, so they are rejoined and refilled under a hanging indent. A table has no list
    marker, which is what keeps the two apart.
    """
    raw = str(text).rstrip()
    preformatted = "\n" in raw

    def restyle(lines: list[str]) -> str:
        """Open and close the style on every line.

        A block styled as one string keeps its escape open across the line breaks, so the
        frame's border and padding are drawn inside it and every continuation line after
        the first loses the style when the reset finally lands.
        """
        if not style:
            return "\n".join(lines)
        out = []
        for ln in lines:
            if not ln.strip():
                out.append(ln)
                continue
            lead = len(ln) - len(ln.lstrip())
            out.append(ln[:lead] + style + ln[lead:] + C["reset"])
        return "\n".join(out)

    def fill(para: str, hang: str, first: str | None = None) -> list[str]:
        out, cur = [], ""
        lead = first if first is not None else hang
        for word in para.split():
            if cur and len(cur) + len(word) + 1 + len(lead if not out else hang) > width:
                out.append((lead if not out else hang) + cur)
                cur = word
            else:
                cur = f"{cur} {word}".strip()
        if cur:
            out.append((lead if not out else hang) + cur)
        return out

    if not preformatted:
        return restyle(fill(raw, indent))

    if any(LIST_MARKER.match(ln) for ln in raw.split("\n")):
        # Regroup into items, so a wrapped item does not leave orphan fragments behind.
        items: list[tuple[str, str]] = []   # (marker prefix, text)
        for ln in raw.split("\n"):
            if m := LIST_MARKER.match(ln):
                items.append((m.group(1) + m.group(2), ln[m.end():]))
            elif items and ln.strip():
                items[-1] = (items[-1][0], items[-1][1] + " " + ln.strip())
            elif not ln.strip():
                items.append(("", ""))
        out: list[str] = []
        for prefix, body in items:
            if not prefix and not body:
                out.append("")
                continue
            out.extend(fill(body, indent + " " * len(prefix), first=indent + prefix))
        return restyle(out)

    # A block can be a table with prose under it. A line carrying an internal run of two or
    # more spaces is column alignment; consecutive prose lines are otherwise rejoined before
    # filling, so no orphan fragments are left behind.
    #
    # If the block contains ANY aligned line it is treated as a table throughout and nothing
    # is joined. A row whose first column is long enough to eat its own padding looks like
    # prose to this test, and merging a table row into a paragraph is far worse than leaving
    # a short line where a fill would have tidied it.
    def aligned(ln: str) -> bool:
        return "  " in ln.strip()

    if any(aligned(ln) for ln in raw.split("\n") if ln.strip()):
        # Emitted verbatim even when a row is wider than the terminal. Filling it would
        # collapse the padding that makes it a table, and a soft-wrapped row still carries
        # its data; a reflowed one does not.
        return restyle([indent + ln if ln.strip() else "" for ln in raw.split("\n")])

    lines, buf = [], []

    def flush() -> None:
        if buf:
            lines.extend(fill(" ".join(buf), indent))
            buf.clear()

    for para in raw.split("\n"):
        if not para.strip():
            flush()
            lines.append("")
        elif aligned(para):
            flush()
            if len(para) + len(indent) <= width:
                lines.append(indent + para)
            else:
                lead = " " * (len(para) - len(para.lstrip()))
                lines.extend(fill(para, indent + lead))
        else:
            buf.append(para.strip())
    flush()
    return restyle(lines)


# --- terminal ----------------------------------------------------------------

FULLSCREEN = sys.stdout.isatty() and sys.stdin.isatty()
# Terminals that do not understand OSC 8 print the text and drop the escape, so this is
# safe to emit blind. It is skipped when piped, where the escapes would be noise.
HYPERLINKS = sys.stdout.isatty() and os.environ.get("TERM") != "dumb"

# Bright, saturated entries from the 256-colour cube: readable on a dark terminal and
# distinguishable from each other. Near-greys are excluded, since two repos that look the
# same defeat the point.
_PALETTE = (38, 40, 42, 44, 46, 48, 50, 72, 74, 76, 78, 80, 82, 84, 86, 104, 106, 110, 112, 114, 116, 118, 120, 122, 140, 142, 147, 149, 153, 155, 157, 159, 171, 173, 175, 177, 179, 183, 185, 190)
_ASSIGNED: dict[str, str] = {}


def name_colour(name: str) -> str:
    """A stable colour per name, de-collided against the repos actually registered.

    Hashed, so a repo keeps its colour across machines and across sessions. Resolved in
    sorted order against the registry so two registered repos never share one; adding a
    repo only shifts a colour if it lands on a taken slot.
    """
    if not C["reset"]:
        return ""
    if not _ASSIGNED:
        used: set[int] = set()
        for n in sorted({r["name"] for r in load_registry()} | {name}):
            base = zlib.crc32(n.encode()) % len(_PALETTE)
            for k in range(len(_PALETTE)):
                idx = (base + k) % len(_PALETTE)
                if idx not in used:
                    used.add(idx)
                    _ASSIGNED[n] = f"\033[38;5;{_PALETTE[idx]}m"
                    break
    if name not in _ASSIGNED:
        _ASSIGNED[name] = f"\033[38;5;{_PALETTE[zlib.crc32(name.encode()) % len(_PALETTE)]}m"
    return _ASSIGNED[name]


_TOPIC_COLOURS: dict[tuple, dict[str, str]] = {}


def topic_colour(name: str, siblings: tuple[str, ...] = ()) -> str:
    """A stable colour per topic, de-collided against the other topics in its deck."""
    if not C["reset"]:
        return ""
    key = tuple(sorted(siblings)) or (name,)
    if key not in _TOPIC_COLOURS:
        used, out = set(), {}
        for t in key:
            base = zlib.crc32(("t:" + t).encode()) % len(_PALETTE)
            for k in range(len(_PALETTE)):
                idx = (base + k) % len(_PALETTE)
                if idx not in used:
                    used.add(idx)
                    out[t] = f"\033[38;5;{_PALETTE[idx]}m"
                    break
        _TOPIC_COLOURS[key] = out
    return _TOPIC_COLOURS[key].get(name, f"\033[38;5;{_PALETTE[zlib.crc32(name.encode()) % len(_PALETTE)]}m")


def sgr(code: int) -> str:
    """A 256-colour foreground escape, or nothing when colour is off."""
    return f"\033[38;5;{code}m" if C["reset"] else ""


# Rich mode: box, priority and kind each carry their own colour, so the header reads at a
# glance rather than being parsed.
BOX_COLOUR = {1: 203, 2: 215, 3: 117, 4: 114, 5: 84}
PRIORITY_COLOUR = {1: 220, 2: 109, 3: 243}
KIND_COLOUR = {"recall": 109, "cloze": 214, "locate": 117, "order": 176}


def tag_colour(tag: str) -> str:
    return sgr(_PALETTE[zlib.crc32(("#" + tag).encode()) % len(_PALETTE)])


def fit_width(lines: list[str], cols: int, *chrome: str, target: int = TARGET_WIDTH) -> int:
    """The narrowest box that holds `lines` and its chrome, within the terminal.

    Content first, terminal second: a box sized to the screen wastes the reader's eye on
    air, and one sized past the screen breaks every row.
    """
    content = max((visible_len(ln) for ln in lines), default=0)
    needed = max(content, max((visible_len(c) for c in chrome), default=0)) + 4
    # The terminal is clamped last, on purpose: a box wider than the screen breaks every
    # row, so a cramped card on a 40-column terminal beats a broken one.
    return min(max(MIN_WIDTH, min(needed, target)), max(20, cols - 2))


def place(boxed: list[str], cols: int, rows: int, centre: bool = True) -> str:
    """Centre the box in the terminal, horizontally and vertically."""
    if not boxed:
        return ""
    box_w = visible_len(boxed[0])
    left = " " * max(0, (cols - box_w) // 2) if centre else ""
    top = max(0, (rows - len(boxed) - 1) // 2) if centre else 0
    return "\n" * top + "\n".join(left + ln for ln in boxed)


def frame(lines: list[str], width: int, *, head: str = "", head_right: str = "",
          foot: str = "", border: str = "", divider_at: int | None = None) -> list[str]:
    """Wrap pre-wrapped lines in a rounded box.

    Padding is computed from the *visible* width, so colour escapes and OSC 8 hyperlinks
    do not push the right edge out. A line that is still too wide is truncated rather than
    allowed to break the frame, which is the one failure that makes the whole screen wrong.
    """
    b, r = border, C["reset"] if border else ""
    inner = width - 4
    out = []

    def bar(left: str, right: str, text: str = "", text_right: str = "") -> str:
        """A border row with text set into it.

        Both labels are truncated to fit, and the right-hand one is dropped entirely before
        the bar is allowed to overflow: a header wider than the terminal breaks every row
        below it, which is far more wrong than a missing card count.
        """
        mid = width - 2                 # columns between the two corners
        min_rule = 2                    # at least one dash each side of the text
        # The stub dashes are part of the border, so they carry the border's colour. They
        # used to be built into the text and came out in the default foreground.
        tail = f" {text_right} {b}─{r}" if text_right else ""
        head = f"{b}─{r} {text} " if text else ""

        if visible_len(head) + visible_len(tail) + min_rule > mid:
            tail = ""                   # the count is the first thing to go
        if visible_len(head) + min_rule > mid:
            head = f"{b}─{r} {ansi_truncate(text, max(0, mid - min_rule - 3))}… "

        room = max(0, mid - visible_len(head) - visible_len(tail))
        return f"{b}{left}{r}{head}{b}{'─' * room}{r}{tail}{b}{right}{r}"

    out.append(bar("╭", "╮", head, head_right))
    for i, ln in enumerate(lines):
        if divider_at is not None and i == divider_at:
            out.append(f"{b}├{'─' * (width - 2)}┤{r}")
        vis = visible_len(ln)
        if vis > inner:
            ln, vis = ansi_truncate(ln, inner), inner
        out.append(f"{b}│{r} {ln}{' ' * (inner - vis)} {b}│{r}")
    out.append(bar("╰", "╯", foot))
    return out


def link(text: str, root: Path, path: str) -> str:
    """`text` as an OSC 8 hyperlink to path, when the terminal can do it."""
    if not HYPERLINKS:
        return text
    target = root / path.split("#")[0]
    try:
        uri = target.resolve().as_uri()
    except (ValueError, OSError):
        return text
    return f"\033]8;;{uri}\033\\{text}\033]8;;\033\\"


def read_key() -> str:
    """One keypress as a name: left, right, enter, esc, or the literal character."""
    if not FULLSCREEN:
        try:
            return (input() or "enter").strip().lower()
        except (EOFError, KeyboardInterrupt):
            return "q"
    if sys.platform == "win32":
        import msvcrt
        ch = msvcrt.getwch()
        if ch in ("\x00", "\xe0"):
            return {"K": "left", "M": "right", "H": "up", "P": "down"}.get(msvcrt.getwch(), "")
        return {"\r": "enter", "\x1b": "esc", "\x03": "q"}.get(ch, ch.lower())

    import select
    import termios
    import tty
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        # os.read, not sys.stdin.read: the buffered reader pulls the whole escape sequence
        # into Python's own buffer, so the select() below sees an empty file descriptor and
        # every arrow key decodes as a bare Escape. That is what closed the picker.
        ch = os.read(fd, 1).decode("utf-8", "replace")
        if ch != "\x1b":
            return {"\r": "enter", "\n": "enter", "\x03": "q", "\x04": "q"}.get(ch, ch.lower())

        # A bare Escape sends nothing more, so do not block waiting for a sequence.
        if not select.select([fd], [], [], 0.05)[0]:
            return "esc"
        seq = os.read(fd, 8).decode("utf-8", "replace")
        # Modifiers arrive as ESC [ 1 ; 5 A and the like, so match on the final letter.
        final = seq[-1] if seq else ""
        if seq.startswith(("[", "O")) and final in "ABCD":
            return {"A": "up", "B": "down", "C": "right", "D": "left"}[final]
        if final == "~":
            return {"5": "pgup", "6": "pgdn", "1": "home", "4": "end",
                    "7": "home", "8": "end"}.get(seq[1:2], "esc")
        if seq.startswith(("[", "O")) and final in "HF":
            return {"H": "home", "F": "end"}[final]
        return "esc"
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)


def prompt(msg: str) -> str:
    try:
        return input(msg).strip().lower()
    except (EOFError, KeyboardInterrupt):
        return "q"


# --- question kinds ----------------------------------------------------------
#
# A deck is more interesting to review than a flat Q/A list, and the variety is not
# decoration: asking "where would you find this" exercises a different thing from asking
# for the fact, and it is the one that makes you learn the repo rather than the answer.
#
# `kind:` on a card picks one explicitly. A plain recall card that carries routes is also
# occasionally asked as a `locate`, so the variety costs no extra authoring.

CLOZE = re.compile(r"\{\{(.+?)\}\}", re.S)
LOCATE_CHANCE = 6      # 1 in N recall cards with routes are asked as locate instead


def kind_of(card: dict, vary: bool = True) -> str:
    kind = str(card.get("kind", "recall")).lower()
    if kind not in ("recall", "cloze", "locate", "order"):
        kind = "recall"
    if kind == "recall" and CLOZE.search(str(card.get("a", ""))):
        kind = "cloze"          # markers present, so the author meant it
    if (kind == "recall" and vary and len(look_entries(card)) >= 2
            and random.randrange(LOCATE_CHANCE) == 0):
        kind = "locate"
    return kind


def kind_label(kind: str) -> str:
    return {"recall": "recall", "cloze": "fill the blanks",
            "locate": "where would you look?", "order": "put in order"}[kind]


def render_prompt(card: dict, kind: str, width: int, root: Path) -> list[str]:
    """The lines shown before the reveal."""
    out: list[str] = []
    if kind == "locate":
        out.append(wrap("Where in the repo would you go to answer this, and what is in each place?",
                        width, style=C["bold"]))
        out.append("")
        out.append(wrap(card["q"], width, style=C["dim"]))
        return out

    out.append(wrap(card["q"], width, style=C["bold"]))

    if kind == "cloze":
        blanked = CLOZE.sub(lambda m: "▁" * max(6, min(len(m.group(1)), 18)), str(card["a"]))
        out += ["", wrap(blanked, width, style=C["cyan"])]
    elif kind == "order":
        shuffled = list(card.get("sequence") or [])
        random.shuffle(shuffled)
        out.append("")
        out += [f"{C['cyan']}     {step}{C['reset']}" for step in shuffled]
    elif look_entries(card):
        out.append("")
        out += route_lines(card, root, width)
    return out


def route_lines(card: dict, root: Path, width: int) -> list[str]:
    """One route per path, its description wrapped underneath rather than trailing it.

    A path plus a description rarely fits on one line, and truncating it loses the half
    that says why the path is worth opening.
    """
    out = []
    for pth, what in look_entries(card):
        chunks = hard_break(pth, width - 4)
        out.append(f"{C['dim']}  → {C['reset']}{link(chunks[0], root, pth)}")
        out += [f"    {link(ch, root, pth)}" for ch in chunks[1:]]
        if what:
            out.append(wrap(what, width, "    ", style=C["dim"]))
    return out


def render_answer(card: dict, kind: str, width: int, root: Path) -> list[str]:
    out: list[str] = []
    if kind == "locate":
        out += route_lines(card, root, width)
        out += ["", wrap("The answer itself:", width, style=C["dim"]),
                wrap(card["a"], width, style=C["cyan"])]
        return out
    if kind == "order":
        out += [f"{C['cyan']}  {n}. {step}{C['reset']}" for n, step in enumerate(card.get("sequence") or [], 1)]
        if card.get("a"):
            out += ["", wrap(card["a"], width, style=C["dim"])]
        return out

    text = CLOZE.sub(lambda m: f"{C['bold']}{m.group(1)}{C['reset']}{C['cyan']}", str(card["a"]))
    out.append(wrap(text, width, style=C["cyan"]))
    if kind != "cloze" and not look_entries(card):
        return out
    if kind == "cloze" and look_entries(card):
        out += [""] + route_lines(card, root, width)
    return out


# --- the picker --------------------------------------------------------------

def deck_summary(entry: dict) -> dict | None:
    """What the picker needs about one repo: its cards, topics and how many are due."""
    loaded = load_deck(entry, quiet=True)
    if loaded is None:
        return None
    deck, cards = loaded
    state = load_state(entry["name"])
    due = sum(1 for c in cards if (cs := state.get(c["id"])) is None or is_due(cs))
    head = git(Path(entry["root"]).expanduser(), "rev-parse", "--short", "HEAD")
    behind = bool(head and deck.get("last_update_sha") and head != deck["last_update_sha"])
    return {"entry": entry, "deck": deck, "cards": cards, "due": due, "behind": behind,
            "topics": list(all_topics(deck).keys())}


def pick_session(args) -> dict[str, set[str] | None] | None:
    """Choose repos, and optionally topics within them. None means the user backed out.

    A value of None for a repo means every card in it; a set means those topics only.
    """
    registry = load_registry()
    summaries = [(e, deck_summary(e)) for e in registry]
    decks = [d for _e, d in summaries if d]
    undecked = [e["name"] for e, d in summaries if d is None]
    if not decks:
        print("No decks yet. Run /repo-cards:generate inside a repo to make one.")
        if undecked:
            print(f"{C['dim']}Registered and waiting: {', '.join(undecked)}{C['reset']}")
        return None
    # Last session's choice, so coming back lands where you left off. Falls back to
    # whatever has work waiting, so a first run does the obvious thing on enter.
    live = {d["entry"]["name"] for d in decks}
    remembered = {k: (set(v) if v else None)
                  for k, v in (load_prefs().get("selected") or {}).items() if k in live}
    chosen: dict[str, set[str] | None] = remembered or {
        d["entry"]["name"]: None for d in decks if d["due"]}
    if not chosen:
        chosen = {decks[0]["entry"]["name"]: None}

    row, view, topic_row = 0, "repos", 0
    repo_off = topic_off = 0
    if FULLSCREEN:
        sys.stdout.write(ALT_ON)
    try:
        while True:
            if view == "repos":
                repo_off = draw_repo_picker(decks, chosen, row, repo_off, undecked)
            else:
                topic_off = draw_topic_picker(decks[row], chosen, topic_row, topic_off)
            key = read_key()

            if key in ("q", "esc"):
                if view == "topics":
                    view, key = "repos", ""
                else:
                    return None
            page = max(1, picker_height() - 1)
            if view == "repos":
                if key == "up":
                    row = (row - 1) % len(decks)
                elif key == "down":
                    row = (row + 1) % len(decks)
                elif key in ("pgup", "home", "g"):
                    row = 0 if key in ("home", "g") else max(0, row - page)
                elif key in ("pgdn", "end", "G"):
                    row = (len(decks) - 1 if key in ("end", "G")
                           else min(len(decks) - 1, row + page))
                elif key == " ":
                    name = decks[row]["entry"]["name"]
                    chosen.pop(name, None) if name in chosen else chosen.update({name: None})
                elif key == "right" and decks[row]["topics"]:
                    view, topic_row, topic_off = "topics", 0, 0
                elif key == "enter":
                    return remember(chosen)
            else:
                d = decks[row]
                opts = ["all", *d["topics"]]
                if key == "up":
                    topic_row = (topic_row - 1) % len(opts)
                elif key == "down":
                    topic_row = (topic_row + 1) % len(opts)
                elif key in ("pgup", "home", "g"):
                    topic_row = 0 if key in ("home", "g") else max(0, topic_row - page)
                elif key in ("pgdn", "end", "G"):
                    topic_row = (len(opts) - 1 if key in ("end", "G")
                                 else min(len(opts) - 1, topic_row + page))
                elif key == "left":
                    view = "repos"
                elif key == " ":
                    name = d["entry"]["name"]
                    if topic_row == 0:
                        chosen[name] = None
                    else:
                        cur = chosen.get(name) or set()
                        t = opts[topic_row]
                        cur = (cur - {t}) if t in cur else (cur | {t})
                        chosen[name] = cur or None
                elif key == "enter":
                    return remember(chosen)
    finally:
        if FULLSCREEN:
            sys.stdout.write(ALT_OFF)
            sys.stdout.flush()


def scroll_window(count: int, cursor: int, offset: int, height: int, margin: int = 1
                  ) -> tuple[int, int, int]:
    """Keep `cursor` inside a `height`-row window, moving `offset` as little as possible.

    Minimal movement rather than re-centring: a list that jumps under the cursor every
    keypress is harder to read than one that scrolls a line at a time. `margin` keeps a row
    of context visible past the cursor so you can see where you are heading.
    """
    if count <= height:
        return 0, 0, count
    offset = min(offset, count - height)
    if cursor < offset + margin:
        offset = cursor - margin
    elif cursor >= offset + height - margin:
        offset = cursor - height + 1 + margin
    offset = max(0, min(offset, count - height))
    return offset, offset, min(count, offset + height)


def remember(chosen: dict[str, set[str] | None]) -> dict | None:
    """Persist the picker's answer so the next session starts where this one did."""
    if not chosen:
        return None
    save_prefs(selected={k: sorted(v) if v else None for k, v in chosen.items()})
    return chosen


def _frame(title: str, rows_out: list[str], keys: str, accent: str = "") -> None:
    """The picker, in the same box as a card, so the two do not look like different apps."""
    cols, rows = shutil.get_terminal_size((90, 24))
    body = [""] + rows_out + [""]
    body = body[: max(1, rows - 4)]
    foot = f"{C['dim']}{keys}{C['reset']}"
    # The picker is a list of rows, not prose, so it is not held to the reading measure:
    # a truncated command hint is worse than a wide box.
    width = fit_width(body, cols, title, foot, target=PICKER_WIDTH)
    boxed = frame(body, width, head=title, foot=foot, border=f"{C['dim']}{accent}")
    sys.stdout.write("\033[H\033[J" if FULLSCREEN else "\n")
    sys.stdout.write(place(boxed, cols, rows, centre=FULLSCREEN) + "\n")
    sys.stdout.flush()


def picker_height() -> int:
    """Rows available for list items inside the frame, leaving room for the indicators."""
    _cols, rows = shutil.get_terminal_size((90, 24))
    return max(3, rows - 8)


def _indicators(out: list[str], offset: int, end: int, count: int) -> list[str]:
    above, below = offset, count - end
    head = f" {C['dim']}↑ {above} more{C['reset']}" if above else ""
    foot = f" {C['dim']}↓ {below} more{C['reset']}" if below else ""
    return ([head] if head else []) + out + ([foot] if foot else [])


def command_hints(decks, undecked) -> list[str]:
    """Name the command that fixes what the picker is showing.

    The two slash commands are the half of this tool that is not the CLI, and the picker is
    the only place they would ever be discovered.
    """
    # The command goes on its own line rather than trailing the subject: a narrow terminal
    # truncates the end of a row, and the end is the half worth reading.
    out = []
    stale = [d["entry"]["name"] for d in decks if d.get("behind")]
    if stale:
        out += [f" {C['yellow']}⟳{C['reset']} {C['dim']}{', '.join(stale[:3])} moved on{C['reset']}",
                f"   {C['bold']}/repo-cards:update{C['reset']}"]
    if undecked:
        shown = ", ".join(undecked[:3]) + (f" +{len(undecked) - 3}" if len(undecked) > 3 else "")
        out += [f"   {C['dim']}no deck: {shown}{C['reset']}",
                f"   {C['bold']}/repo-cards:generate{C['reset']}"]
    return ([""] + out) if out else []


def draw_repo_picker(decks, chosen, row, offset, undecked=()) -> int:
    height = picker_height()
    offset, start, end = scroll_window(len(decks), row, offset, height)
    out = []
    for i, d in list(enumerate(decks))[start:end]:
        name = d["entry"]["name"]
        sel = name in chosen
        cursor = f"{C['bold']}❯{C['reset']}" if i == row else " "
        box = f"{C['green']}◉{C['reset']}" if sel else f"{C['dim']}○{C['reset']}"
        scope = chosen.get(name)
        detail = (f"{C['yellow']}{', '.join(sorted(scope))}{C['reset']}" if scope
                  else f"{C['dim']}all topics{C['reset']}" if sel else "")
        due = f"{C['yellow']}{d['due']:>4} due{C['reset']}" if d["due"] else f"{C['dim']}   0 due{C['reset']}"
        more = f"{C['dim']} →{C['reset']}" if d["topics"] else "  "
        stale = f"{C['yellow']}⟳{C['reset']}" if d.get("behind") else " "
        out.append(f" {cursor} {box} {name_colour(name)}{name:<16}{C['reset']}{stale} "
                   f"{C['dim']}{len(d['cards']):>4} cards{C['reset']}  {due}{more}  {detail}")
    _frame(f"{C['bold']}Which decks?{C['reset']} "
           f"{C['dim']}{len(chosen)}/{len(decks)} selected{C['reset']}",
           _indicators(out, offset, end, len(decks)) + command_hints(decks, undecked),
           "↑/↓ move · space toggle · → topics · enter start · q cancel")
    return offset


def draw_topic_picker(d, chosen, row, offset) -> int:
    name = d["entry"]["name"]
    scope = chosen.get(name)
    opts = ["all", *d["topics"]]
    height = picker_height()
    offset, start, end = scroll_window(len(opts), row, offset, height)
    out = []
    for i, t in list(enumerate(opts))[start:end]:
        on = (scope is None) if t == "all" else bool(scope and t in scope)
        cursor = f"{C['bold']}❯{C['reset']}" if i == row else " "
        box = f"{C['green']}◉{C['reset']}" if on else f"{C['dim']}○{C['reset']}"
        if t == "all":
            label, note = f"{C['dim']}everything{C['reset']}", ""
        else:
            topic = all_topics(d["deck"])[t]
            _t, cards, _m = topic_cards(d["deck"], t)
            label = f"{topic_colour(t, tuple(d['topics']))}{t}{C['reset']}"
            note = f"{C['dim']}{len(cards):>3} cards  {topic.get('description', '')}{C['reset']}"
        out.append(f" {cursor} {box} {label:<34} {note}")
    _frame(f"{name_colour(name)}{name}{C['reset']} {C['dim']}topics{C['reset']}",
           _indicators(out, offset, end, len(opts)),
           "↑/↓ move · space toggle · ← back · enter start",
           accent=name_colour(name))
    return offset


def picked_rows(args, chosen: dict[str, set[str] | None]) -> list[tuple]:
    """Build the queue from a picker selection, honouring the same due/priority rules."""
    rows, states = [], {}
    tags, grep = wanted_tags(args), compile_grep(args.grep)
    for entry in load_registry():
        name = entry["name"]
        if name not in chosen:
            continue
        loaded = load_deck(entry, quiet=True)
        if loaded is None:
            continue
        deck, cards = loaded
        if topics := chosen[name]:
            wanted, seen = [], set()
            for t in sorted(topics):
                for c in topic_cards(deck, t)[1]:
                    if c["id"] not in seen:
                        seen.add(c["id"])
                        wanted.append(c)
            cards = wanted
        state = states.setdefault(name, load_state(name))
        churn = churn_context(entry, cards)
        for card in cards:
            if not card_matches(card, tags, grep):
                continue
            cs = card_state(state, card["id"])
            if not args.all and not is_due(cs):
                continue
            rows.append((entry, card, state, deck, churn))
    rows.sort(key=lambda r: order_score(r[1], r[3], card_state(r[2], r[1]["id"]), r[4]))
    return rows[: args.limit] if args.limit else rows


# --- review ------------------------------------------------------------------

ALT_ON, ALT_OFF = "\033[?1049h\033[?25l", "\033[?1049l\033[?25h"


#: Marks where the rule between question and answer goes. A sentinel rather than an index,
#: because the height trim rewrites the list underneath it.
DIVIDER = "\x00rule\x00"


def session_rows(args) -> list[tuple]:
    """The queue, ordered. One place so the picker and the flags share it."""
    queue = collect(args)
    queue.sort(key=lambda row: order_score(row[1], row[3], card_state(row[2], row[1]["id"]), row[4]))
    return queue[: args.limit] if args.limit else queue


def topics_of(card: dict, deck: dict) -> list[str]:
    """Topics this card belongs to, declared ones first so the badge is the curated name."""
    declared = [n for n, t in (deck.get("topics") or {}).items()
                if card["id"] in (t.get("cards") or [])]
    computed = [n for n, t in (deck.get("_computed") or {}).items()
                if card["id"] in (t.get("cards") or [])]
    return declared + computed


def cmd_review(args) -> int:
    # The picker is the default when nothing narrows the session and there is a terminal to
    # draw it on. Any explicit scope means the caller has already chosen.
    scoped = any([args.repo, args.tag, args.topic, args.grep, args.priority, args.new])
    if FULLSCREEN and not scoped and not args.no_pick:
        chosen = pick_session(args)
        if chosen is None:
            return 0
        queue = picked_rows(args, chosen)
        if not queue:
            print(f"{C['green']}Nothing due in that selection.{C['reset']}"
                  f" {C['dim']}--all to cram.{C['reset']}")
            return 0
        return run_session(queue, args.mode)

    queue = session_rows(args)
    if not queue:
        if not load_registry():
            print("No repos registered. Add one with: repo-cards register /path/to/repo")
            return 0
        scope = f" tagged {args.tag}" if args.tag else ""
        print(f"{C['green']}Nothing due{scope}.{C['reset']} {C['dim']}--all to cram, --new for unseen.{C['reset']}")
        return 0
    return run_session(queue, args.mode)


def run_session(queue: list[tuple], mode: str = "test") -> int:
    """One pass over the queue, navigable. Grades are held until the session ends.

    Two modes, because reading and being tested are different activities and doing both in
    one screen means doing neither well. **learn** shows everything at once and grades
    nothing: it is for building the picture, or meeting what an update just changed.
    **test** hides the answer until you have had a go, and is the only one that moves a
    card's box. `l` switches mid-session, because realising you do not know an area is
    exactly when you want to stop testing and start reading.
    """
    roots = {e["name"]: Path(e["root"]).expanduser() for e, *_ in queue}
    kinds = {c["id"]: kind_of(c) for _, c, *_ in queue}
    revealed: set[int] = set()
    graded: dict[int, str] = {}
    i = 0

    save_prefs(mode=mode)
    if FULLSCREEN:
        sys.stdout.write(ALT_ON)
    try:
        while True:
            entry, card, state, deck, _churn = queue[i]
            cs = card_state(state, card["id"])
            draw_card(queue, i, kinds[card["id"]], roots[entry["name"]], cs,
                      mode == "learn" or i in revealed, graded.get(i), mode)
            key = read_key()

            if key in ("q", "esc"):
                break
            if key == "l":
                mode = "learn" if mode == "test" else "test"
                save_prefs(mode=mode)
            elif key == "left":
                i = max(0, i - 1)
            elif key == "right":
                if i + 1 >= len(queue):
                    break
                i += 1
            elif key == "enter":
                if mode == "learn" or i in revealed:
                    if i + 1 >= len(queue):
                        break
                    i += 1
                else:
                    revealed.add(i)
            elif key in ("y", "n") and mode == "test":
                revealed.add(i)
                graded[i] = key
                if i + 1 >= len(queue):
                    break
                i += 1
    finally:
        if FULLSCREEN:
            sys.stdout.write(ALT_OFF)
            sys.stdout.flush()

    return finish_session(queue, graded)


def draw_card(queue, i, kind, root, cs, revealed, grade, mode="test") -> None:
    entry, card, _state, _deck, _churn = queue[i]
    cols, rows = shutil.get_terminal_size((90, 24))
    # Wrap to the widest the box may ever be, then shrink the box to what the text used.
    inner = min(max(MIN_WIDTH, min(TARGET_WIDTH, cols - 2)), max(20, cols - 2)) - 4

    repo = entry["name"]
    accent = name_colour(repo)
    pri = priority_of(card)
    siblings = tuple(all_topics(_deck).keys())
    topics = topics_of(card, _deck)

    head = f"{accent}{repo}{C['reset']}"
    shown_kind = "learn" if mode == "learn" else kind_label(kind)
    kind_col = sgr(214 if mode == "learn" else KIND_COLOUR[kind])
    head += f" {C['dim']}·{C['reset']} {kind_col}{shown_kind}{C['reset']}"

    head_right = (f"{C['dim']}{i + 1}/{len(queue)}{C['reset']}  "
                  f"{sgr(BOX_COLOUR[cs['box']])}box {cs['box']}{C['reset']}  "
                  f"{sgr(PRIORITY_COLOUR[pri])}{'★' * (4 - pri)}{C['reset']}")

    body: list[str] = [""]
    if topics:
        body.append("  " + "  ".join(
            f"{topic_colour(t, siblings)}▌{t}{C['reset']}" for t in topics[:3]))
        body.append("")
    body += render_prompt(card, kind, inner - 2, root) + [""]
    if revealed:
        body += [DIVIDER, ""] + render_answer(card, kind, inner - 2, root) + [""]
        anchor = str(card.get("anchor", "-"))
        body += [f"  {C['dim']}anchor{C['reset']}  {link(anchor, root, anchor)}", ""]

    # Wrapped lines arrive as one string per block; split so the frame pads each row.
    flat: list[str] = []
    for block in body:
        flat.extend(block.split("\n"))

    def hint(key: str, label: str, colour: int) -> str:
        return f"{sgr(colour)}{key}{C['reset']} {C['dim']}{label}{C['reset']}"

    nav = hint("←/→", "move", 117)
    quit_ = hint("q", "quit", 245)
    if mode == "learn":
        parts = [nav, hint("l", "test", 214), quit_]
    elif not revealed:
        parts = [nav, hint("enter", "reveal", 109), hint("l", "learn", 214), quit_]
    else:
        parts = [nav, hint("y", "got it", 114), hint("n", "missed", 203),
                 hint("l", "learn", 214), quit_]
    keys = f" {C['dim']}·{C['reset']} ".join(parts)
    mark = {"y": f"{sgr(114)}✓ got it{C['reset']}",
            "n": f"{sgr(203)}✗ missed{C['reset']}"}.get(grade, "")
    foot = keys + (f"  {mark}" if mark else "")

    # Trim from the middle padding rather than the content if the card is taller than the
    # terminal: losing a blank line is invisible, losing the answer is not.
    budget = rows - 3
    while len(flat) > budget and "" in flat:
        flat.remove("")
    flat = flat[:budget]
    # Located after trimming, never tracked through it: an index into a list that blank-line
    # removal is rewriting is exactly how the rule ended up under the answer.
    divider = flat.index(DIVIDER) if DIVIDER in flat else None
    flat = [ln for ln in flat if ln != DIVIDER]
    width = fit_width(flat, cols, f"{head} {head_right}", foot)
    boxed = frame(flat, width, head=head, head_right=head_right,
                  foot=foot, border=f"{C['dim']}{accent}", divider_at=divider)

    sys.stdout.write("\033[H\033[J" if FULLSCREEN else "\n")
    sys.stdout.write(place(boxed, cols, rows, centre=FULLSCREEN) + "\n")
    sys.stdout.flush()


# SGR colour codes and OSC 8 hyperlink wrappers both occupy no columns.
_INVISIBLE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b\]8;;[^\x1b]*\x1b\\")


def visible_len(text: str) -> int:
    return len(_INVISIBLE.sub("", text))


def ansi_truncate(text: str, limit: int) -> str:
    """Cut to `limit` visible columns without severing an escape sequence.

    Slicing by character index is wrong once a hyperlink wraps the text, because the
    escapes are no longer all at the front: the cut lands inside one and the terminal
    swallows the rest of the line.
    """
    out, vis, i = [], 0, 0
    while i < len(text) and vis < limit:
        if text[i] == "\x1b" and (mt := _INVISIBLE.match(text, i)):
            out.append(mt.group())
            i = mt.end()
            continue
        out.append(text[i])
        vis += 1
        i += 1
    return "".join(out) + C["reset"]


def hard_break(text: str, width: int) -> list[str]:
    """Split a token with no spaces in it, so a long path cannot burst the frame."""
    return [text[i:i + width] for i in range(0, len(text), width)] or [""]


def finish_session(queue, graded: dict[int, str]) -> int:
    touched: dict[str, dict] = {}
    right = wrong = 0
    for i, grade in graded.items():
        entry, card, state, _deck, _churn = queue[i]
        touched[entry["name"]] = state
        cs = card_state(state, card["id"])
        cs["seen"] += 1
        cs["last_seen"] = today().isoformat()
        if grade == "y":
            right += 1
            cs["box"] = min(cs["box"] + 1, MAX_BOX)
        else:
            wrong += 1
            cs["lapses"] += 1
            cs["box"] = 1   # a fact you have lost is not most of the way to known
        cs["due"] = (today() + dt.timedelta(days=INTERVALS[cs["box"]])).isoformat()
    for name, state in touched.items():
        save_state(name, state)

    total = right + wrong
    if not total:
        print(f"{C['dim']}Nothing graded, nothing rescheduled.{C['reset']}")
        return 0
    print(f"{C['bold']}{right} right, {wrong} missed{C['reset']}  {C['dim']}({round(100 * right / total)}%)"
          f" of {len(queue)} shown{C['reset']}")
    if wrong:
        print(f"{C['dim']}Missed cards are back in box 1 and due tomorrow.{C['reset']}")
    stale = sorted({e["name"] for e, *_ in queue
                    if (d := deck_summary(e)) and d.get("behind")})
    if stale:
        print(f"{C['yellow']}⟳{C['reset']} {', '.join(stale)} moved since the deck was written. "
              f"{C['dim']}Run{C['reset']} /repo-cards:update")
    return 0


# --- stats, list -------------------------------------------------------------

def cmd_stats(args) -> int:
    repos = load_registry()
    if not repos:
        print("No repos registered. Add one with: repo-cards register /path/to/repo")
        return 0
    for entry in repos:
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=not args.repo)
        if loaded is None:
            continue
        deck, cards = loaded
        state = load_state(entry["name"])
        boxes = dict.fromkeys(range(1, MAX_BOX + 1), 0)
        due = unseen = 0
        for card in cards:
            cs = state.get(card["id"])
            if cs is None:
                unseen += 1
                due += 1
                boxes[1] += 1
                continue
            boxes[cs["box"]] += 1
            if is_due(cs):
                due += 1
        bar = "  ".join(f"{'▁▃▅▆█'[b - 1]} box{b} {C['dim']}{boxes[b]}{C['reset']}" for b in range(1, MAX_BOX + 1))
        head = git(Path(entry["root"]).expanduser(), "rev-parse", "--short", "HEAD")
        sha = deck.get("last_update_sha", "?")
        stale = (f"  {C['yellow']}⟳ repo at {head} · /repo-cards:update{C['reset']}"
                 if head and sha != "?" and head != sha else "")
        print(f"\n{C['bold']}{entry['name']}{C['reset']}  "
              f"{C['dim']}{len(cards)} cards, {sha}{C['reset']}{stale}")
        print(f"  {C['yellow']}{due} due{C['reset']}, {unseen} never seen")
        print(f"  {bar}")
        pri = collections.Counter(priority_of(c) for c in cards)
        routed = sum(1 for c in cards if look_entries(c))
        recent = sum(1 for c in cards if (d := card_date(c, deck)) and (today() - d).days <= RECENT_DAYS)
        print(f"  {C['dim']}★★★ {pri[1]} foundational · ★★ {pri[2]} core · ★ {pri[3]} detail"
              f"{f' · {recent} changed in the last {RECENT_DAYS}d' if recent else ''}{C['reset']}")
        print(f"  {C['dim']}{routed}/{len(cards)} carry a `look` route{C['reset']}")
        counts, p90 = churn_context(entry, cards)
        hot = sorted(((churn_boost(c, counts, p90), c) for c in cards), key=lambda kv: -kv[0])[:3]
        if hot and hot[0][0] > 0:
            names = ", ".join(c["id"] for b, c in hot if b > 0)
            print(f"  {C['dim']}anchors moving most ({CHURN_WINDOW_DAYS}d): {names}{C['reset']}")
        lapsed = sorted(((c, s["lapses"]) for c, s in state.items() if s.get("lapses", 0) >= 2), key=lambda kv: -kv[1])[:5]
        if lapsed:
            print(f"  {C['dim']}stickiest: {', '.join(f'{c} (x{n})' for c, n in lapsed)}{C['reset']}")
    print()
    return 0


def cmd_list(args) -> int:
    for entry in load_registry():
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=not args.repo)
        if loaded is None:
            continue
        _deck, cards = loaded
        state = load_state(entry["name"])
        tags, grep = wanted_tags(args), compile_grep(args.grep)
        for card in sorted(cards, key=priority_of):
            if not card_matches(card, tags, grep):
                continue
            if args.priority and priority_of(card) != args.priority:
                continue
            cs = state.get(card["id"], {"box": 1, "due": "never"})
            flag = f"{C['yellow']}due{C['reset']}" if cs["due"] == "never" or is_due(cs) else f"{C['dim']}{cs['due']}{C['reset']}"
            star = ("★" * (4 - priority_of(card))).ljust(3)
            print(f"  {star} {C['dim']}box{cs['box']}{C['reset']} {flag:>22}  {card['id']:<38} {C['dim']}{','.join(card.get('tags', []))}{C['reset']}")
    return 0


# --- drift: the mechanical half of `update` ----------------------------------

def git(root: Path, *args: str) -> str:
    try:
        return subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True, check=True).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return ""


def drift_facts(entry: dict) -> dict:
    """Everything drift knows about one repo, before deciding how much of it to print."""
    root = Path(entry["root"]).expanduser()
    f = {"name": entry["name"], "root": root, "sha": None, "cards": [], "head": "", "log": "",
         "changed": [], "hot": [], "cold": [], "routes": [], "dead": [], "uncovered": [],
         "status": "", "regen": False}

    def note_dead() -> None:
        """Paths a card points at that are not in the repo any more.

        Worth checking whatever the deck's sha says: a path can be wrong from the day it was
        written, and a route that 404s teaches the reader nothing.
        """
        for c in f["cards"]:
            for pth in all_paths(c):
                if not (root / pth).exists():
                    f["dead"].append((c["id"], pth))

    loaded = load_deck(entry, quiet=True)
    if loaded is None:
        # Registered but never generated. A normal state, and the one the summary most needs
        # to surface: it is the list of repos still waiting on /repo-cards:generate.
        f["status"] = "no deck"
        return f
    deck, cards = loaded
    f["cards"] = cards
    f["sha"] = deck.get("last_update_sha")
    sha = f["sha"]

    if not root.is_dir():
        f["status"] = "root missing"
        return f
    note_dead()
    f["head"] = git(root, "rev-parse", "--short", "HEAD")
    if not sha or not f["head"]:
        f["status"] = "no baseline"
        return f
    if sha == f["head"]:
        f["status"] = "up to date"
        return f

    f["status"] = "behind"
    f["log"] = git(root, "log", "--oneline", f"{sha}..HEAD")
    f["changed"] = [x for x in git(root, "diff", "--name-only", f"{sha}..HEAD").split("\n") if x]

    # An anchor carrying #symbol is narrowed further: one commit to a 700-line module
    # should not flag every card drawn from it, or the update drowns in false positives.
    changed_set, diff_cache = set(f["changed"]), {}
    for c in cards:
        path, _, symbol = str(c.get("anchor", "")).partition("#")
        if not path:
            continue
        if not (path in changed_set or any(x.startswith(path.rstrip("/") + "/") for x in changed_set)):
            continue
        if not symbol:
            f["hot"].append(c)
            continue
        if path not in diff_cache:
            diff_cache[path] = git(root, "diff", "-U5", f"{sha}..HEAD", "--", path)
        # Hunk headers carry the enclosing function name, so a symbol absent from the
        # whole diff was very likely not touched.
        (f["hot"] if symbol in diff_cache[path] else f["cold"]).append(c)

    hot_ids = {c["id"] for c in f["hot"]}
    for c in cards:
        if c["id"] in hot_ids:
            continue
        touched = [pth for pth, _ in look_entries(c)
                   if pth.split("#")[0] in changed_set]
        if touched:
            f["routes"].append((c, touched))

    behind_n = len(f["log"].splitlines())
    dead_frac = len({cid for cid, _ in f["dead"]}) / max(1, len(cards))
    f["regen"] = behind_n > REGEN_COMMITS or dead_frac > REGEN_DEAD_FRACTION

    covered = {pth for c in cards for pth in all_paths(c)}
    f["uncovered"] = [x for x in f["changed"] if x not in covered]
    return f


def print_drift_detail(f: dict) -> None:
    print(f"\n{C['bold']}=== {f['name']} ==={C['reset']}")
    print(f"root: {f['root']}")
    print(f"deck: {deck_path(f['name'])}")
    if f["status"] == "no deck":
        print(f"{C['yellow']}no deck yet. Generate one with /repo-cards:generate{C['reset']}")
        return
    print(f"deck generated at: {f['sha'] or '(unrecorded)'}")
    if f["status"] == "root missing":
        print(f"{C['red']}root does not exist on this machine; re-register it{C['reset']}")
        return
    print(f"HEAD now: {f['head'] or '(not a git repo)'}")
    if f["status"] == "no baseline":
        print("no baseline to diff against; treat every card as unverified")
        return
    if f["status"] == "up to date":
        print(f"{C['green']}up to date, no commits since the deck was generated{C['reset']}")
        return

    print(f"\n--- commits since {f['sha']} ({len(f['log'].splitlines())}) ---\n{f['log']}")
    print(f"\n--- files changed ({len(f['changed'])}) ---")
    print("\n".join(f"  {x}" for x in f["changed"]) or "  (none)")
    if f.get("regen"):
        print(f"\n{C['yellow']}Drifted far enough that a regenerate is likely cheaper than "
              f"verifying this card by card.{C['reset']}")
    print(f"\n--- cards whose anchor changed ({len(f['hot'])}) : VERIFY THESE ---")
    print("\n".join(f"  {c['id']:<40} {c['anchor']}" for c in f["hot"]) or "  (none)")
    if f["cold"]:
        print(f"\n--- file changed but the anchored symbol was not touched ({len(f['cold'])}) : likely fine ---")
        print("\n".join(f"  {c['id']:<40} {c['anchor']}" for c in f["cold"]))
    if f["routes"]:
        print(f"\n--- cards whose `look` route changed ({len(f['routes'])}) : directions may be stale ---")
        for c, touched in f["routes"]:
            print(f"  {c['id']:<40} {', '.join(touched)}")
    if f["dead"]:
        print(f"\n--- paths that no longer exist ({len(f['dead'])}) : FIX THESE ---")
        for cid, pth in f["dead"]:
            print(f"  {cid:<40} {pth}")
    print(f"\n--- changed files no card points at ({len(f['uncovered'])}) : CANDIDATES ---")
    print("\n".join(f"  {x}" for x in f["uncovered"]) or "  (none)")


def cmd_drift(args) -> int:
    """What changed since each deck was generated, and which cards that touches.

    Deliberately mechanical: it says what to look at, and the skill decides what a card
    should now say. Written to be read by Claude as well as by a person.

    One repo prints in full. Every repo prints a summary instead, because eight repos of
    detail is not a triage, and the point of a sweep is deciding where to spend the effort.
    """
    entries = [e for e in load_registry() if not args.repo or e["name"] == args.repo]
    if not entries:
        print("No repos registered. Add one with: repo-cards register /path/to/repo")
        return 0

    facts = [drift_facts(e) for e in entries]
    if args.repo or args.full or len(facts) == 1:
        for f in facts:
            print_drift_detail(f)
        print()
        return 0

    behind = [f for f in facts if f["status"] == "behind"]
    ungenerated = [f for f in facts if f["status"] == "no deck"]
    rank = {"behind": 0, "no deck": 1, "root missing": 2, "no baseline": 3, "up to date": 4}
    colours = {"behind": C["yellow"], "up to date": C["green"], "no deck": C["dim"]}

    print(f"\n  {'repo':<20} {'commits':>8} {'verify':>7} {'routes':>7} {'dead':>5} {'new files':>10}   state")
    for f in sorted(facts, key=lambda x: (rank.get(x["status"], 9), -len(x["hot"]))):
        colour = colours.get(f["status"], C["red"])
        dead = f"{C['red']}{len(f['dead'])}{C['reset']}" if f["dead"] else "-"
        if f["status"] == "behind":
            cols = (str(len(f["log"].splitlines())), str(len(f["hot"])), str(len(f["routes"])), str(len(f["uncovered"])))
        else:
            cols = ("-", "-", "-", "-")
        print(f"  {f['name']:<20} {cols[0]:>8} {cols[1]:>7} {cols[2]:>7} {dead:>5} {cols[3]:>10}   {colour}{f['status']}{C['reset']}")

    print()
    regen = [f for f in facts if f.get("regen")]
    if behind:
        print(f"  {len(behind)} deck(s) behind. Detail: repo-cards drift --repo <name>   (--full for all)")
    if regen:
        names = ", ".join(f["name"] for f in regen)
        print(f"  {C['yellow']}{names}: far enough behind that a regenerate beats an update"
              f"{C['reset']}\n  {C['dim']}Ask Claude for{C['reset']} /repo-cards:generate")
    if ungenerated:
        print(f"  {len(ungenerated)} repo(s) registered with no deck: {', '.join(f['name'] for f in ungenerated)}")
        print(f"  {C['dim']}Generate one by running /repo-cards:generate from inside it.{C['reset']}")
    if not behind and not ungenerated:
        print(f"  {C['green']}Every deck is current.{C['reset']}")
    print()
    return 0


# --- brief: read up on one area, without touching the schedule ---------------

def cmd_topics(args) -> int:
    """List the curated topics each deck defines."""
    found = False
    for entry in load_registry():
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=not args.repo)
        if loaded is None:
            continue
        deck, _cards = loaded
        topics = all_topics(deck)
        if not topics:
            print(f"\n{C['bold']}{entry['name']}{C['reset']}  {C['dim']}no topics defined{C['reset']}")
            continue
        found = True
        print(f"\n{C['bold']}{entry['name']}{C['reset']}")
        for name, topic in topics.items():
            _t, cards, missing = topic_cards(deck, name)
            warn = f"  {C['yellow']}({len(missing)} card(s) no longer in the deck){C['reset']}" if missing else ""
            print(f"  {C['cyan']}{name:<22}{C['reset']} {len(cards):>3} cards  {C['dim']}{topic.get('description', '')}{C['reset']}{warn}")
    if found:
        print(f"\n{C['dim']}Read one with: repo-cards brief --topic <name>{C['reset']}")
    print()
    return 0


def cmd_brief(args) -> int:
    """Read an area end to end, question and answer together, in order.

    Deliberately not a review: it writes no state. Cramming before a meeting is a different
    mental mode from recall practice, and letting it reschedule cards you already know would
    corrupt the one signal the boxes carry. Order is the deck's or the topic's, never
    shuffled, because this is for rebuilding a mental model rather than testing it.
    """
    if not (args.topic or args.tag or args.grep):
        print(f"{C['dim']}Pick an area: --topic NAME, --tag a,b or --grep PATTERN.{C['reset']}\n")
        return cmd_topics(args)

    width = min(shutil.get_terminal_size((90, 24)).columns, 96)
    tags, grep = wanted_tags(args), compile_grep(args.grep)
    shown = 0

    for entry in load_registry():
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=not args.repo)
        if loaded is None:
            continue
        deck, cards = loaded
        heading, missing = "", []

        if args.topic:
            topic, cards, missing = topic_cards(deck, args.topic)
            if topic is None:
                continue
            heading = topic.get("description", "")
            notes = topic.get("notes")
        else:
            notes = None
        cards = [c for c in cards if card_matches(c, tags, grep)]
        if not cards:
            continue

        label = f"{entry['name']} · {args.topic}" if args.topic else entry["name"]
        print(f"\n{C['bold']}{label}{C['reset']}")
        if heading:
            print(f"{C['dim']}{heading}{C['reset']}")
        line = f"{len(cards)} card(s)"
        if notes:
            note_path = deck_dir(entry["name"]) / notes
            line += f" · notes: {note_path}" + ("" if note_path.exists() else f"  {C['yellow']}(missing){C['reset']}")
        print(f"{C['dim']}{line}{C['reset']}")
        if missing:
            print(f"{C['yellow']}{len(missing)} card(s) in this topic are no longer in the deck: {', '.join(missing)}{C['reset']}")
        print()

        for n, card in enumerate(cards, 1):
            # Wrapped at the answer's indent, then the first line's indent is replaced by the
            # number, so continuation lines stay aligned under it instead of hitting column 0.
            q = wrap(card["q"], width, "     ")
            print(f"{C['bold']}{n:>3}. {q[5:]}{C['reset']}")
            for pth, what in look_entries(card) or [(card.get("anchor", "-"), "")]:
                print(f"{C['dim']}     ↳ {pth}{('  ' + what) if what else ''}{C['reset']}")
            print(f"{C['cyan']}{wrap(card['a'], width, '     ')}{C['reset']}\n")
            shown += 1

    if not shown:
        scope = args.topic or args.tag or args.grep
        print(f"{C['yellow']}Nothing matched {scope!r}.{C['reset']} {C['dim']}Try: repo-cards topics{C['reset']}")
        return 1
    print(f"{C['dim']}{shown} card(s). Nothing was rescheduled.{C['reset']}\n")
    return 0


# --- registry management -----------------------------------------------------

def cmd_register(args) -> int:
    if not args.path:
        print(f"{C['red']}usage: repo-cards register /path/to/repo [--name NAME]{C['reset']}")
        return 1
    root = Path(args.path).expanduser().resolve()
    if not root.is_dir():
        print(f"{C['red']}no such directory: {root}{C['reset']}")
        return 1
    name = args.name or root.name
    repos = [r for r in load_registry() if r["name"] != name]
    repos.append({"name": name, "root": str(root)})
    repos.sort(key=lambda r: r["name"])
    save_registry(repos)
    (deck_dir(name) / "notes").mkdir(parents=True, exist_ok=True)
    print(f"{C['green']}registered {name}{C['reset']}\n  root: {root}\n  deck: {deck_path(name)}")
    if not deck_path(name).exists():
        print(f"{C['yellow']}  no deck yet: ask Claude to \"generate repo cards\" in that repo{C['reset']}")
    return 0


def cmd_forget(args) -> int:
    if not args.path:
        print(f"{C['red']}usage: repo-cards forget NAME{C['reset']}")
        return 1
    name = args.path
    repos = load_registry()
    if not any(r["name"] == name for r in repos):
        print(f"{C['yellow']}{name} is not registered{C['reset']}")
        return 1
    save_registry([r for r in repos if r["name"] != name])
    print(f"{C['green']}unregistered {name}{C['reset']}")
    print(f"{C['dim']}Its deck and progress are kept at {deck_dir(name)}; delete that by hand if you meant to.{C['reset']}")
    return 0


def cmd_repos(args) -> int:
    repos = load_registry()
    if not repos:
        print("No repos registered. Add one with: repo-cards register /path/to/repo")
        return 0
    for r in repos:
        has_deck = deck_path(r["name"]).exists()
        has_root = Path(r["root"]).expanduser().is_dir()
        status = f"{C['green']}ok{C['reset']}" if has_deck and has_root else (
            f"{C['red']}no deck{C['reset']}" if not has_deck else f"{C['red']}root missing{C['reset']}")
        print(f"  {r['name']:<20} {status:<20} {r['root']}")
    return 0


def cmd_home(args) -> int:
    d = data_home()
    print(f"platform:  {sys.platform}")
    print(f"data home: {d}{'' if d.exists() else '  (not created yet)'}")
    print(f"registry:  {registry_path()}")
    print(f"decks:     {d}/<name>/deck.yaml")
    print(f"state:     {d}/<name>/state.json")
    print(f"notes:     {d}/<name>/notes/")
    print(f"\n{C['dim']}Override with REPO_CARDS_HOME, or XDG_DATA_HOME on any platform.{C['reset']}")
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="repo-cards", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("command", nargs="?", default="review",
                   choices=["review", "test", "learn", "brief", "topics", "stats", "list",
                            "drift", "register", "forget", "repos", "home"])
    p.add_argument("path", nargs="?", help="for `register`: repo root. for `forget`: the name")
    p.add_argument("--name", help="for `register`: deck name (default: directory name)")
    p.add_argument("--repo", help="limit to one registered repo")
    p.add_argument("--tag", help="limit to these tags (one name, or a comma-separated list)")
    p.add_argument("--grep", help="limit to cards matching this regex (question, answer, anchor, tags)")
    p.add_argument("--topic", help="limit to a curated topic (see `repo-cards topics`)")
    p.add_argument("--limit", type=int, help="cap the session length")
    p.add_argument("--all", action="store_true", help="ignore due dates (cram)")
    p.add_argument("--new", action="store_true", help="only cards never seen")
    p.add_argument("--mode", choices=["test", "learn"], default=None,
                   help="test hides the answer and grades; learn shows everything, grades nothing")
    p.add_argument("--no-pick", action="store_true",
                   help="skip the interactive picker and review everything due")
    p.add_argument("--full", action="store_true", help="for `drift`: full detail for every repo, not a summary")
    p.add_argument("--priority", type=int, choices=[1, 2, 3],
                   help="only cards at this priority (1 foundational, 2 core, 3 detail)")
    args = p.parse_args()
    # `learn` and `test` are review with the mode chosen up front.
    if args.command in ("learn", "test"):
        args.mode, args.command = args.command, "review"
    args.mode = args.mode or load_prefs().get("mode", "test")
    return {
        "review": cmd_review, "brief": cmd_brief, "topics": cmd_topics,
        "stats": cmd_stats, "list": cmd_list, "drift": cmd_drift,
        "register": cmd_register, "forget": cmd_forget, "repos": cmd_repos, "home": cmd_home,
    }[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
