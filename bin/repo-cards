#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml"]
# ///
"""Leitner review over per-repo card decks.

Decks live outside the repos they describe, so nothing is written into a working tree.
Content and scheduling state are separate files: regenerating a deck never costs progress.

  repo-cards                       due cards across every registered repo
  repo-cards --repo billing        one repo
  repo-cards --tag outbox,retry    one or more themes
  repo-cards --all                 ignore due dates (cram)
  repo-cards brief --topic payouts read up on one feature before a meeting
  repo-cards topics                what topics a deck defines
  repo-cards stats                 deck health and box distribution
  repo-cards drift                 what changed since a deck was last updated
  repo-cards catchup               what moved since you last reviewed
  repo-cards check                 validate a deck against the rules it is written to
  repo-cards adopt OLD=NEW         give a renamed card the history of the old id
  repo-cards export --repo N       write a deck out, to share or to commit
  repo-cards import PATH           install a deck somebody else wrote
  repo-cards register PATH         add a repo
  repo-cards home                  print where everything lives
"""

from __future__ import annotations

import argparse
import collections
import datetime as dt
import difflib
import zlib
import json
import os
import random
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

import yaml

# Leitner box -> days until due again. Box 5 is "known", not "finished".
INTERVALS = {1: 1, 2: 2, 3: 4, 4: 8, 5: 16}
MAX_BOX = 5

# Ordering weights. Priority decides what you see first in a capped session; it deliberately
# does NOT touch the intervals above, so a card you demonstrably know still backs off to 16
# days however load-bearing it is.
#
# JITTER is wider than the gap between tiers on purpose: a priority-2 card can beat a
# priority-1 card on any given day, so the order varies and you are not drilling the same
# fifteen in the same sequence forever.
#
# OVERDUE_PER_DAY is the starvation guard, and it is not optional. Simulated over 180 days
# at 15 cards a day across eight decks (~640 cards), a weighted order with no escalation
# left 455 cards never seen at all: the tail cannot out-rank 185 foundational cards, ever.
# A gentle slope with a high cap fixes it without flattening the weighting, because a card
# only overtakes a tier after weeks of neglect rather than days. The same simulation puts
# the starvation cliff just above a 1.0 tier gap, so the gap here stays well clear of it.
PRIORITY_WEIGHT = {1: 0.0, 2: 0.6, 3: 1.2}
DEFAULT_PRIORITY = 2
JITTER = 1.4
RECENT_DAYS = 30        # a card added or rewritten this recently is still bedding in
RECENT_BOOST = 0.6
OVERDUE_PER_DAY = 0.05
OVERDUE_CAP = 3.5

# Churn. A card whose anchor is being edited every week is knowledge at risk: the code is
# live, people are making decisions against it now, and being wrong about it costs today.
# A card anchored on a file nobody has touched in three years is settled, and worth less of
# a short session. Normalised against the deck's own 90th percentile, because "a lot of
# commits" means something different in a two-month-old repo and a ten-year-old one, and
# floored so a repo where nothing moves hands out no boosts at all.
# A card is prose, so it gets a comfortable measure rather than the whole terminal: a line
# 160 columns wide is hard to read back to. The box then shrinks to whatever the content
# actually needs, and is centred, so a short card on a big screen is not a wide box with a
# lot of air in it.
TARGET_WIDTH = 78
PICKER_WIDTH = 104
MIN_WIDTH = 44


# When a deck is this far behind, an incremental update is the wrong tool: verifying a
# hundred anchors one at a time is slower than rereading the repo, and a deck that has
# drifted that far is usually missing whole areas rather than a few facts.
REGEN_COMMITS = 60
REGEN_DEAD_FRACTION = 0.25

# Lapses before a card is called out as probably badly written rather than hard. Three is
# where the balance tips: twice is a fact that needs another look, and a third miss on a
# card whose area you work in usually means the card is two facts wearing one id, or that
# the question is recognisable rather than answerable.
STICKY_LAPSES = 3

#: Grades kept per card, for the shape of it rather than the record.
HISTORY_LEN = 24

#: Every `git log` that asks which files moved needs these. A merge commit lists no files at
#: all by default, so on a repo where work lands through merge requests the answer comes back
#: empty: the merge shows no files, and the branch's own commits are dated when the work was
#: done rather than when it landed, so they fall outside the window too. Asking for the files
#: each merge brought in, against its first parent, counts a landed change once and dates it
#: when it landed.
LOG_FILES = ("--first-parent", "-m")

CHURN_WINDOW_DAYS = 180
CHURN_FLOOR = 3
CHURN_WEIGHT = 0.5

C = {
    "dim": "\033[2m", "bold": "\033[1m", "reset": "\033[0m",
    "green": "\033[32m", "red": "\033[31m", "yellow": "\033[33m", "cyan": "\033[36m",
}
if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
    C = dict.fromkeys(C, "")
if sys.platform == "win32":
    # Windows terminals only interpret these once a process asks for it.
    os.system("")  # noqa: S605, S607


def data_home() -> Path:
    """Where decks, state and notes live.

    REPO_CARDS_HOME wins, then XDG_DATA_HOME on any platform (a user who sets it means it),
    then the platform's own convention.
    """
    if env := os.environ.get("REPO_CARDS_HOME"):
        return Path(env).expanduser()
    if xdg := os.environ.get("XDG_DATA_HOME"):
        return Path(xdg).expanduser() / "repo-cards"
    if sys.platform == "win32":
        base = os.environ.get("LOCALAPPDATA") or os.environ.get("APPDATA")
        return (Path(base) if base else Path.home() / "AppData" / "Local") / "repo-cards"
    if sys.platform == "darwin":
        return Path.home() / "Library" / "Application Support" / "repo-cards"
    return Path.home() / ".local" / "share" / "repo-cards"


def registry_path() -> Path:
    return data_home() / "registry.json"


def deck_dir(name: str) -> Path:
    return data_home() / name


def deck_path(name: str) -> Path:
    return deck_dir(name) / "deck.yaml"


def prefs_path() -> Path:
    return data_home() / "session.json"


def load_prefs() -> dict:
    """What you picked last time. Preferences, not data: losing them costs one keypress."""
    p = prefs_path()
    if not p.exists():
        return {}
    try:
        return json.loads(p.read_text())
    except (json.JSONDecodeError, OSError):
        return {}


def save_prefs(**changes) -> None:
    prefs = {**load_prefs(), **changes}
    p = prefs_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(prefs, indent=2, sort_keys=True) + "\n")


def state_file(name: str) -> Path:
    return deck_dir(name) / "state.json"


# --- your own notes on a card ------------------------------------------------
#
# The deck says what the repo decided. This says what it cost *you*: the afternoon the
# invariant bit, the caller nobody warned you about. It is deliberately not part of the
# card, because an update rewrites cards and must never touch this, and because it is one
# person's experience rather than a fact about the repo. It lives under notes/, so it is
# carried by `export` and survives a regenerate.

NOTE_LINES = 6      # shown on the card; the rest is in the file


def card_note_path(name: str, card_id: str) -> Path:
    return deck_dir(name) / "notes" / "cards" / f"{card_id}.md"


def read_card_note(name: str, card_id: str) -> str:
    try:
        return card_note_path(name, card_id).read_text().strip()
    except OSError:
        return ""


def append_card_note(name: str, card_id: str, line: str) -> None:
    path = card_note_path(name, card_id)
    path.parent.mkdir(parents=True, exist_ok=True)
    existing = read_card_note(name, card_id)
    path.write_text((existing + "\n" if existing else "") + line.strip() + "\n")


def edit_card_note(name: str, card_id: str) -> bool:
    """Open the note in $EDITOR, stepping out of the alt screen while it runs.

    False when there is no editor to open, which is the caller's cue to take a line instead.
    Raw mode is already off here: `read_key` restores it before returning.
    """
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR")
    if not (editor and FULLSCREEN):
        return False
    path = card_note_path(name, card_id)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.touch(exist_ok=True)
    sys.stdout.write(ALT_OFF)
    sys.stdout.flush()
    try:
        subprocess.run([*shlex.split(editor), str(path)], check=False)
    except (OSError, ValueError):
        return False
    finally:
        sys.stdout.write(ALT_ON)
        sys.stdout.flush()
    return True


def today() -> dt.date:
    return dt.date.today()


# --- registry and decks ------------------------------------------------------

def load_registry() -> list[dict]:
    p = registry_path()
    if not p.exists():
        return []
    try:
        return json.loads(p.read_text()).get("repos", [])
    except json.JSONDecodeError:
        print(f"{C['red']}! registry is not valid JSON: {p}{C['reset']}")
        return []


def save_registry(repos: list[dict]) -> None:
    global _ROOTS
    _ROOTS = None
    p = registry_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps({"repos": repos}, indent=2) + "\n")


# --- cross-repo refs ---------------------------------------------------------
#
# A path on a card is repo-relative. `name::path` points into another registered repo, and
# exists because the most expensive knowledge in a pair of services is the contract between
# them, whose two halves live in different working trees. Drift, churn, the recent-commit
# topics and the dead path check all follow the qualifier, so a card in one deck is flagged
# for verification when the other repo moves under it.
#
# `::` rather than `:` so a Windows drive letter cannot be mistaken for a repo name.

REF = re.compile(r"^(?P<repo>[A-Za-z0-9._-]+)::(?P<path>.+)$")

_ROOTS: dict[str, Path] | None = None


def registry_roots() -> dict[str, Path]:
    """Repo name -> root, read once. Invalidated by save_registry."""
    global _ROOTS
    if _ROOTS is None:
        _ROOTS = {r["name"]: Path(r["root"]).expanduser() for r in load_registry()}
    return _ROOTS


def split_ref(ref: str) -> tuple[str | None, str]:
    """`name::path` as (repo, path); a bare path as (None, path). Any #symbol is kept."""
    m = REF.match(str(ref))
    return (m["repo"], m["path"]) if m else (None, str(ref))


def resolve_ref(ref: str, root: Path) -> tuple[Path | None, str]:
    """(root, repo-relative path) for one ref, symbol stripped.

    A root of None means the ref names a repo that is not registered here. That is reported
    rather than skipped: it is either a typo in the deck or a `repo-cards register` nobody
    ran, and both make the route unfollowable.
    """
    name, path = split_ref(ref)
    path = path.split("#")[0]
    if name is None:
        return root, path
    return registry_roots().get(name), path


def load_deck(entry: dict, quiet: bool = False) -> tuple[dict, list[dict]] | None:
    path = deck_path(entry["name"])
    if not path.exists():
        if not quiet:
            print(f"{C['yellow']}! no deck for {entry['name']} at {path}{C['reset']}")
        return None
    try:
        deck = yaml.safe_load(path.read_text()) or {}
    except yaml.YAMLError as err:
        print(f"{C['red']}! deck for {entry['name']} does not parse: {err}{C['reset']}")
        return None
    cards = deck.get("cards") or []
    deck["_computed"] = compute_topics(Path(entry["root"]).expanduser(), cards)
    return deck, cards


def load_state(name: str) -> dict:
    p = state_file(name)
    if not p.exists():
        return {}
    try:
        return json.loads(p.read_text())
    except json.JSONDecodeError:
        # A corrupt state file costs scheduling, not cards. Start over rather than refuse to run.
        print(f"{C['yellow']}! state unreadable, starting fresh: {p}{C['reset']}")
        return {}


def save_state(name: str, state: dict) -> None:
    # Only graded cards are persisted. Scheduling a card nobody has seen is the same as having
    # no row for it, and 80 identical defaults make the file unreadable. A flag is the
    # exception: it is a note to the next update, and it can be raised on a card in learn
    # mode that has never been graded at all.
    seen = {cid: cs for cid, cs in state.items()
            if cs.get("seen", 0) > 0 or cs.get("flagged")}
    p = state_file(name)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(seen, indent=2, sort_keys=True) + "\n")


def card_state(state: dict, card_id: str) -> dict:
    return state.setdefault(card_id, {"box": 1, "due": today().isoformat(), "seen": 0, "lapses": 0})


def is_due(cs: dict) -> bool:
    return dt.date.fromisoformat(cs["due"]) <= today()


def look_entries(card: dict) -> list[tuple[str, str]]:
    """`look` as (path[#symbol], what you would find there).

    Distinct from `anchor`, which names the one place the fact is *defined* and is what
    drift tracks precisely. `look` is the route you would take to answer the question
    yourself: the test that pins it, the decision that argued it, the caller that shows why.
    """
    look = card.get("look") or {}
    if isinstance(look, dict):
        return [(str(k), str(v)) for k, v in look.items()]
    # A bare list is accepted so a hand-edited card with no descriptions still works.
    return [(str(x), "") for x in look]


def all_refs(card: dict) -> list[str]:
    """Every ref a card points at, anchor first, symbols stripped, qualifiers kept."""
    out = [str(card.get("anchor", "")).split("#")[0]]
    out += [pth.split("#")[0] for pth, _ in look_entries(card)]
    return [x for x in out if x]


def local_paths(card: dict, name: str) -> list[str]:
    """The refs that live in repo `name`, as repo-relative paths.

    Coverage is a question about one working tree, so a ref into another repo says nothing
    about whether this repo's changed files are carded.
    """
    out = []
    for ref in all_refs(card):
        repo, path = split_ref(ref)
        if repo is None or repo == name:
            out.append(path)
    return out


def priority_of(card: dict) -> int:
    pri = card.get("priority", DEFAULT_PRIORITY)
    return pri if pri in PRIORITY_WEIGHT else DEFAULT_PRIORITY


def card_date(card: dict, deck: dict) -> dt.date | None:
    """When this card last changed. Falls back to the deck's first generation.

    The deck is not in git, so nothing else can answer this: `added` and `updated` are
    written by the skill, and a card carrying neither is as old as the deck.
    """
    raw = card.get("updated") or card.get("added") or deck.get("generated")
    if not raw:
        return None
    try:
        return dt.date.fromisoformat(str(raw))
    except ValueError:
        return None


_CHURN_CACHE: dict[tuple[str, int], dict[str, int]] = {}


def repo_churn(root: Path, days: int = CHURN_WINDOW_DAYS) -> dict[str, int]:
    """Commits touching each path in the window. One git call per repo, cached, because a
    deck with cross-repo anchors asks for several roots in a single pass."""
    key = (str(root), days)
    if key in _CHURN_CACHE:
        return _CHURN_CACHE[key]
    out = git(root, "log", *LOG_FILES, f"--since={days} days ago", "--name-only", "--pretty=format:")
    counts: dict[str, int] = {}
    for line in out.split("\n"):
        if line := line.strip():
            counts[line] = counts.get(line, 0) + 1
    _CHURN_CACHE[key] = counts
    return counts


def churn_context(entry: dict, cards: list[dict]) -> tuple[dict[str, int], float]:
    """Churn counts plus the deck's own 90th percentile, which is what normalises them.

    Keyed by the anchor as written, because a `name::path` anchor is counted in the repo it
    names: a card about another service's contract is at risk when *that* repo moves.
    """
    root = Path(entry["root"]).expanduser()
    counts: dict[str, int] = {}
    for c in cards:
        ref = str(c.get("anchor", "")).split("#")[0]
        if not ref or ref in counts:
            continue
        other, path = resolve_ref(ref, root)
        if other is None or not other.is_dir():
            continue
        counts[ref] = repo_churn(other).get(path, 0)
    if not counts:
        return {}, 0.0
    vals = sorted(counts.get(str(c.get("anchor", "")).split("#")[0], 0) for c in cards)
    p90 = vals[int(len(vals) * 0.9)] if vals else 0
    return counts, float(p90)


def churn_boost(card: dict, counts: dict[str, int], p90: float) -> float:
    """How much this card's anchor is moving, as a 0..CHURN_WEIGHT bonus."""
    if p90 <= CHURN_FLOOR:
        return 0.0
    n = counts.get(str(card.get("anchor", "")).split("#")[0], 0)
    if n <= CHURN_FLOOR:
        return 0.0
    return CHURN_WEIGHT * min(1.0, (n - CHURN_FLOOR) / (p90 - CHURN_FLOOR))


TIER = {1: "foundational", 2: "core", 3: "detail"}


def score_parts(card: dict, deck: dict, cs: dict,
                churn: tuple[dict, float] = ({}, 0.0)) -> list[tuple[str, float, str]]:
    """(what, how much it moves the card, why) for everything that decides the queue order.

    `order_score` is the sum of these, so the panel that explains the ordering cannot drift
    away from the ordering it explains.
    """
    pri = priority_of(card)
    parts = [(f"priority {pri}", PRIORITY_WEIGHT[pri], TIER[pri])]
    when = card_date(card, deck)
    if when is not None and (age := (today() - when).days) <= RECENT_DAYS:
        parts.append((f"changed {age}d ago", -RECENT_BOOST,
                      f"new material leads for {RECENT_DAYS} days"))
    if boost := churn_boost(card, churn[0], churn[1]):
        n = churn[0].get(str(card.get("anchor", "")).split("#")[0], 0)
        parts.append((f"anchor moved {n}× in {CHURN_WINDOW_DAYS}d", -boost,
                      f"against this deck's p90 of {churn[1]:.0f}"))
    try:
        overdue = (today() - dt.date.fromisoformat(cs["due"])).days
    except (KeyError, ValueError):
        overdue = 0
    if overdue > 0:
        parts.append((f"overdue {overdue}d", -min(overdue * OVERDUE_PER_DAY, OVERDUE_CAP),
                      f"the starvation guard, capped at {OVERDUE_CAP}"))
    return parts


def order_score(card: dict, deck: dict, cs: dict, churn: tuple[dict, float] = ({}, 0.0)) -> float:
    """Lower sorts earlier. Weighted, not absolute: see JITTER and OVERDUE_PER_DAY."""
    return sum(d for _w, d, _y in score_parts(card, deck, cs, churn)) + random.random() * JITTER


def wanted_tags(args) -> set[str]:
    """--tag takes one name or a comma-separated list, matched as OR."""
    return {t.strip() for t in (args.tag or "").split(",") if t.strip()}


def compile_grep(pattern: str | None):
    """--grep is a regex, falling back to a literal search when it does not compile.

    A pattern like `plan(` is a typo in one reading and a literal in the other. Searching for
    it literally is the answer nobody has to debug.
    """
    if not pattern:
        return None
    try:
        return re.compile(pattern, re.IGNORECASE)
    except re.error:
        return re.compile(re.escape(pattern), re.IGNORECASE)


def card_matches(card: dict, tags: set[str], grep) -> bool:
    if tags and not (tags & set(card.get("tags", []))):
        return False
    if grep:
        hay = " ".join([
            card["id"], str(card.get("q", "")), str(card.get("a", "")),
            str(card.get("anchor", "")), " ".join(card.get("tags", [])),
        ])
        if not grep.search(hay):
            return False
    return True


#: Computed topics, by how far back they look. The point of these is coming back after time
#: away: what has the repo actually been doing, not what the deck last recorded.
RECENT_WINDOWS = (("last-week", 7), ("last-month", 30))

_TOUCH_CACHE: dict[tuple[str, int], dict[str, int]] = {}


def repo_touch(root: Path, days: int) -> dict[str, int]:
    """When each path was last touched by a commit in the window, as a unix timestamp.

    One `git log` for the whole repo rather than one per card. The NUL prefix marks a
    timestamp line: a filename can be all digits, and using that as the discriminator would
    silently misattribute it.
    """
    key = (str(root), days)
    if key in _TOUCH_CACHE:
        return _TOUCH_CACHE[key]
    out = git(root, "log", *LOG_FILES, f"--since={days} days ago", "--name-only", "--pretty=format:%x00%ct")
    touched: dict[str, int] = {}
    stamp = 0
    for line in out.split("\n"):
        if line.startswith("\x00"):
            stamp = int(line[1:] or 0)
        elif line.strip():
            touched[line.strip()] = max(touched.get(line.strip(), 0), stamp)
    _TOUCH_CACHE[key] = touched
    return touched


def compute_topics(root: Path, cards: list[dict]) -> dict:
    """Topics derived from the repository's own history rather than from the deck.

    Membership is "this card's anchor was touched by a commit in the window", which is what
    somebody means when they ask what has changed. Deriving it from the deck's own `added`
    and `updated` stamps only ever said when the deck was last edited, which is bookkeeping
    rather than news.
    """
    if not root.is_dir():
        return {}
    out = {}
    for name, days in RECENT_WINDOWS:
        hits = []
        for c in cards:
            other, path = resolve_ref(str(c.get("anchor", "")), root)
            if other is None or not other.is_dir():
                continue
            if ts := repo_touch(other, days).get(path, 0):
                hits.append((ts, c))
        # A window that covers the whole deck is not a filter, and a big refactor makes that
        # happen easily. It starts being useful when it narrows something.
        if not hits or len(hits) > 0.8 * len(cards):
            continue
        hits.sort(key=lambda tc: tc[0], reverse=True)
        out[name] = {
            "description": f"Anchors touched by commits in the last {days} days, newest first",
            "cards": [c["id"] for _ts, c in hits],
            "synthetic": True,
        }
    return out


def all_topics(deck: dict) -> dict:
    """Declared topics plus computed ones. A declared topic wins on a name clash.

    The computed set is attached by `load_deck`, which is the only place that knows the
    repo root, so every reader gets them without threading a path through.
    """
    return {**(deck.get("_computed") or {}), **(deck.get("topics") or {})}


def topic_cards(deck: dict, name: str) -> tuple[dict | None, list[dict], list[str]]:
    """A topic's cards in the order the topic declares, plus any ids that no longer exist.

    Order is the point: a topic is read to rebuild a mental model, and the story runs in a
    direction. Missing ids are returned rather than skipped silently, because they mean the
    topic outlived a card and the deck needs an update.
    """
    topic = all_topics(deck).get(name)
    if topic is None:
        return None, [], []
    by_id = {c["id"]: c for c in deck.get("cards") or []}
    wanted = topic.get("cards") or []
    return topic, [by_id[cid] for cid in wanted if cid in by_id], [cid for cid in wanted if cid not in by_id]


def collect(args) -> list[tuple[dict, dict, dict, dict, tuple]]:
    """Gather (entry, card, state, deck, churn) in scope. State and churn are per deck."""
    out, states = [], {}
    tags, grep = wanted_tags(args), compile_grep(args.grep)
    for entry in load_registry():
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=not args.repo)
        if loaded is None:
            continue
        deck, cards = loaded
        if args.topic:
            _topic, cards, _missing = topic_cards(deck, args.topic)
            if not cards:
                continue
        state = states.setdefault(entry["name"], load_state(entry["name"]))
        churn = churn_context(entry, cards)
        for card in cards:
            if not card_matches(card, tags, grep):
                continue
            cs = card_state(state, card["id"])
            if args.priority and priority_of(card) != args.priority:
                continue
            if args.new and cs["seen"] > 0:
                continue
            if not args.all and not args.new and not is_due(cs):
                continue
            out.append((entry, card, state, deck, churn))
    return out


# --- rendering ---------------------------------------------------------------

LIST_MARKER = re.compile(r"^(\s*)((?:\d+[.)]|[-*•])\s+)")


def wrap(text: str, width: int, indent: str = "  ", style: str = "") -> str:
    """Indent and wrap, leaving deliberate layout intact.

    A value written as a YAML literal block (`|-`) is multi-line because the author laid it
    out. Reflowing a table destroys the thing that made it readable, so a multi-line value
    is only indented, and wrapped per line if a line is genuinely too long.

    A numbered or bulleted list is the exception: its items are prose that happens to be
    numbered, so they are rejoined and refilled under a hanging indent. A table has no list
    marker, which is what keeps the two apart.
    """
    raw = str(text).rstrip()
    preformatted = "\n" in raw

    def restyle(lines: list[str]) -> str:
        """Open and close the style on every line.

        A block styled as one string keeps its escape open across the line breaks, so the
        frame's border and padding are drawn inside it and every continuation line after
        the first loses the style when the reset finally lands.
        """
        if not style:
            return "\n".join(lines)
        out = []
        for ln in lines:
            if not ln.strip():
                out.append(ln)
                continue
            lead = len(ln) - len(ln.lstrip())
            out.append(ln[:lead] + style + ln[lead:] + C["reset"])
        return "\n".join(out)

    def fill(para: str, hang: str, first: str | None = None) -> list[str]:
        out, cur = [], ""
        lead = first if first is not None else hang
        for word in para.split():
            if cur and len(cur) + len(word) + 1 + len(lead if not out else hang) > width:
                out.append((lead if not out else hang) + cur)
                cur = word
            else:
                cur = f"{cur} {word}".strip()
        if cur:
            out.append((lead if not out else hang) + cur)
        return out

    if not preformatted:
        return restyle(fill(raw, indent))

    if any(LIST_MARKER.match(ln) for ln in raw.split("\n")):
        # Regroup into items, so a wrapped item does not leave orphan fragments behind.
        items: list[tuple[str, str]] = []   # (marker prefix, text)
        for ln in raw.split("\n"):
            if m := LIST_MARKER.match(ln):
                items.append((m.group(1) + m.group(2), ln[m.end():]))
            elif items and ln.strip():
                items[-1] = (items[-1][0], items[-1][1] + " " + ln.strip())
            elif not ln.strip():
                items.append(("", ""))
        out: list[str] = []
        for prefix, body in items:
            if not prefix and not body:
                out.append("")
                continue
            out.extend(fill(body, indent + " " * len(prefix), first=indent + prefix))
        return restyle(out)

    # A block can be a table with prose under it. A line carrying an internal run of two or
    # more spaces is column alignment; consecutive prose lines are otherwise rejoined before
    # filling, so no orphan fragments are left behind.
    #
    # If the block contains ANY aligned line it is treated as a table throughout and nothing
    # is joined. A row whose first column is long enough to eat its own padding looks like
    # prose to this test, and merging a table row into a paragraph is far worse than leaving
    # a short line where a fill would have tidied it.
    def aligned(ln: str) -> bool:
        return "  " in ln.strip()

    if any(aligned(ln) for ln in raw.split("\n") if ln.strip()):
        # Emitted verbatim even when a row is wider than the terminal. Filling it would
        # collapse the padding that makes it a table, and a soft-wrapped row still carries
        # its data; a reflowed one does not.
        return restyle([indent + ln if ln.strip() else "" for ln in raw.split("\n")])

    lines, buf = [], []

    def flush() -> None:
        if buf:
            lines.extend(fill(" ".join(buf), indent))
            buf.clear()

    for para in raw.split("\n"):
        if not para.strip():
            flush()
            lines.append("")
        elif aligned(para):
            flush()
            if len(para) + len(indent) <= width:
                lines.append(indent + para)
            else:
                lead = " " * (len(para) - len(para.lstrip()))
                lines.extend(fill(para, indent + lead))
        else:
            buf.append(para.strip())
    flush()
    return restyle(lines)


# --- terminal ----------------------------------------------------------------

FULLSCREEN = sys.stdout.isatty() and sys.stdin.isatty()
# Terminals that do not understand OSC 8 print the text and drop the escape, so this is
# safe to emit blind. It is skipped when piped, where the escapes would be noise.
HYPERLINKS = sys.stdout.isatty() and os.environ.get("TERM") != "dumb"

# Bright, saturated entries from the 256-colour cube: readable on a dark terminal and
# distinguishable from each other. Near-greys are excluded, since two repos that look the
# same defeat the point.
_PALETTE = (38, 40, 42, 44, 46, 48, 50, 72, 74, 76, 78, 80, 82, 84, 86, 104, 106, 110, 112, 114, 116, 118, 120, 122, 140, 142, 147, 149, 153, 155, 157, 159, 171, 173, 175, 177, 179, 183, 185, 190)
_ASSIGNED: dict[str, str] = {}


def name_colour(name: str) -> str:
    """A stable colour per name, de-collided against the repos actually registered.

    Hashed, so a repo keeps its colour across machines and across sessions. Resolved in
    sorted order against the registry so two registered repos never share one; adding a
    repo only shifts a colour if it lands on a taken slot.
    """
    if not C["reset"]:
        return ""
    if not _ASSIGNED:
        used: set[int] = set()
        for n in sorted({r["name"] for r in load_registry()} | {name}):
            base = zlib.crc32(n.encode()) % len(_PALETTE)
            for k in range(len(_PALETTE)):
                idx = (base + k) % len(_PALETTE)
                if idx not in used:
                    used.add(idx)
                    _ASSIGNED[n] = f"\033[38;5;{_PALETTE[idx]}m"
                    break
    if name not in _ASSIGNED:
        _ASSIGNED[name] = f"\033[38;5;{_PALETTE[zlib.crc32(name.encode()) % len(_PALETTE)]}m"
    return _ASSIGNED[name]


_TOPIC_COLOURS: dict[tuple, dict[str, str]] = {}


def topic_colour(name: str, siblings: tuple[str, ...] = ()) -> str:
    """A stable colour per topic, de-collided against the other topics in its deck."""
    if not C["reset"]:
        return ""
    key = tuple(sorted(siblings)) or (name,)
    if key not in _TOPIC_COLOURS:
        used, out = set(), {}
        for t in key:
            base = zlib.crc32(("t:" + t).encode()) % len(_PALETTE)
            for k in range(len(_PALETTE)):
                idx = (base + k) % len(_PALETTE)
                if idx not in used:
                    used.add(idx)
                    out[t] = f"\033[38;5;{_PALETTE[idx]}m"
                    break
        _TOPIC_COLOURS[key] = out
    return _TOPIC_COLOURS[key].get(name, f"\033[38;5;{_PALETTE[zlib.crc32(name.encode()) % len(_PALETTE)]}m")


def sgr(code: int) -> str:
    """A 256-colour foreground escape, or nothing when colour is off."""
    return f"\033[38;5;{code}m" if C["reset"] else ""


# Rich mode: box, priority and kind each carry their own colour, so the header reads at a
# glance rather than being parsed.
BOX_COLOUR = {1: 203, 2: 215, 3: 117, 4: 114, 5: 84}
PRIORITY_COLOUR = {1: 220, 2: 109, 3: 243}
KIND_COLOUR = {"recall": 109, "cloze": 214, "locate": 117, "order": 176}


def tag_colour(tag: str) -> str:
    return sgr(_PALETTE[zlib.crc32(("#" + tag).encode()) % len(_PALETTE)])


def fit_width(lines: list[str], cols: int, *chrome: str, target: int = TARGET_WIDTH) -> int:
    """The narrowest box that holds `lines` and its chrome, within the terminal.

    Content first, terminal second: a box sized to the screen wastes the reader's eye on
    air, and one sized past the screen breaks every row.
    """
    content = max((visible_len(ln) for ln in lines), default=0) + 4
    # Chrome is set into a border row, which costs three columns more than a content row:
    # the stub dash, the space after it, and the space before the rule resumes. Sizing it
    # like content is what clipped `q quit` off the end of the key hints.
    needed = max(content, max((visible_len(c) for c in chrome), default=0) + 7)
    # The terminal is clamped last, on purpose: a box wider than the screen breaks every
    # row, so a cramped card on a 40-column terminal beats a broken one.
    return min(max(MIN_WIDTH, min(needed, target)), max(20, cols - 2))


def place(boxed: list[str], cols: int, rows: int, centre: bool = True) -> str:
    """Centre the box in the terminal, horizontally and vertically."""
    if not boxed:
        return ""
    box_w = visible_len(boxed[0])
    left = " " * max(0, (cols - box_w) // 2) if centre else ""
    top = max(0, (rows - len(boxed) - 1) // 2) if centre else 0
    return "\n" * top + "\n".join(left + ln for ln in boxed)


def frame(lines: list[str], width: int, *, head: str = "", head_right: str = "",
          foot: str = "", border: str = "", divider_at: int | None = None) -> list[str]:
    """Wrap pre-wrapped lines in a rounded box.

    Padding is computed from the *visible* width, so colour escapes and OSC 8 hyperlinks
    do not push the right edge out. A line that is still too wide is truncated rather than
    allowed to break the frame, which is the one failure that makes the whole screen wrong.
    """
    b, r = border, C["reset"] if border else ""
    inner = width - 4
    out = []

    def bar(left: str, right: str, text: str = "", text_right: str = "") -> str:
        """A border row with text set into it.

        Both labels are truncated to fit, and the right-hand one is dropped entirely before
        the bar is allowed to overflow: a header wider than the terminal breaks every row
        below it, which is far more wrong than a missing card count.
        """
        mid = width - 2                 # columns between the two corners
        min_rule = 2                    # at least one dash each side of the text
        # The stub dashes are part of the border, so they carry the border's colour. They
        # used to be built into the text and came out in the default foreground.
        tail = f" {text_right} {b}─{r}" if text_right else ""
        head = f"{b}─{r} {text} " if text else ""

        if visible_len(head) + visible_len(tail) + min_rule > mid:
            tail = ""                   # the count is the first thing to go
        if visible_len(head) + min_rule > mid:
            head = f"{b}─{r} {ansi_truncate(text, max(0, mid - min_rule - 3))}… "

        room = max(0, mid - visible_len(head) - visible_len(tail))
        return f"{b}{left}{r}{head}{b}{'─' * room}{r}{tail}{b}{right}{r}"

    out.append(bar("╭", "╮", head, head_right))
    for i, ln in enumerate(lines):
        if divider_at is not None and i == divider_at:
            out.append(f"{b}├{'─' * (width - 2)}┤{r}")
        vis = visible_len(ln)
        if vis > inner:
            ln, vis = ansi_truncate(ln, inner), inner
        out.append(f"{b}│{r} {ln}{' ' * (inner - vis)} {b}│{r}")
    out.append(bar("╰", "╯", foot))
    return out


# --- the page ----------------------------------------------------------------
#
# A card is drawn full bleed rather than boxed. A border costs four columns of text and buys
# a shape the content already has: one thing on the screen, with nothing competing for the
# eye. A margin and two rules say the same and leave the words more room. The measure is
# still capped, for the reason it always was: a line 160 columns wide is hard to read back
# to.

PAGE_MARGIN = 2


def page_layout(cols: int) -> tuple[int, int]:
    """(text width, left margin), the column centred in a wide terminal."""
    width = min(max(MIN_WIDTH, cols - 2 * PAGE_MARGIN), TARGET_WIDTH)
    return width, max(PAGE_MARGIN, (cols - width) // 2)


def spread(left: str, right: str, width: int) -> str:
    """Two labels pushed to the edges. The right one goes first if they collide."""
    room = width - visible_len(left) - visible_len(right)
    if room < 2:
        return ansi_truncate(left, width)
    return f"{left}{' ' * room}{right}"


def draw_page(head: str, head_right: str, blocks: list[str], foot: str,
              foot_right: str = "", strip: str = "") -> None:
    """One screen: a header, a rule, the content, a rule, the keys.

    Content is trimmed of its padding before anything is truncated, and centred in whatever
    is left, so a short card is not pinned to the top of a tall terminal.
    """
    cols, rows = shutil.get_terminal_size((90, 24))
    width, left = page_layout(cols)
    pad = " " * left
    rule = f"{C['dim']}{'─' * width}{C['reset']}"

    flat: list[str] = []
    for block in blocks:
        flat.extend(block.split("\n"))
    flat = [rule if ln == DIVIDER else ln for ln in flat]

    budget = max(1, rows - (5 if strip else 4))
    while len(flat) > budget and "" in flat:
        flat.remove("")
    flat = flat[:budget]
    slack = max(0, budget - len(flat))

    out = [pad + spread(head, head_right, width)]
    if strip:
        out.append(pad + strip)
    out.append(pad + rule)
    out += [""] * (slack // 2)
    # A blank line stays blank: padding it leaves trailing whitespace on every empty row,
    # which shows up the moment anybody selects text.
    out += ["" if not ln.strip() else
            pad + (ansi_truncate(ln, width) if visible_len(ln) > width else ln) for ln in flat]
    out += [""] * (slack - slack // 2)
    out.append(pad + rule)
    out.append(pad + spread(foot, foot_right, width))

    sys.stdout.write("\033[H\033[J" if FULLSCREEN else "\n")
    sys.stdout.write("\n".join(out) + "\n")
    sys.stdout.flush()


def link(text: str, root: Path, path: str) -> str:
    """`text` as an OSC 8 hyperlink to path, when the terminal can do it."""
    if not HYPERLINKS:
        return text
    other, rel = resolve_ref(path, root)
    if other is None:
        return text
    target = other / rel
    try:
        uri = target.resolve().as_uri()
    except (ValueError, OSError):
        return text
    return f"\033]8;;{uri}\033\\{text}\033]8;;\033\\"


def read_key(lower: bool = True) -> str:
    """One keypress as a name: left, right, enter, esc, or the literal character.

    `lower` is off while a line is being typed, where a capital is a capital rather than a
    command.
    """
    if not FULLSCREEN:
        try:
            got = (input() or "enter").strip()
            return got.lower() if lower else got
        except (EOFError, KeyboardInterrupt):
            return "q"
    if sys.platform == "win32":
        import msvcrt
        ch = msvcrt.getwch()
        if ch in ("\x00", "\xe0"):
            return {"K": "left", "M": "right", "H": "up", "P": "down"}.get(msvcrt.getwch(), "")
        named = {"\r": "enter", "\x1b": "esc", "\x03": "q", "\x08": "backspace", "\x7f": "backspace"}
        return named.get(ch) or (ch.lower() if lower else ch)

    import select
    import termios
    import tty
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        # os.read, not sys.stdin.read: the buffered reader pulls the whole escape sequence
        # into Python's own buffer, so the select() below sees an empty file descriptor and
        # every arrow key decodes as a bare Escape. That is what closed the picker.
        ch = os.read(fd, 1).decode("utf-8", "replace")
        if ch != "\x1b":
            named = {"\r": "enter", "\n": "enter", "\x03": "q", "\x04": "q",
                     "\x7f": "backspace", "\x08": "backspace"}
            return named.get(ch) or (ch.lower() if lower else ch)

        # A bare Escape sends nothing more, so do not block waiting for a sequence.
        if not select.select([fd], [], [], 0.05)[0]:
            return "esc"
        seq = os.read(fd, 8).decode("utf-8", "replace")
        # Modifiers arrive as ESC [ 1 ; 5 A and the like, so match on the final letter.
        final = seq[-1] if seq else ""
        if seq.startswith(("[", "O")) and final in "ABCD":
            return {"A": "up", "B": "down", "C": "right", "D": "left"}[final]
        if final == "~":
            return {"5": "pgup", "6": "pgdn", "1": "home", "4": "end",
                    "7": "home", "8": "end"}.get(seq[1:2], "esc")
        if seq.startswith(("[", "O")) and final in "HF":
            return {"H": "home", "F": "end"}[final]
        return "esc"
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)


def prompt(msg: str) -> str:
    try:
        return input(msg).strip().lower()
    except (EOFError, KeyboardInterrupt):
        return "q"


def read_line(label: str, draw=None) -> str:
    """One line of typed text, inside the alt screen when there is one.

    The session owns the screen in fullscreen mode, so `input()` cannot be used: the buffer
    is handed back to `draw` after every keypress and the caller redraws the card around it.
    Piped, it is an ordinary line read, which is what keeps a session scriptable.
    """
    if not FULLSCREEN or draw is None:
        try:
            return input(f"{label} ").strip()
        except (EOFError, KeyboardInterrupt):
            return ""
    buf = ""
    while True:
        draw(buf)
        key = read_key(lower=False)
        if key == "enter":
            return buf.strip()
        if key == "esc":
            return ""
        if key == "backspace":
            buf = buf[:-1]
        elif len(key) == 1 and key.isprintable():
            buf += key


# --- question kinds ----------------------------------------------------------
#
# A deck is more interesting to review than a flat Q/A list, and the variety is not
# decoration: asking "where would you find this" exercises a different thing from asking
# for the fact, and it is the one that makes you learn the repo rather than the answer.
#
# `kind:` on a card picks one explicitly. A plain recall card that carries routes is also
# occasionally asked as a `locate`, so the variety costs no extra authoring.

CLOZE = re.compile(r"\{\{(.+?)\}\}", re.S)
LOCATE_CHANCE = 6      # 1 in N recall cards with routes are asked as locate instead

# --- checking a typed answer -------------------------------------------------
#
# Deliberately stdlib, and deliberately lexical. `rapidfuzz` matches better and `model2vec`
# matches meaning in thirty megabytes without an LLM, and neither is reached for, because
# what is checked here is short and exact: a blanked word, a step in a sequence, a path.
#
# Prose is never checked, only measured as a hint, because similarity is not correctness on
# a card whose answer is a *why*. "The row is blank to save space" and "the row is blank
# because it is a prompt, not a snapshot" read alike to any of these, and one of them is the
# defect the card exists to prevent. Swapping in something better means changing
# `close_enough` and nothing above it.

PUNCT = re.compile(r"[^\w\s]")
CLOSE_ENOUGH = 0.85     # a typo should pass; a different word should not


def normalise(text: str) -> str:
    return " ".join(PUNCT.sub(" ", str(text)).lower().split())


def close_enough(typed: str, expected: str) -> bool:
    """Whether a typed token counts as the expected one. Typos yes, synonyms no."""
    a, b = normalise(typed), normalise(expected)
    if not a or not b:
        return False
    return a == b or difflib.SequenceMatcher(None, a, b).ratio() >= CLOSE_ENOUGH


#: Words that carry no content, so counting them would flatter every answer equally.
STOPWORDS = frozenset(
    "the a an and or but is are was were be been being it its this that these those to of in on "
    "at for from with by as not no if then than so which what when where who whom how why can "
    "could should would will shall may might must do does did done have has had you your we our "
    "they their there here into over under about".split())


def stem(word: str) -> str:
    """A crude suffix strip, so `versions` meets `versioned`.

    Not linguistics, and it does not need to be: this feeds a hint, and the alternative is a
    reader who wrote the right answer being told they matched none of it.
    """
    for suffix in ("ing", "ed", "es", "s"):
        if len(word) > 4 and word.endswith(suffix):
            return word[: -len(suffix)]
    return word


def content_words(text: str) -> set[str]:
    return {stem(w) for w in normalise(text).split() if len(w) > 2 and w not in STOPWORDS}


def word_overlap(typed: str, expected: str) -> float:
    """How much of the answer's content the reader produced. A hint, never a grade.

    Recall rather than precision: saying more than the card does is not wrong, and saying
    none of it is the thing worth noticing. It cannot tell a paraphrase from a miss, which
    is exactly why nothing is decided by it.
    """
    wanted = content_words(expected)
    if not wanted:
        return 0.0
    return len(content_words(typed) & wanted) / len(wanted)


_SHUFFLE: dict[str, list[str]] = {}


def shuffled_steps(card: dict) -> list[str]:
    """One shuffle per card per session.

    The card is redrawn on every keypress, and a sequence that reorders itself under the
    reader cannot be answered by number, or read twice.
    """
    key = str(card.get("id", ""))
    if key not in _SHUFFLE:
        steps = list(card.get("sequence") or [])
        random.shuffle(steps)
        _SHUFFLE[key] = steps
    return _SHUFFLE[key]


def kind_of(card: dict, vary: bool = True) -> str:
    kind = str(card.get("kind", "recall")).lower()
    if kind not in ("recall", "cloze", "locate", "order"):
        kind = "recall"
    if kind == "recall" and CLOZE.search(str(card.get("a", ""))):
        kind = "cloze"          # markers present, so the author meant it
    if (kind == "recall" and vary and len(look_entries(card)) >= 2
            and random.randrange(LOCATE_CHANCE) == 0):
        kind = "locate"
    return kind


def kind_label(kind: str) -> str:
    return {"recall": "recall", "cloze": "fill the blanks",
            "locate": "where would you look?", "order": "put in order"}[kind]


def render_prompt(card: dict, kind: str, width: int, root: Path) -> list[str]:
    """The lines shown before the reveal."""
    out: list[str] = []
    if kind == "locate":
        out.append(wrap("Where in the repo would you go to answer this, and what is in each place?",
                        width, style=C["bold"]))
        out.append("")
        out.append(wrap(card["q"], width, style=C["dim"]))
        return out

    out.append(wrap(card["q"], width, style=C["bold"]))

    if kind == "cloze":
        blanked = CLOZE.sub(lambda m: "▁" * max(6, min(len(m.group(1)), 18)), str(card["a"]))
        out += ["", wrap(blanked, width, style=C["cyan"])]
    elif kind == "order":
        out.append("")
        out += [f"{C['cyan']}  {n}. {step}{C['reset']}"
                for n, step in enumerate(shuffled_steps(card), 1)]
    elif look_entries(card):
        out.append("")
        out += route_lines(card, root, width)
    return out


def route_lines(card: dict, root: Path, width: int) -> list[str]:
    """One route per path, its description wrapped underneath rather than trailing it.

    A path plus a description rarely fits on one line, and truncating it loses the half
    that says why the path is worth opening.
    """
    out = []
    for pth, what in look_entries(card):
        chunks = hard_break(pth, width - 4)
        out.append(f"{C['dim']}  → {C['reset']}{link(chunks[0], root, pth)}")
        out += [f"    {link(ch, root, pth)}" for ch in chunks[1:]]
        if what:
            out.append(wrap(what, width, "    ", style=C["dim"]))
    return out


#: Which kinds can be marked without judgement. Everything else is prose, and prose is the
#: reader's own to grade.
CHECKABLE = ("cloze", "order", "locate")


def ask_for(card: dict, kind: str) -> list[str]:
    """The prompts to put to the reader, one per thing that has to be recalled."""
    if kind == "cloze":
        return [f"{n}?" for n in range(1, len(CLOZE.findall(str(card.get("a", "")))) + 1)]
    if kind == "order":
        return ["order? (numbers, e.g. 3 1 2 4)"]
    if kind == "locate":
        return ["where? (paths, separated by spaces)"]
    return ["answer?"]


def check_answer(card: dict, kind: str, typed: list[str]) -> tuple[bool, list[tuple[bool, str, str]]]:
    """(did they get it, per-part results as (ok, expected, what they said)).

    All parts or none. A partially recalled invariant is one you would act on wrongly, and
    the override is one keypress away when that is too harsh.
    """
    said = " ".join(typed)
    if kind == "cloze":
        blanks = CLOZE.findall(str(card.get("a", "")))
        parts = [(close_enough(t, b), b, t) for b, t in
                 zip(blanks, list(typed) + [""] * len(blanks))]
    elif kind == "order":
        steps = list(card.get("sequence") or [])
        shown = shuffled_steps(card)
        picked = [shown[i - 1] for i in
                  (int(tok) for tok in re.findall(r"\d+", said))
                  if 0 < i <= len(shown)]
        parts = [(n < len(picked) and picked[n] == step, step,
                  picked[n] if n < len(picked) else "") for n, step in enumerate(steps)]
    else:
        tokens = [t for t in re.split(r"[\s,]+", said) if t]
        parts = []
        for path, _what in look_entries(card):
            bare = path.split("#")[0]
            hit = any(normalise(t) in normalise(bare) or close_enough(t, bare.rsplit("/", 1)[-1])
                      for t in tokens)
            parts.append((hit, path, ""))
    return bool(parts) and all(ok for ok, _e, _s in parts), parts


def render_check(parts: list[tuple[bool, str, str]], width: int) -> list[str]:
    """What the reader typed, set against what was wanted."""
    out = []
    for ok, expected, said in parts:
        mark = f"{sgr(114)}\u2713{C['reset']}" if ok else f"{sgr(203)}\u2717{C['reset']}"
        # Wrapped at the mark's width, then the first line's indent is replaced by the mark,
        # so continuation lines stay aligned under the text rather than under the tick.
        body = wrap(expected, width, "    ")
        out.append(f"  {mark} {body[4:]}")
        if not ok and said:
            out.append(wrap(f"you said: {said}", width, "      ", style=C["dim"]))
    return out


def render_overlap(typed: str, share: float, width: int) -> list[str]:
    """What the reader wrote, and how much of the answer it covered."""
    pct = round(100 * share)
    colour = sgr(114) if pct >= 60 else sgr(179) if pct >= 30 else sgr(203)
    return [
        wrap(f"you said: {typed}", width, "    ", style=C["dim"]),
        "",
        f"  {colour}~{pct}% of the answer's words{C['reset']}",
        wrap("A hint, not a grade: it cannot tell your words from the card's. You say whether "
             "you knew it.", width, "  ", style=C["dim"]),
    ]


def render_answer(card: dict, kind: str, width: int, root: Path) -> list[str]:
    out: list[str] = []
    if kind == "locate":
        out += route_lines(card, root, width)
        out += ["", wrap("The answer itself:", width, style=C["dim"]),
                wrap(card["a"], width, style=C["cyan"])]
        return out
    if kind == "order":
        out += [f"{C['cyan']}  {n}. {step}{C['reset']}" for n, step in enumerate(card.get("sequence") or [], 1)]
        if card.get("a"):
            out += ["", wrap(card["a"], width, style=C["dim"])]
        return out

    text = CLOZE.sub(lambda m: f"{C['bold']}{m.group(1)}{C['reset']}{C['cyan']}", str(card["a"]))
    out.append(wrap(text, width, style=C["cyan"]))
    if kind != "cloze" and not look_entries(card):
        return out
    if kind == "cloze" and look_entries(card):
        out += [""] + route_lines(card, root, width)
    return out


# --- the picker --------------------------------------------------------------

def deck_summary(entry: dict) -> dict | None:
    """What the picker needs about one repo: its cards, topics and how many are due."""
    loaded = load_deck(entry, quiet=True)
    if loaded is None:
        return None
    deck, cards = loaded
    state = load_state(entry["name"])
    due = sum(1 for c in cards if (cs := state.get(c["id"])) is None or is_due(cs))
    head = git(Path(entry["root"]).expanduser(), "rev-parse", "--short", "HEAD")
    behind = bool(head and deck.get("last_update_sha") and head != deck["last_update_sha"])
    return {"entry": entry, "deck": deck, "cards": cards, "due": due, "behind": behind,
            "topics": list(all_topics(deck).keys())}


def pick_session(args) -> dict[str, set[str] | None] | None:
    """Choose repos, and optionally topics within them. None means the user backed out.

    A value of None for a repo means every card in it; a set means those topics only.
    """
    registry = load_registry()
    summaries = [(e, deck_summary(e)) for e in registry]
    decks = [d for _e, d in summaries if d]
    undecked = [e["name"] for e, d in summaries if d is None]
    if not decks:
        print("No decks yet. Run /repo-cards:generate inside a repo to make one.")
        if undecked:
            print(f"{C['dim']}Registered and waiting: {', '.join(undecked)}{C['reset']}")
        return None
    # Last session's choice, so coming back lands where you left off. Falls back to
    # whatever has work waiting, so a first run does the obvious thing on enter.
    live = {d["entry"]["name"] for d in decks}
    remembered = {k: (set(v) if v else None)
                  for k, v in (load_prefs().get("selected") or {}).items() if k in live}
    chosen: dict[str, set[str] | None] = remembered or {
        d["entry"]["name"]: None for d in decks if d["due"]}
    if not chosen:
        chosen = {decks[0]["entry"]["name"]: None}

    row, view, topic_row = 0, "repos", 0
    repo_off = topic_off = 0
    if FULLSCREEN:
        sys.stdout.write(ALT_ON)
    try:
        while True:
            if view == "repos":
                repo_off = draw_repo_picker(decks, chosen, row, repo_off, undecked)
            else:
                topic_off = draw_topic_picker(decks[row], chosen, topic_row, topic_off)
            key = read_key()

            if key in ("q", "esc"):
                if view == "topics":
                    view, key = "repos", ""
                else:
                    return None
            page = max(1, picker_height() - 1)
            if view == "repos":
                if key == "up":
                    row = (row - 1) % len(decks)
                elif key == "down":
                    row = (row + 1) % len(decks)
                elif key in ("pgup", "home", "g"):
                    row = 0 if key in ("home", "g") else max(0, row - page)
                elif key in ("pgdn", "end", "G"):
                    row = (len(decks) - 1 if key in ("end", "G")
                           else min(len(decks) - 1, row + page))
                elif key == " ":
                    name = decks[row]["entry"]["name"]
                    chosen.pop(name, None) if name in chosen else chosen.update({name: None})
                elif key == "right" and decks[row]["topics"]:
                    view, topic_row, topic_off = "topics", 0, 0
                elif key == "enter":
                    return remember(chosen)
            else:
                d = decks[row]
                opts = ["all", *d["topics"]]
                if key == "up":
                    topic_row = (topic_row - 1) % len(opts)
                elif key == "down":
                    topic_row = (topic_row + 1) % len(opts)
                elif key in ("pgup", "home", "g"):
                    topic_row = 0 if key in ("home", "g") else max(0, topic_row - page)
                elif key in ("pgdn", "end", "G"):
                    topic_row = (len(opts) - 1 if key in ("end", "G")
                                 else min(len(opts) - 1, topic_row + page))
                elif key == "left":
                    view = "repos"
                elif key == " ":
                    name = d["entry"]["name"]
                    if topic_row == 0:
                        chosen[name] = None
                    else:
                        cur = chosen.get(name) or set()
                        t = opts[topic_row]
                        cur = (cur - {t}) if t in cur else (cur | {t})
                        chosen[name] = cur or None
                elif key == "enter":
                    return remember(chosen)
    finally:
        if FULLSCREEN:
            sys.stdout.write(ALT_OFF)
            sys.stdout.flush()


def scroll_window(count: int, cursor: int, offset: int, height: int, margin: int = 1
                  ) -> tuple[int, int, int]:
    """Keep `cursor` inside a `height`-row window, moving `offset` as little as possible.

    Minimal movement rather than re-centring: a list that jumps under the cursor every
    keypress is harder to read than one that scrolls a line at a time. `margin` keeps a row
    of context visible past the cursor so you can see where you are heading.
    """
    if count <= height:
        return 0, 0, count
    offset = min(offset, count - height)
    if cursor < offset + margin:
        offset = cursor - margin
    elif cursor >= offset + height - margin:
        offset = cursor - height + 1 + margin
    offset = max(0, min(offset, count - height))
    return offset, offset, min(count, offset + height)


def remember(chosen: dict[str, set[str] | None]) -> dict | None:
    """Persist the picker's answer so the next session starts where this one did."""
    if not chosen:
        return None
    save_prefs(selected={k: sorted(v) if v else None for k, v in chosen.items()})
    return chosen


def _frame(title: str, rows_out: list[str], keys: str, accent: str = "") -> None:
    """The picker, in the same box as a card, so the two do not look like different apps."""
    cols, rows = shutil.get_terminal_size((90, 24))
    body = [""] + rows_out + [""]
    body = body[: max(1, rows - 4)]
    foot = f"{C['dim']}{keys}{C['reset']}"
    # The picker is a list of rows, not prose, so it is not held to the reading measure:
    # a truncated command hint is worse than a wide box.
    width = fit_width(body, cols, title, foot, target=PICKER_WIDTH)
    boxed = frame(body, width, head=title, foot=foot, border=f"{C['dim']}{accent}")
    sys.stdout.write("\033[H\033[J" if FULLSCREEN else "\n")
    sys.stdout.write(place(boxed, cols, rows, centre=FULLSCREEN) + "\n")
    sys.stdout.flush()


def picker_height() -> int:
    """Rows available for list items inside the frame, leaving room for the indicators."""
    _cols, rows = shutil.get_terminal_size((90, 24))
    return max(3, rows - 8)


def _indicators(out: list[str], offset: int, end: int, count: int) -> list[str]:
    above, below = offset, count - end
    head = f" {C['dim']}↑ {above} more{C['reset']}" if above else ""
    foot = f" {C['dim']}↓ {below} more{C['reset']}" if below else ""
    return ([head] if head else []) + out + ([foot] if foot else [])


def command_hints(decks, undecked) -> list[str]:
    """Name the command that fixes what the picker is showing.

    The two slash commands are the half of this tool that is not the CLI, and the picker is
    the only place they would ever be discovered.
    """
    # The command goes on its own line rather than trailing the subject: a narrow terminal
    # truncates the end of a row, and the end is the half worth reading.
    out = []
    stale = [d["entry"]["name"] for d in decks if d.get("behind")]
    if stale:
        out += [f" {C['yellow']}⟳{C['reset']} {C['dim']}{', '.join(stale[:3])} moved on{C['reset']}",
                f"   {C['bold']}/repo-cards:update{C['reset']}"]
    if undecked:
        shown = ", ".join(undecked[:3]) + (f" +{len(undecked) - 3}" if len(undecked) > 3 else "")
        out += [f"   {C['dim']}no deck: {shown}{C['reset']}",
                f"   {C['bold']}/repo-cards:generate{C['reset']}"]
    return ([""] + out) if out else []


def draw_repo_picker(decks, chosen, row, offset, undecked=()) -> int:
    height = picker_height()
    offset, start, end = scroll_window(len(decks), row, offset, height)
    out = []
    for i, d in list(enumerate(decks))[start:end]:
        name = d["entry"]["name"]
        sel = name in chosen
        cursor = f"{C['bold']}❯{C['reset']}" if i == row else " "
        box = f"{C['green']}◉{C['reset']}" if sel else f"{C['dim']}○{C['reset']}"
        scope = chosen.get(name)
        detail = (f"{C['yellow']}{', '.join(sorted(scope))}{C['reset']}" if scope
                  else f"{C['dim']}all topics{C['reset']}" if sel else "")
        due = f"{C['yellow']}{d['due']:>4} due{C['reset']}" if d["due"] else f"{C['dim']}   0 due{C['reset']}"
        more = f"{C['dim']} →{C['reset']}" if d["topics"] else "  "
        stale = f"{C['yellow']}⟳{C['reset']}" if d.get("behind") else " "
        out.append(f" {cursor} {box} {name_colour(name)}{name:<16}{C['reset']}{stale} "
                   f"{C['dim']}{len(d['cards']):>4} cards{C['reset']}  {due}{more}  {detail}")
    _frame(f"{C['bold']}Which decks?{C['reset']} "
           f"{C['dim']}{len(chosen)}/{len(decks)} selected{C['reset']}",
           _indicators(out, offset, end, len(decks)) + command_hints(decks, undecked),
           "↑/↓ move · space toggle · → topics · enter start · q cancel")
    return offset


def draw_topic_picker(d, chosen, row, offset) -> int:
    name = d["entry"]["name"]
    scope = chosen.get(name)
    opts = ["all", *d["topics"]]
    height = picker_height()
    offset, start, end = scroll_window(len(opts), row, offset, height)
    out = []
    for i, t in list(enumerate(opts))[start:end]:
        on = (scope is None) if t == "all" else bool(scope and t in scope)
        cursor = f"{C['bold']}❯{C['reset']}" if i == row else " "
        box = f"{C['green']}◉{C['reset']}" if on else f"{C['dim']}○{C['reset']}"
        if t == "all":
            label, note = f"{C['dim']}everything{C['reset']}", ""
        else:
            topic = all_topics(d["deck"])[t]
            _t, cards, _m = topic_cards(d["deck"], t)
            label = f"{topic_colour(t, tuple(d['topics']))}{t}{C['reset']}"
            note = f"{C['dim']}{len(cards):>3} cards  {topic.get('description', '')}{C['reset']}"
        out.append(f" {cursor} {box} {label:<34} {note}")
    _frame(f"{name_colour(name)}{name}{C['reset']} {C['dim']}topics{C['reset']}",
           _indicators(out, offset, end, len(opts)),
           "↑/↓ move · space toggle · ← back · enter start",
           accent=name_colour(name))
    return offset


def picked_rows(args, chosen: dict[str, set[str] | None]) -> list[tuple]:
    """Build the queue from a picker selection, honouring the same due/priority rules."""
    rows, states = [], {}
    tags, grep = wanted_tags(args), compile_grep(args.grep)
    for entry in load_registry():
        name = entry["name"]
        if name not in chosen:
            continue
        loaded = load_deck(entry, quiet=True)
        if loaded is None:
            continue
        deck, cards = loaded
        if topics := chosen[name]:
            wanted, seen = [], set()
            for t in sorted(topics):
                for c in topic_cards(deck, t)[1]:
                    if c["id"] not in seen:
                        seen.add(c["id"])
                        wanted.append(c)
            cards = wanted
        state = states.setdefault(name, load_state(name))
        churn = churn_context(entry, cards)
        for card in cards:
            if not card_matches(card, tags, grep):
                continue
            cs = card_state(state, card["id"])
            if not args.all and not is_due(cs):
                continue
            rows.append((entry, card, state, deck, churn))
    rows.sort(key=lambda r: order_score(r[1], r[3], card_state(r[2], r[1]["id"]), r[4]))
    return rows[: args.limit] if args.limit else rows


# --- review ------------------------------------------------------------------

ALT_ON, ALT_OFF = "\033[?1049h\033[?25l", "\033[?1049l\033[?25h"


#: Marks where the rule between question and answer goes. A sentinel rather than an index,
#: because the height trim rewrites the list underneath it.
DIVIDER = "\x00rule\x00"


def session_rows(args) -> list[tuple]:
    """The queue, ordered. One place so the picker and the flags share it."""
    queue = collect(args)
    queue.sort(key=lambda row: order_score(row[1], row[3], card_state(row[2], row[1]["id"]), row[4]))
    return queue[: args.limit] if args.limit else queue


def topics_of(card: dict, deck: dict) -> list[str]:
    """Topics this card belongs to, declared ones first so the badge is the curated name."""
    declared = [n for n, t in (deck.get("topics") or {}).items()
                if card["id"] in (t.get("cards") or [])]
    computed = [n for n, t in (deck.get("_computed") or {}).items()
                if card["id"] in (t.get("cards") or [])]
    return declared + computed


def cmd_review(args) -> int:
    # The picker is the default when nothing narrows the session and there is a terminal to
    # draw it on. Any explicit scope means the caller has already chosen.
    scoped = any([args.repo, args.tag, args.topic, args.grep, args.priority, args.new])
    if FULLSCREEN and not scoped and not args.no_pick:
        chosen = pick_session(args)
        if chosen is None:
            return 0
        queue = picked_rows(args, chosen)
        if not queue:
            print(f"{C['green']}Nothing due in that selection.{C['reset']}"
                  f" {C['dim']}--all to cram.{C['reset']}")
            return 0
        return run_session(queue, args.mode)

    queue = session_rows(args)
    if not queue:
        if not load_registry():
            print("No repos registered. Add one with: repo-cards register /path/to/repo")
            return 0
        scope = f" tagged {args.tag}" if args.tag else ""
        print(f"{C['green']}Nothing due{scope}.{C['reset']} {C['dim']}--all to cram, --new for unseen.{C['reset']}")
        return 0
    return run_session(queue, args.mode)


def run_session(queue: list[tuple], mode: str = "test") -> int:
    """One pass over the queue, navigable. Grades are held until the session ends.

    Two modes, because reading and being tested are different activities and doing both in
    one screen means doing neither well. **learn** shows everything at once and grades
    nothing: it is for building the picture, or meeting what an update just changed.
    **test** hides the answer until you have had a go, and is the only one that moves a
    card's box. `l` switches mid-session, because realising you do not know an area is
    exactly when you want to stop testing and start reading.
    """
    roots = {e["name"]: Path(e["root"]).expanduser() for e, *_ in queue}
    kinds = {c["id"]: kind_of(c) for _, c, *_ in queue}
    _SHUFFLE.clear()
    revealed: set[int] = set()
    graded: dict[int, str] = {}
    dirty: dict[str, dict] = {}
    checked: dict[int, list] = {}
    tabs: dict[int, int] = {}
    i = 0

    save_prefs(mode=mode)
    if FULLSCREEN:
        sys.stdout.write(ALT_ON)
    try:
        while True:
            entry, card, state, deck, _churn = queue[i]
            cs = card_state(state, card["id"])
            kind = kinds[card["id"]]

            def redraw(typing=None):
                draw_card(queue, i, kind, roots[entry["name"]], cs,
                          mode == "learn" or i in revealed, graded.get(i), mode,
                          typing, checked.get(i), tabs.get(i, 0), graded)

            redraw()
            key = read_key()

            if key in ("q", "esc"):
                break
            if key == "f":
                # Not a grade. "I could not answer this" and "this card is no longer true"
                # are different facts, and only the second one is worth an update's time.
                if cs.pop("flagged", None) is None:
                    cs["flagged"] = today().isoformat()
                    # Raised first, asked about second: an abandoned prompt must not lose the
                    # flag, which is the part that matters.
                    note = read_line("why?", lambda buf: redraw(("why?", buf)))
                    if note:
                        cs["flag_note"] = note
                else:
                    cs.pop("flag_note", None)
                dirty[entry["name"]] = state
            elif key == "l":
                mode = "learn" if mode == "test" else "test"
                save_prefs(mode=mode)
            elif key in ("up", "down") and (mode == "learn" or i in revealed):
                # Cards move on the horizontal, a card's own faces on the vertical.
                n = len(card_tabs(card, entry, kind))
                tabs[i] = (tabs.get(i, 0) + (1 if key == "down" else -1)) % n
            elif key == "left":
                i = max(0, i - 1)
            elif key == "right":
                if i + 1 >= len(queue):
                    break
                i += 1
            elif key == "enter":
                if mode == "learn" or i in revealed:
                    if i + 1 >= len(queue):
                        break
                    i += 1
                else:
                    revealed.add(i)
            elif key == "e":
                if not edit_card_note(entry["name"], card["id"]):
                    line = read_line("note:", lambda buf: redraw(("note:", buf)))
                    if line:
                        append_card_note(entry["name"], card["id"], line)
            elif key == "t" and mode == "test" and i not in revealed:
                typed = [read_line(label, lambda buf, lbl=label: redraw((lbl, buf)))
                         for label in ask_for(card, kind)]
                revealed.add(i)
                if kind in CHECKABLE:
                    # Short and exact, so the mark is a fact rather than an opinion, and it
                    # is a grade like any other: y or n puts it right.
                    ok, parts = check_answer(card, kind, typed)
                    checked[i] = {"parts": parts}
                    graded[i] = "y" if ok else "n"
                else:
                    # Prose. Measured and shown, never graded: no string comparison can tell
                    # a right answer in your own words from a wrong one in the card's.
                    said = " ".join(typed)
                    checked[i] = {"typed": said, "overlap": word_overlap(said, str(card.get("a", "")))}
            elif key in ("y", "n") and mode == "test":
                revealed.add(i)
                graded[i] = key
                if i + 1 >= len(queue):
                    break
                i += 1
    finally:
        if FULLSCREEN:
            sys.stdout.write(ALT_OFF)
            sys.stdout.flush()

    return finish_session(queue, graded, dirty)


def one_line(text: str, width: int) -> str:
    """Prose flattened to a single line, cut with an ellipsis rather than mid-word."""
    flat = " ".join(str(text).split())
    if len(flat) <= width:
        return flat
    return flat[: max(0, width - 1)].rstrip() + "…"


#: Faces of a revealed card. Everything the card knows gets a whole screen instead of a
#: share of one, which is what makes room for material the old layout had nowhere to put.
def card_tabs(card: dict, entry: dict, kind: str) -> list[str]:
    tabs = ["answer"]
    if look_entries(card) and kind != "locate":
        tabs.append("routes")
    if read_card_note(entry["name"], card["id"]):
        tabs.append("note")
    return tabs + ["why", "question"]


def render_tab_row(tabs: list[str], active: int, width: int) -> str:
    out = []
    for n, name in enumerate(tabs):
        out.append(f"{sgr(109)}{C['bold']}{name}{C['reset']}" if n == active
                   else f"{C['dim']}{name}{C['reset']}")
    return "  " + f" {C['dim']}│{C['reset']} ".join(out)


def render_why(card: dict, deck: dict, cs: dict, churn: tuple[dict, float], width: int) -> list[str]:
    """Why this card is in front of you, in the scheduler's own numbers.

    None of this was ever shown, and all of it was already computed. An order nobody can see
    the reasons for is one people work around rather than trust.
    """
    parts = score_parts(card, deck, cs, churn)
    out = [f"  {C['dim']}queue score · lower sorts earlier{C['reset']}", ""]
    for what, delta, why in parts:
        out.append(f"  {what:<28}{sgr(114) if delta < 0 else C['dim']}{delta:>+6.2f}{C['reset']}  "
                   f"{C['dim']}{why}{C['reset']}")
    total = sum(d for _w, d, _y in parts)
    out += [f"  {'':<28}{C['dim']}{'─' * 6}{C['reset']}",
            f"  {'':<28}{C['bold']}{total:>+6.2f}{C['reset']}",
            wrap(f"plus jitter up to {JITTER}, so a lower-priority card wins some days and "
                 f"you are not drilling the same fifteen in the same order forever.",
                 width, "  ", style=C["dim"]), ""]

    seen, lapses = cs.get("seen", 0), cs.get("lapses", 0)
    line = f"seen {seen}×"
    if lapses:
        line += f" · missed {lapses}×"
        if lapses >= STICKY_LAPSES:
            line += ", which drift lists as a card to rewrite"
    if last := cs.get("last_seen"):
        line += f" · last seen {last}"
    out.append(wrap(line, width, "  ", style=C["dim"]))
    if history := cs.get("history"):
        marks = " ".join(f"{sgr(114)}✓{C['reset']}" if g == "y" else f"{sgr(203)}✗{C['reset']}"
                         for g in history[-16:])
        out.append(f"  {marks}")
    if stamp := card.get("verified"):
        out.append(f"  {C['dim']}verified against {stamp}{C['reset']}")
    return out


def queue_strip(queue, i: int, graded: dict, width: int) -> str:
    """The whole session in one row: what you got, what you missed, what is left.

    A count says 4/22 and nothing else. This says you have missed three of the last five,
    which is the thing worth knowing before you keep going. Long queues show a window around
    where you are rather than shrinking the pips to nothing.
    """
    room = max(10, width - 6)
    start = 0
    if len(queue) > room:
        start = min(max(0, i - room // 2), len(queue) - room)
    end = min(len(queue), start + room)

    pips = []
    for n in range(start, end):
        _e, card, state, _d, _c = queue[n]
        if n == i:
            pips.append(f"{C['bold']}◉{C['reset']}")
        elif (g := graded.get(n)) is not None:
            pips.append(f"{sgr(114) if g == 'y' else sgr(203)}●{C['reset']}")
        elif state.get(card["id"], {}).get("flagged"):
            pips.append(f"{sgr(179)}●{C['reset']}")
        else:
            pips.append(f"{C['dim']}○{C['reset']}")
    lead = f"{C['dim']}‹{C['reset']}" if start else ""
    tail = f"{C['dim']}›{C['reset']}" if end < len(queue) else ""
    return "  " + lead + "".join(pips) + tail


def key_hint(key: str, label: str, colour: int) -> str:
    return f"{sgr(colour)}{key}{C['reset']} {C['dim']}{label}{C['reset']}"


def card_keys(kind: str, cs: dict, revealed: bool, mode: str) -> str:
    """Only the keys that do something here. The rest live behind `?`."""
    nav = key_hint("←/→", "move", 117)
    flag = key_hint("f", "unflag" if cs.get("flagged") else "flag", 179)
    helps = key_hint("?", "keys", 245)
    if mode == "learn":
        parts = [nav, key_hint("l", "test", 214), flag, key_hint("e", "note", 109), helps]
    elif not revealed:
        parts = [nav, key_hint("enter", "flip", 109), key_hint("t", "type", 79), flag, helps]
    else:
        parts = [nav, key_hint("↑/↓", "tabs", 109), key_hint("y", "got it", 114),
                 key_hint("n", "missed", 203), key_hint("e", "note", 109), helps]
    return f" {C['dim']}·{C['reset']} ".join(parts)


def card_state_mark(cs: dict, grade: str | None) -> str:
    """What the reader has already done to this card, at the far end of the key row."""
    out = {"y": f"{sgr(114)}✓ got it{C['reset']}",
           "n": f"{sgr(203)}✗ missed{C['reset']}"}.get(grade, "")
    if cs.get("flagged"):
        out = (out + "  " if out else "") + f"{sgr(179)}⚑{C['reset']}"
    return out


def draw_card(queue, i, kind, root, cs, revealed, grade, mode="test", typing=None,
              checked=None, tab=0, graded=None) -> None:
    entry, card, _state, _deck, _churn = queue[i]
    cols, _rows = shutil.get_terminal_size((90, 24))
    width, _left = page_layout(cols)
    text_width = width - 2

    repo = entry["name"]
    pri = priority_of(card)
    siblings = tuple(all_topics(_deck).keys())
    topics = topics_of(card, _deck)

    shown_kind = "learn" if mode == "learn" else kind_label(kind)
    kind_col = sgr(214 if mode == "learn" else KIND_COLOUR[kind])
    head = (f"{name_colour(repo)}{repo}{C['reset']} {C['dim']}·{C['reset']} "
            f"{kind_col}{shown_kind}{C['reset']}")
    head_right = (f"{C['dim']}{i + 1}/{len(queue)}{C['reset']}  "
                  f"{sgr(BOX_COLOUR[cs['box']])}box {cs['box']}{C['reset']}  "
                  f"{sgr(PRIORITY_COLOUR[pri])}{'★' * (4 - pri)}{C['reset']}")

    # The two faces. A card is a card: the question and its answer are never on screen
    # together, which is what buys the room. Measured against the real decks, showing both
    # needs 23 rows in a 21-row budget, and the routes alone are six of them.
    body: list[str] = []
    if not revealed:
        if topics:
            body.append("  " + "  ".join(
                f"{topic_colour(t, siblings)}▌{t}{C['reset']}" for t in topics[:3]))
            body.append("")
        body += render_prompt(card, kind, text_width, root)
    else:
        # One dim line of what was asked. You grade yourself against the question, so it
        # cannot leave the screen, but it has done its work and the answer needs the space.
        tabs = card_tabs(card, entry, kind)
        active = tabs[tab % len(tabs)]
        body += [f"  {C['dim']}{one_line(card.get('q', ''), text_width - 2)}{C['reset']}", "",
                 render_tab_row(tabs, tab % len(tabs), text_width), ""]

        if active == "answer":
            if checked and checked.get("parts") is not None:
                body += render_check(checked["parts"], text_width)
                body += [f"  {C['dim']}marked from what you typed · y or n overrides{C['reset']}", ""]
            elif checked:
                body += render_overlap(checked["typed"], checked["overlap"], text_width) + [""]
            body += render_answer(card, kind, text_width, root) + [""]
            anchor = str(card.get("anchor", "-"))
            body += [f"  {C['dim']}⚓{C['reset']}  {link(anchor, root, anchor)}"]
        elif active == "routes":
            body += route_lines(card, root, text_width)
        elif active == "note":
            body += [wrap(ln, text_width, "  ", style=C["dim"])
                     for ln in read_card_note(entry["name"], card["id"]).split("\n")]
            body += ["", f"  {C['dim']}{card_note_path(entry['name'], card['id'])}{C['reset']}"]
        elif active == "why":
            body += render_why(card, _deck, cs, _churn, text_width)
        else:
            body += [wrap(str(card.get("q", "")), text_width, "  ", style=C["bold"])]
    if typing is not None:
        label, buf = typing
        body += ["", f"  {sgr(179)}{label}{C['reset']} {buf}\u2588"]

    draw_page(head, head_right, body,
              card_keys(kind, cs, revealed, mode), card_state_mark(cs, grade),
              strip=queue_strip(queue, i, graded or {}, text_width) if len(queue) > 1 else "")


# SGR colour codes and OSC 8 hyperlink wrappers both occupy no columns.
_INVISIBLE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b\]8;;[^\x1b]*\x1b\\")


def visible_len(text: str) -> int:
    return len(_INVISIBLE.sub("", text))


def ansi_truncate(text: str, limit: int) -> str:
    """Cut to `limit` visible columns without severing an escape sequence.

    Slicing by character index is wrong once a hyperlink wraps the text, because the
    escapes are no longer all at the front: the cut lands inside one and the terminal
    swallows the rest of the line.
    """
    out, vis, i = [], 0, 0
    while i < len(text) and vis < limit:
        if text[i] == "\x1b" and (mt := _INVISIBLE.match(text, i)):
            out.append(mt.group())
            i = mt.end()
            continue
        out.append(text[i])
        vis += 1
        i += 1
    return "".join(out) + C["reset"]


def hard_break(text: str, width: int) -> list[str]:
    """Split a token with no spaces in it, so a long path cannot burst the frame."""
    return [text[i:i + width] for i in range(0, len(text), width)] or [""]


def finish_session(queue, graded: dict[int, str], dirty: dict[str, dict] | None = None) -> int:
    # A deck with a flag raised but nothing graded still has to be written out.
    touched: dict[str, dict] = dict(dirty or {})
    right = wrong = 0
    for i, grade in graded.items():
        entry, card, state, _deck, _churn = queue[i]
        touched[entry["name"]] = state
        cs = card_state(state, card["id"])
        cs["seen"] += 1
        cs["last_seen"] = today().isoformat()
        # The only record of how this card has actually gone. Capped, because it is a shape
        # to glance at rather than an audit trail.
        cs["history"] = (cs.get("history", "") + grade)[-HISTORY_LEN:]
        if grade == "y":
            right += 1
            cs["box"] = min(cs["box"] + 1, MAX_BOX)
        else:
            wrong += 1
            cs["lapses"] += 1
            cs["box"] = 1   # a fact you have lost is not most of the way to known
        cs["due"] = (today() + dt.timedelta(days=INTERVALS[cs["box"]])).isoformat()
    for name, state in touched.items():
        save_state(name, state)

    flagged = {cid for _n, st in touched.items() for cid, cs in st.items() if cs.get("flagged")}
    total = right + wrong
    if not total and not flagged:
        print(f"{C['dim']}Nothing graded, nothing rescheduled.{C['reset']}")
        return 0
    if total:
        print(f"{C['bold']}{right} right, {wrong} missed{C['reset']}  {C['dim']}({round(100 * right / total)}%)"
              f" of {len(queue)} shown{C['reset']}")
        if wrong:
            print(f"{C['dim']}Missed cards are back in box 1 and due tomorrow.{C['reset']}")
    if flagged:
        print(f"{sgr(179)}⚑{C['reset']} {len(flagged)} card(s) flagged as suspect. "
              f"{C['dim']}They are the first thing{C['reset']} /repo-cards:update"
              f"{C['dim']} looks at, and repo-cards flags lists them.{C['reset']}")
    stale = sorted({e["name"] for e, *_ in queue
                    if (d := deck_summary(e)) and d.get("behind")})
    if stale:
        print(f"{C['yellow']}⟳{C['reset']} {', '.join(stale)} moved since the deck was written. "
              f"{C['dim']}Run{C['reset']} /repo-cards:update")
    return 0


# --- stats, list -------------------------------------------------------------

def cmd_stats(args) -> int:
    repos = load_registry()
    if not repos:
        print("No repos registered. Add one with: repo-cards register /path/to/repo")
        return 0
    for entry in repos:
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=not args.repo)
        if loaded is None:
            continue
        deck, cards = loaded
        state = load_state(entry["name"])
        boxes = dict.fromkeys(range(1, MAX_BOX + 1), 0)
        due = unseen = 0
        for card in cards:
            cs = state.get(card["id"])
            if cs is None:
                unseen += 1
                due += 1
                boxes[1] += 1
                continue
            boxes[cs["box"]] += 1
            if is_due(cs):
                due += 1
        bar = "  ".join(f"{'▁▃▅▆█'[b - 1]} box{b} {C['dim']}{boxes[b]}{C['reset']}" for b in range(1, MAX_BOX + 1))
        head = git(Path(entry["root"]).expanduser(), "rev-parse", "--short", "HEAD")
        sha = deck.get("last_update_sha", "?")
        stale = (f"  {C['yellow']}⟳ repo at {head} · /repo-cards:update{C['reset']}"
                 if head and sha != "?" and head != sha else "")
        print(f"\n{C['bold']}{entry['name']}{C['reset']}  "
              f"{C['dim']}{len(cards)} cards, {sha}{C['reset']}{stale}")
        print(f"  {C['yellow']}{due} due{C['reset']}, {unseen} never seen")
        print(f"  {bar}")
        pri = collections.Counter(priority_of(c) for c in cards)
        routed = sum(1 for c in cards if look_entries(c))
        recent = sum(1 for c in cards if (d := card_date(c, deck)) and (today() - d).days <= RECENT_DAYS)
        print(f"  {C['dim']}★★★ {pri[1]} foundational · ★★ {pri[2]} core · ★ {pri[3]} detail"
              f"{f' · {recent} changed in the last {RECENT_DAYS}d' if recent else ''}{C['reset']}")
        print(f"  {C['dim']}{routed}/{len(cards)} carry a `look` route{C['reset']}")
        counts, p90 = churn_context(entry, cards)
        hot = sorted(((churn_boost(c, counts, p90), c) for c in cards), key=lambda kv: -kv[0])[:3]
        if hot and hot[0][0] > 0:
            names = ", ".join(c["id"] for b, c in hot if b > 0)
            print(f"  {C['dim']}anchors moving most ({CHURN_WINDOW_DAYS}d): {names}{C['reset']}")
        lapsed = sorted(((c, s["lapses"]) for c, s in state.items() if s.get("lapses", 0) >= 2), key=lambda kv: -kv[1])[:5]
        if lapsed:
            print(f"  {C['dim']}stickiest: {', '.join(f'{c} (x{n})' for c, n in lapsed)}{C['reset']}")
    print()
    return 0


def cmd_list(args) -> int:
    for entry in load_registry():
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=not args.repo)
        if loaded is None:
            continue
        _deck, cards = loaded
        state = load_state(entry["name"])
        tags, grep = wanted_tags(args), compile_grep(args.grep)
        for card in sorted(cards, key=priority_of):
            if not card_matches(card, tags, grep):
                continue
            if args.priority and priority_of(card) != args.priority:
                continue
            cs = state.get(card["id"], {"box": 1, "due": "never"})
            flag = f"{C['yellow']}due{C['reset']}" if cs["due"] == "never" or is_due(cs) else f"{C['dim']}{cs['due']}{C['reset']}"
            star = ("★" * (4 - priority_of(card))).ljust(3)
            print(f"  {star} {C['dim']}box{cs['box']}{C['reset']} {flag:>22}  {card['id']:<38} {C['dim']}{','.join(card.get('tags', []))}{C['reset']}")
    return 0


# --- drift: the mechanical half of `update` ----------------------------------

def since_arg(date: str) -> str:
    """A date pinned to midnight, for `git log --since`.

    Git's approxidate reads a bare `2026-09-17` as that date at the *current time of day*,
    not as midnight, so a deck written this morning silently misses this morning's commits.
    """
    return f"{date} 00:00:00"


_SHA_DATE: dict[tuple[str, str], str] = {}


def sha_date(root: Path, sha: str) -> str:
    """A commit's date as YYYY-MM-DD, or "" if this repo has never heard of it.

    Empty is the answer that matters: a `verified` stamp naming a commit that no longer
    exists, after a rebase or a force push, must fall back to the deck's baseline rather
    than silently clear the card.
    """
    key = (str(root), sha)
    if key not in _SHA_DATE:
        _SHA_DATE[key] = git(root, "show", "-s", "--format=%cs", f"{sha}^{{commit}}")
    return _SHA_DATE[key]


_CHANGED: dict[tuple[str, str], set[str]] = {}


def changed_between(root: Path, base: str) -> set[str]:
    """Files changed between a commit and HEAD. Cached: a deck has few distinct baselines
    however many cards it carries."""
    key = (str(root), base)
    if key not in _CHANGED:
        _CHANGED[key] = {x for x in git(root, "diff", "--name-only", f"{base}..HEAD").split("\n") if x}
    return _CHANGED[key]


_CHANGED_SINCE: dict[tuple[str, str], set[str]] = {}


def changed_since_date(root: Path, since: str) -> set[str]:
    """Files touched in `root` since a date.

    Another repo has no commit in common with this deck's baseline sha, so the date the deck
    was last updated is the only baseline the two share. Coarser than a sha range, and the
    right kind of coarse: it over-reports rather than missing a change.
    """
    key = (str(root), since)
    if key not in _CHANGED_SINCE:
        out = git(root, "log", *LOG_FILES, f"--since={since_arg(since)}", "--name-only", "--format=")
        _CHANGED_SINCE[key] = {ln.strip() for ln in out.split("\n") if ln.strip()}
    return _CHANGED_SINCE[key]


def git(root: Path, *args: str) -> str:
    try:
        return subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True, check=True).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return ""


def drift_facts(entry: dict) -> dict:
    """Everything drift knows about one repo, before deciding how much of it to print."""
    root = Path(entry["root"]).expanduser()
    f = {"name": entry["name"], "root": root, "sha": None, "cards": [], "head": "", "log": "",
         "changed": [], "hot": [], "cold": [], "routes": [], "dead": [], "uncovered": [],
         "unknown_repo": [], "flagged": [], "sticky": [], "verified_skip": 0,
         "status": "", "regen": False}

    def note_dead() -> None:
        """Paths a card points at that are not in the repo any more.

        Worth checking whatever the deck's sha says: a path can be wrong from the day it was
        written, and a route that 404s teaches the reader nothing. A `name::path` ref is
        checked against the repo it names, and one naming an unregistered repo is its own
        kind of broken.
        """
        for c in f["cards"]:
            for ref in all_refs(c):
                other, path = resolve_ref(ref, root)
                if other is None:
                    f["unknown_repo"].append((c["id"], ref))
                elif not (other / path).exists():
                    f["dead"].append((c["id"], ref))

    loaded = load_deck(entry, quiet=True)
    if loaded is None:
        # Registered but never generated. A normal state, and the one the summary most needs
        # to surface: it is the list of repos still waiting on /repo-cards:generate.
        f["status"] = "no deck"
        return f
    deck, cards = loaded
    f["cards"] = cards
    f["sha"] = deck.get("last_update_sha")
    sha = f["sha"]

    # Raised by hand during review, so it holds whatever the shas say: the reader met the
    # card and did not believe it. git cannot produce this signal and neither can the deck.
    state = load_state(entry["name"])
    f["flagged"] = [(c, state[c["id"]]["flagged"], state[c["id"]].get("flag_note", ""))
                    for c in cards if state.get(c["id"], {}).get("flagged")]
    # The other half of the signal review generates. A card nobody can hold on to is a
    # defect in the writing, and until now that was visible in `stats` and acted on by
    # nobody: an update that only ever answers to git never fixes a badly written card.
    f["sticky"] = sorted(((c, state[c["id"]]["lapses"]) for c in cards
                          if state.get(c["id"], {}).get("lapses", 0) >= STICKY_LAPSES),
                         key=lambda cl: -cl[1])

    if not root.is_dir():
        f["status"] = "root missing"
        return f
    note_dead()
    f["head"] = git(root, "rev-parse", "--short", "HEAD")
    if not sha or not f["head"]:
        f["status"] = "no baseline"
        return f
    if sha == f["head"]:
        # Not an early return any more: a card anchored into another repo can be stale while
        # nothing here has moved at all, and that is exactly the case a sha comparison misses.
        f["status"] = "up to date"
    else:
        f["status"] = "behind"
        f["log"] = git(root, "log", "--oneline", f"{sha}..HEAD")
        f["changed"] = [x for x in git(root, "diff", "--name-only", f"{sha}..HEAD").split("\n") if x]

    # An anchor carrying #symbol is narrowed further: one commit to a 700-line module
    # should not flag every card drawn from it, or the update drowns in false positives.
    changed_set, diff_cache = set(f["changed"]), {}
    deck_since = str(deck.get("last_update_date") or "")

    def baseline(card: dict) -> str:
        """What this card was last checked against.

        A card verified during a later pass has a narrower window than the deck's own, which
        is the whole point: without it, a card anchored on a file that moves every week comes
        up in every single update, and an update that cries wolf stops being run.
        """
        stamp = str(card.get("verified") or "")
        return stamp if stamp and sha_date(root, stamp) else sha

    def foreign_changed(repo: str, since: str) -> set[str] | None:
        """What has moved in another registered repo since this card was checked."""
        other = registry_roots().get(repo)
        if other is None or not other.is_dir() or not since:
            return None
        return changed_since_date(other, since)

    for c in cards:
        repo, rest = split_ref(str(c.get("anchor", "")))
        path, _, symbol = rest.partition("#")
        if not path:
            continue
        base = baseline(c)
        local = repo is None or repo == f["name"]
        if local:
            changed = changed_between(root, base) if base != sha else changed_set
        else:
            # A sha here means nothing in another repo, so the date it landed is the
            # baseline. Coarser, and coarse in the safe direction.
            since = sha_date(root, base) if base != sha else deck_since
            if (changed := foreign_changed(repo, since or deck_since)) is None:
                continue
        if not (path in changed or any(x.startswith(path.rstrip("/") + "/") for x in changed)):
            if local and base != sha and path in changed_set:
                f["verified_skip"] += 1
            continue
        if not symbol:
            f["hot"].append(c)
            continue
        if (repo, path, base) not in diff_cache:
            if local:
                patch = git(root, "diff", "-U5", f"{base}..HEAD", "--", path)
            else:
                patch = git(registry_roots()[repo], "log", *LOG_FILES,
                            f"--since={since_arg(since or deck_since)}",
                            "--format=", "-U5", "-p", "--", path)
            diff_cache[(repo, path, base)] = patch
        # Hunk headers carry the enclosing function name, so a symbol absent from the
        # whole diff was very likely not touched.
        if symbol in diff_cache[(repo, path, base)]:
            f["hot"].append(c)
        else:
            f["cold"].append(c)
            if local and base != sha and path in changed_set:
                f["verified_skip"] += 1

    hot_ids = {c["id"] for c in f["hot"]}
    for c in cards:
        if c["id"] in hot_ids:
            continue
        base = baseline(c)
        touched = []
        for pth, _ in look_entries(c):
            repo, rest = split_ref(pth)
            path = rest.split("#")[0]
            if repo is None or repo == f["name"]:
                hit = path in (changed_between(root, base) if base != sha else changed_set)
            else:
                hit = path in (foreign_changed(repo, sha_date(root, base) if base != sha
                                               else deck_since) or set())
            if hit:
                touched.append(pth)
        if touched:
            f["routes"].append((c, touched))

    behind_n = len(f["log"].splitlines())
    dead_frac = len({cid for cid, _ in f["dead"]}) / max(1, len(cards))
    f["regen"] = behind_n > REGEN_COMMITS or dead_frac > REGEN_DEAD_FRACTION

    covered = {pth for c in cards for pth in local_paths(c, f["name"])}
    f["uncovered"] = [x for x in f["changed"] if x not in covered]
    if f["status"] == "up to date" and f["hot"]:
        f["status"] = "linked moved"
    return f


def print_drift_detail(f: dict) -> None:
    print(f"\n{C['bold']}=== {f['name']} ==={C['reset']}")
    print(f"root: {f['root']}")
    print(f"deck: {deck_path(f['name'])}")
    if f["status"] == "no deck":
        print(f"{C['yellow']}no deck yet. Generate one with /repo-cards:generate{C['reset']}")
        return
    print(f"deck generated at: {f['sha'] or '(unrecorded)'}")
    if f["status"] == "root missing":
        print(f"{C['red']}root does not exist on this machine; re-register it{C['reset']}")
        return
    print(f"HEAD now: {f['head'] or '(not a git repo)'}")
    if f["status"] == "no baseline":
        print("no baseline to diff against; treat every card as unverified")
        return
    if f["status"] == "up to date":
        print(f"{C['green']}up to date, no commits since the deck was generated{C['reset']}")
    elif f["status"] == "linked moved":
        print(f"{C['yellow']}no commits here since the deck was written, but a repo these cards "
              f"point into has moved{C['reset']}")
    else:
        print(f"\n--- commits since {f['sha']} ({len(f['log'].splitlines())}) ---\n{f['log']}")
        print(f"\n--- files changed ({len(f['changed'])}) ---")
        print("\n".join(f"  {x}" for x in f["changed"]) or "  (none)")
        if f.get("regen"):
            print(f"\n{C['yellow']}Drifted far enough that a regenerate is likely cheaper than "
                  f"verifying this card by card.{C['reset']}")
    if f["flagged"]:
        print(f"\n--- cards you flagged during review ({len(f['flagged'])}) : VERIFY THESE FIRST ---")
        for c, when, note in f["flagged"]:
            print(f"  {c['id']:<40} flagged {when}  {c.get('anchor', '')}")
            if note:
                # The reader's own words about what is wrong, which is the whole reason the
                # flag beats a diff: it says what to look for, not just where.
                print(f"  {'':<40} \"{note}\"")
    if f["sticky"]:
        print(f"\n--- cards missed {STICKY_LAPSES}+ times ({len(f['sticky'])}) : REWRITE THESE ---")
        for c, n in f["sticky"]:
            print(f"  {c['id']:<40} missed x{n}  {c.get('anchor', '')}")
        print("  usually two facts under one id, or a question that is recognisable rather "
              "than answerable")
    if f["hot"] or f["status"] == "behind":
        print(f"\n--- cards whose anchor changed ({len(f['hot'])}) : VERIFY THESE ---")
        print("\n".join(f"  {c['id']:<40} {c['anchor']}" for c in f["hot"]) or "  (none)")
    if f["verified_skip"]:
        print(f"\n  {C['dim']}{f['verified_skip']} card(s) not listed: their anchor moved, but "
              f"they carry a `verified` sha from after that commit.{C['reset']}")
    if f["cold"]:
        print(f"\n--- file changed but the anchored symbol was not touched ({len(f['cold'])}) : likely fine ---")
        print("\n".join(f"  {c['id']:<40} {c['anchor']}" for c in f["cold"]))
    if f["routes"]:
        print(f"\n--- cards whose `look` route changed ({len(f['routes'])}) : directions may be stale ---")
        for c, touched in f["routes"]:
            print(f"  {c['id']:<40} {', '.join(touched)}")
    if f["dead"]:
        print(f"\n--- paths that no longer exist ({len(f['dead'])}) : FIX THESE ---")
        for cid, pth in f["dead"]:
            print(f"  {cid:<40} {pth}")
    if f["unknown_repo"]:
        print(f"\n--- refs naming an unregistered repo ({len(f['unknown_repo'])}) : register it or fix the ref ---")
        for cid, pth in f["unknown_repo"]:
            print(f"  {cid:<40} {pth}")
    if f["status"] == "behind":
        print(f"\n--- changed files no card points at ({len(f['uncovered'])}) : CANDIDATES ---")
        print("\n".join(f"  {x}" for x in f["uncovered"]) or "  (none)")


def cmd_drift(args) -> int:
    """What changed since each deck was generated, and which cards that touches.

    Deliberately mechanical: it says what to look at, and the skill decides what a card
    should now say. Written to be read by Claude as well as by a person.

    One repo prints in full. Every repo prints a summary instead, because eight repos of
    detail is not a triage, and the point of a sweep is deciding where to spend the effort.
    """
    entries = [e for e in load_registry() if not args.repo or e["name"] == args.repo]
    if not entries:
        print("No repos registered. Add one with: repo-cards register /path/to/repo")
        return 0

    facts = [drift_facts(e) for e in entries]
    if args.repo or args.full or len(facts) == 1:
        for f in facts:
            print_drift_detail(f)
        print()
        return 0

    behind = [f for f in facts if f["status"] == "behind"]
    linked = [f for f in facts if f["status"] == "linked moved"]
    ungenerated = [f for f in facts if f["status"] == "no deck"]
    rank = {"behind": 0, "linked moved": 1, "no deck": 2, "root missing": 3,
            "no baseline": 4, "up to date": 5}
    colours = {"behind": C["yellow"], "linked moved": C["yellow"], "up to date": C["green"],
               "no deck": C["dim"]}

    print(f"\n  {'repo':<20} {'commits':>8} {'verify':>7} {'flagged':>8} {'routes':>7} "
          f"{'dead':>5} {'new files':>10}   state")
    for f in sorted(facts, key=lambda x: (rank.get(x["status"], 9), -len(x["hot"]))):
        colour = colours.get(f["status"], C["red"])
        dead = f"{C['red']}{len(f['dead'])}{C['reset']}" if f["dead"] else "-"
        if f["status"] in ("behind", "linked moved"):
            n = len(f["log"].splitlines())
            cols = (str(n) if n else "-", str(len(f["hot"])), str(len(f["routes"])), str(len(f["uncovered"])))
        else:
            cols = ("-", "-", "-", "-")
        flags = f"{sgr(179)}{len(f['flagged'])}{C['reset']}" if f["flagged"] else "-"
        print(f"  {f['name']:<20} {cols[0]:>8} {cols[1]:>7} {flags:>8} {cols[2]:>7} "
              f"{dead:>5} {cols[3]:>10}   {colour}{f['status']}{C['reset']}")

    print()
    regen = [f for f in facts if f.get("regen")]
    if behind:
        print(f"  {len(behind)} deck(s) behind. Detail: repo-cards drift --repo <name>   (--full for all)")
    if regen:
        names = ", ".join(f["name"] for f in regen)
        print(f"  {C['yellow']}{names}: far enough behind that a regenerate beats an update"
              f"{C['reset']}\n  {C['dim']}Ask Claude for{C['reset']} /repo-cards:generate")
    if linked:
        names = ", ".join(f["name"] for f in linked)
        print(f"  {names}: no commits here, but a linked repo moved under some cards")
    if ungenerated:
        print(f"  {len(ungenerated)} repo(s) registered with no deck: {', '.join(f['name'] for f in ungenerated)}")
        print(f"  {C['dim']}Generate one by running /repo-cards:generate from inside it.{C['reset']}")
    flagged = [f for f in facts if f["flagged"]]
    if flagged:
        n = sum(len(f["flagged"]) for f in flagged)
        print(f"  {sgr(179)}{n} card(s) flagged during review{C['reset']} in "
              f"{', '.join(f['name'] for f in flagged)}. {C['dim']}Detail: repo-cards flags{C['reset']}")
    sticky = [f for f in facts if f["sticky"]]
    if sticky:
        n = sum(len(f["sticky"]) for f in sticky)
        print(f"  {n} card(s) missed {STICKY_LAPSES}+ times in {', '.join(f['name'] for f in sticky)}. "
              f"{C['dim']}Worth rewriting: repo-cards drift --repo <name>{C['reset']}")
    if not behind and not linked and not ungenerated and not flagged and not sticky:
        print(f"  {C['green']}Every deck is current.{C['reset']}")
    print()
    return 0


# --- check: the deck's own rules, enforced rather than described -------------
#
# Everything here was already written down in the skill as instructions to follow while
# writing a deck. Instructions followed by a model are followed unevenly, and the failures
# are quiet: a route that 404s, a question that can be answered yes or no, an anchor with no
# symbol that drags every card on that file into every update. Checking them costs
# milliseconds and turns "please be careful" into "the deck is wrong, here is where".

YESNO = re.compile(r"^(is|are|was|were|does|do|did|can|could|should|shall|will|would|has|have|had)\b", re.I)
SENTENCE_END = re.compile(r"[.!?](?:\s|$)")
KEBAB = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
#: An anchor into prose names the whole document, and rightly: a decision record has no
#: symbols to name, so demanding one would teach the writer to invent them.
PROSE = (".md", ".rst", ".txt", ".adoc")
MAX_SENTENCES = 4


def check_deck(entry: dict, deck: dict, cards: list[dict]) -> list[tuple[str, str, str]]:
    """(level, scope, message) for everything mechanically wrong with one deck.

    Errors are things that are broken: a route nobody can follow, an id two cards share, a
    topic pointing at a card that is gone. Warnings are the deck's own bar, which is a matter
    of judgement and so is reported rather than enforced.
    """
    out: list[tuple[str, str, str]] = []
    root = Path(entry["root"]).expanduser()
    err = lambda scope, msg: out.append(("error", scope, msg))
    warn = lambda scope, msg: out.append(("warn", scope, msg))

    for field in ("last_update_sha", "last_update_date"):
        if not deck.get(field):
            warn("deck", f"no `{field}`, so drift has no baseline to measure from")

    seen: dict[str, int] = {}
    for n, card in enumerate(cards, 1):
        cid = str(card.get("id") or "")
        scope = cid or f"card #{n}"
        if not cid:
            err(scope, "no `id`, so it can never hold a review box")
        elif cid in seen:
            err(scope, f"duplicate id, first used by card #{seen[cid]}. One of them owns the state")
        else:
            seen[cid] = n
        if cid and not KEBAB.match(cid):
            warn(scope, "id is not a kebab-case slug, which is what state.json keys on")

        q, a = str(card.get("q") or "").strip(), str(card.get("a") or "").strip()
        if not q:
            err(scope, "no `q`")
        if not a:
            err(scope, "no `a`")
        if not card.get("tags"):
            err(scope, "no `tags`, so --tag can never reach it")
        if card.get("priority") is not None and card["priority"] not in PRIORITY_WEIGHT:
            err(scope, f"priority {card['priority']!r} is not 1, 2 or 3")

        if q and YESNO.match(q):
            warn(scope, f"question can be answered yes or no, so it tests recognition: {q[:60]!r}")
        if a and len(SENTENCE_END.findall(a)) > MAX_SENTENCES:
            warn(scope, f"answer runs to more than {MAX_SENTENCES} sentences, so it is two cards or a document")

        kind = str(card.get("kind") or "recall").lower()
        if kind not in ("recall", "cloze", "locate", "order"):
            err(scope, f"unknown kind {kind!r}")
        if kind == "cloze" and not CLOZE.search(a):
            err(scope, "kind is cloze but the answer marks no {{blanks}}")
        if kind == "order" and len(card.get("sequence") or []) < 2:
            err(scope, "kind is order but there is no `sequence` of at least two steps")
        if kind == "locate" and len(look_entries(card)) < 2:
            err(scope, "kind is locate but the routes, which are the answer, are thin")

        anchor = str(card.get("anchor") or "")
        if not anchor:
            err(scope, "no `anchor`, so drift and churn cannot see it at all")
        elif "#" not in anchor and not anchor.lower().endswith(PROSE):
            warn(scope, f"anchor names no #symbol, so any commit to {anchor} flags this card")

        routes = look_entries(card)
        if len(routes) < 2:
            warn(scope, "fewer than two `look` routes, so there is no route to follow, only a location")
        dirs = {(p.split("#")[0].rsplit("/", 1)[0] if "/" in p.split("#")[0] else "") for p, _ in routes}
        if len(routes) >= 2 and len(dirs) == 1:
            warn(scope, "every route is in one directory; a decision, an implementation and a test teach more")
        for path, what in routes:
            if not what:
                warn(scope, f"route {path} says where but not what is there")

        for ref in all_refs(card):
            other, rel = resolve_ref(ref, root)
            if other is None:
                err(scope, f"names a repo that is not registered: {ref}")
            elif not (other / rel).exists():
                err(scope, f"path does not exist: {ref}")

        stamp = str(card.get("verified") or "")
        if stamp and root.is_dir() and not sha_date(root, stamp):
            warn(scope, f"`verified: {stamp}` names no commit in this repo, so it is being ignored")

    for name, topic in (deck.get("topics") or {}).items():
        wanted = topic.get("cards") or []
        if not wanted:
            warn(f"topic {name}", "no cards")
        for cid in wanted:
            if cid not in seen:
                err(f"topic {name}", f"names a card that is not in the deck: {cid}")
        if not topic.get("description"):
            warn(f"topic {name}", "no description, so the picker and `topics` show a blank line")
        if notes := topic.get("notes"):
            if not (deck_dir(entry["name"]) / notes).exists():
                err(f"topic {name}", f"notes file does not exist: {notes}")
    return out


#: How alike two ids have to be before a rename is worth suggesting. Low enough to catch
#: `plan-five-states` -> `plan-has-five-states`, high enough not to pair unrelated cards.
RENAME_RATIO = 0.6


def orphan_state(deck_cards: list[dict], state: dict) -> list[tuple[str, dict, str, float]]:
    """State entries with no card, each with the closest card id that has no state of its own.

    The skill tells you to regenerate a deck once it has drifted far enough, and promises that
    a card keeping its id keeps its box. Nothing checked that the ids were kept. A model
    rewording an id while rewriting a deck silently resets that card's history, and an
    orphaned entry is documented as ignored, so the loss is invisible at exactly the moment
    it is most likely. This is what makes a regenerate safe to recommend.
    """
    ids = {str(c.get("id") or "") for c in deck_cards}
    unclaimed = sorted(ids - set(state))
    out = []
    for cid, cs in state.items():
        if cid in ids:
            continue
        match, ratio = "", 0.0
        for cand in unclaimed:
            r = difflib.SequenceMatcher(None, cid, cand).ratio()
            if r > ratio:
                match, ratio = cand, r
        out.append((cid, cs, match if ratio >= RENAME_RATIO else "", ratio))
    return sorted(out, key=lambda o: (-o[1].get("box", 1), o[0]))


def cmd_adopt(args) -> int:
    """Hand one card's review history to another id, after a rename.

    The only supported way to edit state.json, and it exists because the skill forbids
    editing that file by hand: it is the one file in the deck directory that cannot be
    regenerated from anything.
    """
    pairs = [p.split("=", 1) for p in str(args.path or "").split(",") if "=" in p]
    if not args.repo or not pairs:
        print(f"{C['red']}usage: repo-cards adopt --repo NAME old-id=new-id[,old=new]{C['reset']}")
        return 1
    entry = next((e for e in load_registry() if e["name"] == args.repo), None)
    if entry is None:
        print(f"{C['red']}{args.repo} is not registered{C['reset']}")
        return 1
    loaded = load_deck(entry)
    if loaded is None:
        return 1
    _deck, cards = loaded
    ids = {str(c.get("id") or "") for c in cards}
    state = load_state(args.repo)

    moved = 0
    for old, new in [(a.strip(), b.strip()) for a, b in pairs]:
        if old not in state:
            print(f"{C['yellow']}{old}: no state to move{C['reset']}")
        elif new not in ids:
            print(f"{C['red']}{new}: no such card in {args.repo}{C['reset']}")
        elif new in state:
            print(f"{C['red']}{new}: already has its own history, which this would overwrite{C['reset']}")
        else:
            state[new] = state.pop(old)
            carried = ""
            if (src := card_note_path(args.repo, old)).exists():
                dest = card_note_path(args.repo, new)
                dest.parent.mkdir(parents=True, exist_ok=True)
                src.replace(dest)
                carried = ", note carried"
            print(f"{C['green']}{old} -> {new}{C['reset']}  "
                  f"{C['dim']}box {state[new].get('box', 1)} kept{carried}{C['reset']}")
            moved += 1
    if moved:
        save_state(args.repo, state)
    return 0 if moved else 1


def cmd_check(args) -> int:
    """Validate decks against the rules the skill describes. Exit 1 if anything is broken."""
    errors = warnings = decks = 0
    for entry in load_registry():
        if args.repo and entry["name"] != args.repo:
            continue
        if not deck_path(entry["name"]).exists():
            if args.repo:
                print(f"{C['yellow']}no deck for {entry['name']}{C['reset']}")
            continue
        loaded = load_deck(entry, quiet=True)
        if loaded is None:
            print(f"{C['red']}{entry['name']}: deck does not parse{C['reset']}")
            errors += 1
            continue
        deck, cards = loaded
        decks += 1
        found = check_deck(entry, deck, cards)
        orphans = orphan_state(cards, load_state(entry["name"]))
        errors += sum(1 for lvl, _, _ in found if lvl == "error")
        warnings += sum(1 for lvl, _, _ in found if lvl == "warn") + len(orphans)
        head = f"{C['bold']}{entry['name']}{C['reset']}  {C['dim']}{len(cards)} cards{C['reset']}"
        if not found and not orphans:
            print(f"\n{head}  {C['green']}clean{C['reset']}")
            continue
        print(f"\n{head}")
        for level, scope, msg in found:
            if level == "warn" and args.errors_only:
                continue
            tag = f"{C['red']}error{C['reset']}" if level == "error" else f"{C['yellow']}warn {C['reset']}"
            print(f"  {tag}  {scope:<38} {msg}")

        if orphans and not args.errors_only:
            kept = sum(1 for _c, cs, _m, _r in orphans if cs.get("box", 1) > 1)
            print(f"\n  {C['yellow']}{len(orphans)} state entr(ies) with no card{C['reset']}"
                  f"{C['dim']}, {kept} of them past box 1. A retired card is fine here; a renamed "
                  f"one has lost its history.{C['reset']}")
            for cid, cs, match, ratio in orphans:
                seen = f"box {cs.get('box', 1)}, seen {cs.get('seen', 0)}x"
                if match:
                    print(f"  {C['yellow']}warn {C['reset']}  {cid:<38} {seen}, and no card claims it. "
                          f"Renamed to {C['bold']}{match}{C['reset']}? ({ratio:.0%} alike)")
                else:
                    print(f"  {C['yellow']}warn {C['reset']}  {cid:<38} {seen}, and nothing in the deck looks like it")
            if any(m for _c, _s, m, _r in orphans):
                moves = ",".join(f"{cid}={match}" for cid, _cs, match, _r in orphans if match)
                print(f"  {C['dim']}Restore them with: repo-cards adopt --repo {entry['name']} {moves}{C['reset']}")

    if not decks and not errors:
        print("No decks to check. Generate one with /repo-cards:generate")
        return 0
    print(f"\n{errors} error(s), {warnings} warning(s) across {decks} deck(s)\n")
    return 1 if errors or (warnings and args.strict) else 0


# --- catchup: what moved while you were away ---------------------------------

def commits_since(root: Path, since: str) -> list[tuple[str, int, str, set[str]]]:
    """(sha, timestamp, subject, files) for each commit in the window, newest first.

    One call per repo. NUL separates commits and unit separator splits the header, because
    a commit subject can contain anything and a filename can look like a header line.
    """
    out = git(root, "log", *LOG_FILES, f"--since={since_arg(since)}", "--name-only",
              "--format=%x00%h%x1f%ct%x1f%s")
    commits = []
    for chunk in out.split("\x00"):
        if not chunk.strip():
            continue
        head, *rest = chunk.split("\n")
        sha, _, tail = head.partition("\x1f")
        stamp, _, subject = tail.partition("\x1f")
        files = {ln.strip() for ln in rest if ln.strip()}
        commits.append((sha, int(stamp or 0), subject, files))
    return commits


def cmd_catchup(args) -> int:
    """What has moved since you last *reviewed* a deck, against the cards you already hold.

    The baseline is the last review, not the last update, because they answer different
    questions. `drift` asks what the deck owes the repo, which is work for an update pass.
    This asks what the repo did while you were on something else, which is the question you
    actually have at nine o'clock on the morning you come back. It writes no state and needs
    no model, so it costs a second rather than a session.
    """
    width = min(shutil.get_terminal_size((90, 24)).columns, 96)
    cap = None if args.repo else 8
    moved = 0

    for entry in load_registry():
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=not args.repo)
        if loaded is None:
            continue
        deck, cards = loaded
        root = Path(entry["root"]).expanduser()
        if not root.is_dir():
            continue

        state = load_state(entry["name"])
        seen = [cs["last_seen"] for cs in state.values() if cs.get("last_seen")]
        last = max(seen) if seen else ""
        since = args.since or last or str(deck.get("last_update_date") or "")
        if not since:
            print(f"{C['yellow']}{entry['name']}: never reviewed and no deck date to work from."
                  f"{C['reset']} {C['dim']}Try --since 2026-01-01{C['reset']}")
            continue

        log: dict[str, list] = {}

        def commits_for(r: Path) -> list:
            return log.setdefault(str(r), commits_since(r, since))

        hits = []
        for c in cards:
            other, path = resolve_ref(str(c.get("anchor", "")), root)
            if other is None or not other.is_dir():
                continue
            touching = [cm for cm in commits_for(other) if path in cm[3]]
            if touching:
                hits.append((max(cm[1] for cm in touching), c, touching))
        hits.sort(key=lambda h: -h[0])

        own = commits_for(root)
        covered = {p for c in cards for p in local_paths(c, entry["name"])}
        loose = [cm for cm in own if not (cm[3] & covered)]
        ago = (today() - dt.date.fromisoformat(since)).days if not args.since else None
        when = f"last reviewed {since}" if last and not args.since else f"since {since}"
        when += f", {ago} day(s) ago" if ago is not None else ""
        if not own and not hits:
            if args.repo:
                print(f"\n{C['bold']}{entry['name']}{C['reset']}  {C['dim']}{when}{C['reset']}  "
                      f"{C['green']}nothing has moved{C['reset']}")
            continue

        moved += 1
        print(f"\n{name_colour(entry['name'])}{C['bold']}{entry['name']}{C['reset']}  {C['dim']}{when}{C['reset']}")
        print(f"{C['dim']}{len(own)} commit(s) here, {len(hits)} card(s) sitting on what they touched{C['reset']}")

        for _ts, c, touching in hits[:cap]:
            print(f"\n  {C['yellow']}⟳{C['reset']} {C['bold']}{c['id']}{C['reset']}  "
                  f"{C['dim']}{c.get('anchor', '')}{C['reset']}")
            print(wrap(str(c.get("q", "")), width, "     "))
            if args.full:
                print(f"{C['cyan']}{wrap(str(c.get('a', '')), width, '     ')}{C['reset']}")
            for sha, _t, subject, _f in touching[:4]:
                print(f"     {C['dim']}{sha}{C['reset']}  {subject}")
            if len(touching) > 4:
                print(f"     {C['dim']}+{len(touching) - 4} more{C['reset']}")
        if cap and len(hits) > cap:
            print(f"\n  {C['dim']}+{len(hits) - cap} more card(s): repo-cards catchup --repo {entry['name']}{C['reset']}")

        if loose:
            print(f"\n  {C['dim']}{len(loose)} commit(s) touching nothing carded:{C['reset']}")
            for sha, _t, subject, _f in loose[:5]:
                print(f"     {C['dim']}{sha}  {subject}{C['reset']}")
            if len(loose) > 5:
                print(f"     {C['dim']}+{len(loose) - 5} more{C['reset']}")

    if not moved:
        print(f"{C['green']}Nothing has moved since you last reviewed.{C['reset']}")
        return 0
    print(f"\n{C['dim']}Read the moving parts: repo-cards brief --topic last-week"
          f"  ·  drill them: repo-cards --topic last-week --all{C['reset']}\n")
    return 0


# --- brief: read up on one area, without touching the schedule ---------------

def cmd_topics(args) -> int:
    """List the curated topics each deck defines."""
    found = False
    for entry in load_registry():
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=not args.repo)
        if loaded is None:
            continue
        deck, _cards = loaded
        topics = all_topics(deck)
        if not topics:
            print(f"\n{C['bold']}{entry['name']}{C['reset']}  {C['dim']}no topics defined{C['reset']}")
            continue
        found = True
        print(f"\n{C['bold']}{entry['name']}{C['reset']}")
        for name, topic in topics.items():
            _t, cards, missing = topic_cards(deck, name)
            warn = f"  {C['yellow']}({len(missing)} card(s) no longer in the deck){C['reset']}" if missing else ""
            print(f"  {C['cyan']}{name:<22}{C['reset']} {len(cards):>3} cards  {C['dim']}{topic.get('description', '')}{C['reset']}{warn}")
    if found:
        print(f"\n{C['dim']}Read one with: repo-cards brief --topic <name>{C['reset']}")
    print()
    return 0


def cmd_brief(args) -> int:
    """Read an area end to end, question and answer together, in order.

    Deliberately not a review: it writes no state. Cramming before a meeting is a different
    mental mode from recall practice, and letting it reschedule cards you already know would
    corrupt the one signal the boxes carry. Order is the deck's or the topic's, never
    shuffled, because this is for rebuilding a mental model rather than testing it.
    """
    if not (args.topic or args.tag or args.grep):
        print(f"{C['dim']}Pick an area: --topic NAME, --tag a,b or --grep PATTERN.{C['reset']}\n")
        return cmd_topics(args)

    width = min(shutil.get_terminal_size((90, 24)).columns, 96)
    tags, grep = wanted_tags(args), compile_grep(args.grep)
    shown = 0

    for entry in load_registry():
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=not args.repo)
        if loaded is None:
            continue
        deck, cards = loaded
        heading, missing = "", []

        if args.topic:
            topic, cards, missing = topic_cards(deck, args.topic)
            if topic is None:
                continue
            heading = topic.get("description", "")
            notes = topic.get("notes")
        else:
            notes = None
        cards = [c for c in cards if card_matches(c, tags, grep)]
        if not cards:
            continue

        label = f"{entry['name']} · {args.topic}" if args.topic else entry["name"]
        print(f"\n{C['bold']}{label}{C['reset']}")
        if heading:
            print(f"{C['dim']}{heading}{C['reset']}")
        line = f"{len(cards)} card(s)"
        if notes:
            note_path = deck_dir(entry["name"]) / notes
            line += f" · notes: {note_path}" + ("" if note_path.exists() else f"  {C['yellow']}(missing){C['reset']}")
        print(f"{C['dim']}{line}{C['reset']}")
        if missing:
            print(f"{C['yellow']}{len(missing)} card(s) in this topic are no longer in the deck: {', '.join(missing)}{C['reset']}")
        print()

        for n, card in enumerate(cards, 1):
            # Wrapped at the answer's indent, then the first line's indent is replaced by the
            # number, so continuation lines stay aligned under it instead of hitting column 0.
            q = wrap(card["q"], width, "     ")
            print(f"{C['bold']}{n:>3}. {q[5:]}{C['reset']}")
            for pth, what in look_entries(card) or [(card.get("anchor", "-"), "")]:
                print(f"{C['dim']}     ↳ {pth}{('  ' + what) if what else ''}{C['reset']}")
            print(f"{C['cyan']}{wrap(card['a'], width, '     ')}{C['reset']}")
            if note := read_card_note(entry["name"], card["id"]):
                print(f"{sgr(109)}{wrap(note, width, '     ')}{C['reset']}")
            print()
            shown += 1

    if not shown:
        scope = args.topic or args.tag or args.grep
        print(f"{C['yellow']}Nothing matched {scope!r}.{C['reset']} {C['dim']}Try: repo-cards topics{C['reset']}")
        return 1
    print(f"{C['dim']}{shown} card(s). Nothing was rescheduled.{C['reset']}\n")
    return 0


def cmd_flags(args) -> int:
    """Cards flagged as suspect during review, and the way to clear them.

    Clearing lives here rather than in the skill because state.json is the one file an
    update must never hand-edit: a flag sits beside the review box, and a careless rewrite
    of that file costs every card's history.
    """
    width = min(shutil.get_terminal_size((90, 24)).columns, 96)
    total = cleared = 0
    for entry in load_registry():
        if args.repo and entry["name"] != args.repo:
            continue
        loaded = load_deck(entry, quiet=True)
        if loaded is None:
            continue
        _deck, cards = loaded
        state = load_state(entry["name"])
        rows = [c for c in cards if state.get(c["id"], {}).get("flagged")
                and (not args.path or c["id"] == args.path)]
        if not rows:
            continue
        if args.clear:
            for c in rows:
                state[c["id"]].pop("flagged", None)
                cleared += 1
            save_state(entry["name"], state)
            continue
        print(f"\n{C['bold']}{entry['name']}{C['reset']}")
        for c in rows:
            cs = state[c["id"]]
            print(f"  {sgr(179)}⚑{C['reset']} {c['id']:<38} {C['dim']}flagged {cs['flagged']} · "
                  f"box {cs.get('box', 1)} · {c.get('anchor', '')}{C['reset']}")
            if note := cs.get("flag_note"):
                print(wrap(f"\u201c{note}\u201d", width, "      ", style=sgr(179)))
            print(wrap(str(c.get("q", "")), width, "      ", style=C["dim"]))
        total += len(rows)

    if args.clear:
        print(f"{C['green']}cleared {cleared} flag(s){C['reset']}" if cleared
              else f"{C['dim']}nothing to clear{C['reset']}")
        return 0
    if not total:
        print(f"{C['green']}No cards flagged.{C['reset']} "
              f"{C['dim']}Press f on a card you do not believe during review.{C['reset']}")
        return 0
    print(f"\n{C['dim']}{total} flagged. Ask Claude for{C['reset']} /repo-cards:update"
          f"{C['dim']}, then: repo-cards flags --clear{C['reset']}\n")
    return 0


# --- export and import -------------------------------------------------------
#
# A deck is content and nothing else: no paths, no schedule, no machine. The only thing
# keeping it on one laptop was that nothing wrote it anywhere else. Handing one over is the
# difference between a personal habit and the thing a team gives somebody on their first
# day, and it costs nothing, because the split that makes regeneration safe makes the
# content portable for the same reason.

def cmd_export(args) -> int:
    """Write a deck out, verbatim. Stdout by default, so it pipes."""
    if not args.repo:
        print(f"{C['red']}usage: repo-cards export --repo NAME [--out PATH]{C['reset']}")
        return 1
    src = deck_path(args.repo)
    if not src.exists():
        print(f"{C['red']}no deck for {args.repo} at {src}{C['reset']}")
        return 1
    # The file rather than a re-dump of the parsed deck: the section comments and the field
    # order are how a deck is read by a person, and yaml.dump would throw both away.
    text = src.read_text()
    notes = deck_dir(args.repo) / "notes"
    has_notes = notes.is_dir() and any(notes.iterdir())

    if not args.out:
        sys.stdout.write(text)
        if has_notes:
            print(f"{C['dim']}# this deck has notes/; use --out DIR to carry them too{C['reset']}",
                  file=sys.stderr)
        return 0

    out = Path(args.out).expanduser()
    if out.suffix in (".yaml", ".yml"):
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(text)
        carried = 0
    else:
        out.mkdir(parents=True, exist_ok=True)
        (out / "deck.yaml").write_text(text)
        carried = 0
        if has_notes:
            shutil.copytree(notes, out / "notes", dirs_exist_ok=True)
            carried = sum(1 for _ in (out / "notes").rglob("*") if _.is_file())
    print(f"{C['green']}exported {args.repo}{C['reset']} -> {out}"
          + (f"  {C['dim']}({carried} note file(s)){C['reset']}" if carried else ""))

    deck = yaml.safe_load(text) or {}
    foreign = sorted({split_ref(r)[0] for c in (deck.get("cards") or []) for r in all_refs(c)
                      if split_ref(r)[0] and split_ref(r)[0] != args.repo})
    if foreign:
        print(f"{C['yellow']}! cards point into {', '.join(foreign)}{C['reset']} {C['dim']}"
              f"— whoever imports this needs those registered under the same names.{C['reset']}")
    return 0


def cmd_import(args) -> int:
    """Install a deck somebody else wrote, without touching this machine's review history."""
    if not args.path:
        print(f"{C['red']}usage: repo-cards import PATH [--name NAME] [--force]{C['reset']}")
        return 1
    src = Path(args.path).expanduser()
    if src.is_dir():
        src = src / "deck.yaml"
    if not src.exists():
        print(f"{C['red']}no deck at {src}{C['reset']}")
        return 1
    try:
        deck = yaml.safe_load(src.read_text()) or {}
    except yaml.YAMLError as err:
        print(f"{C['red']}does not parse: {err}{C['reset']}")
        return 1

    name = args.name or str(deck.get("repo") or "") or src.parent.name
    entry = next((e for e in load_registry() if e["name"] == name), None)
    if entry is None:
        print(f"{C['red']}{name} is not registered on this machine{C['reset']}")
        print(f"{C['dim']}A deck needs a working tree to measure drift against. Register it first:"
              f"\n  repo-cards register /path/to/{name}{C['reset']}")
        return 1

    target = deck_path(name)
    if target.exists() and not args.force:
        print(f"{C['red']}{name} already has a deck at {target}{C['reset']}")
        print(f"{C['dim']}--force replaces it. Review progress survives either way: it is keyed "
              f"by card id in a different file.{C['reset']}")
        return 1

    cards = deck.get("cards") or []
    state = load_state(name)
    ids = {str(c.get("id") or "") for c in cards}
    kept = sorted(ids & set(state))
    orphaned = sorted(set(state) - ids)

    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(src.read_text())
    notes = src.parent / "notes"
    if notes.is_dir():
        shutil.copytree(notes, deck_dir(name) / "notes", dirs_exist_ok=True)

    print(f"{C['green']}imported {len(cards)} card(s) as {name}{C['reset']} -> {target}")
    if kept:
        print(f"  {len(kept)} card(s) matched review history you already had, and keep their box")
    if orphaned:
        print(f"  {C['yellow']}{len(orphaned)} state entr(ies) no longer match a card{C['reset']}"
              f"  {C['dim']}repo-cards check --repo {name}{C['reset']}")
    problems = [x for x in check_deck(entry, deck, cards) if x[0] == "error"]
    if problems:
        print(f"  {C['yellow']}{len(problems)} error(s) against this checkout{C['reset']}"
              f"  {C['dim']}repo-cards check --repo {name}{C['reset']}")
    return 0


# --- registry management -----------------------------------------------------

def cmd_register(args) -> int:
    if not args.path:
        print(f"{C['red']}usage: repo-cards register /path/to/repo [--name NAME]{C['reset']}")
        return 1
    root = Path(args.path).expanduser().resolve()
    if not root.is_dir():
        print(f"{C['red']}no such directory: {root}{C['reset']}")
        return 1
    name = args.name or root.name
    repos = [r for r in load_registry() if r["name"] != name]
    repos.append({"name": name, "root": str(root)})
    repos.sort(key=lambda r: r["name"])
    save_registry(repos)
    (deck_dir(name) / "notes").mkdir(parents=True, exist_ok=True)
    print(f"{C['green']}registered {name}{C['reset']}\n  root: {root}\n  deck: {deck_path(name)}")
    if not deck_path(name).exists():
        print(f"{C['yellow']}  no deck yet: ask Claude to \"generate repo cards\" in that repo{C['reset']}")
    return 0


def cmd_forget(args) -> int:
    if not args.path:
        print(f"{C['red']}usage: repo-cards forget NAME{C['reset']}")
        return 1
    name = args.path
    repos = load_registry()
    if not any(r["name"] == name for r in repos):
        print(f"{C['yellow']}{name} is not registered{C['reset']}")
        return 1
    save_registry([r for r in repos if r["name"] != name])
    print(f"{C['green']}unregistered {name}{C['reset']}")
    print(f"{C['dim']}Its deck and progress are kept at {deck_dir(name)}; delete that by hand if you meant to.{C['reset']}")
    return 0


def cmd_repos(args) -> int:
    repos = load_registry()
    if not repos:
        print("No repos registered. Add one with: repo-cards register /path/to/repo")
        return 0
    for r in repos:
        has_deck = deck_path(r["name"]).exists()
        has_root = Path(r["root"]).expanduser().is_dir()
        status = f"{C['green']}ok{C['reset']}" if has_deck and has_root else (
            f"{C['red']}no deck{C['reset']}" if not has_deck else f"{C['red']}root missing{C['reset']}")
        print(f"  {r['name']:<20} {status:<20} {r['root']}")
    return 0


def cmd_home(args) -> int:
    d = data_home()
    print(f"platform:  {sys.platform}")
    print(f"data home: {d}{'' if d.exists() else '  (not created yet)'}")
    print(f"registry:  {registry_path()}")
    print(f"decks:     {d}/<name>/deck.yaml")
    print(f"state:     {d}/<name>/state.json")
    print(f"notes:     {d}/<name>/notes/")
    print(f"\n{C['dim']}Override with REPO_CARDS_HOME, or XDG_DATA_HOME on any platform.{C['reset']}")
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="repo-cards", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("command", nargs="?", default="review",
                   choices=["review", "test", "learn", "brief", "topics", "stats", "list",
                            "drift", "flags", "catchup", "check", "adopt", "export",
                            "import", "register", "forget", "repos", "home"])
    p.add_argument("path", nargs="?",
                   help="for `register`: repo root. for `forget`: the name. for `flags`: a card id. "
                        "for `adopt`: old-id=new-id pairs. for `import`: the deck to read")
    p.add_argument("--name", help="for `register`: deck name (default: directory name)")
    p.add_argument("--repo", help="limit to one registered repo")
    p.add_argument("--tag", help="limit to these tags (one name, or a comma-separated list)")
    p.add_argument("--grep", help="limit to cards matching this regex (question, answer, anchor, tags)")
    p.add_argument("--topic", help="limit to a curated topic (see `repo-cards topics`)")
    p.add_argument("--limit", type=int, help="cap the session length")
    p.add_argument("--all", action="store_true", help="ignore due dates (cram)")
    p.add_argument("--new", action="store_true", help="only cards never seen")
    p.add_argument("--mode", choices=["test", "learn"], default=None,
                   help="test hides the answer and grades; learn shows everything, grades nothing")
    p.add_argument("--no-pick", action="store_true",
                   help="skip the interactive picker and review everything due")
    p.add_argument("--full", action="store_true", help="for `drift`: full detail for every repo, not a summary")
    p.add_argument("--clear", action="store_true", help="for `flags`: clear them, once an update has dealt with them")
    p.add_argument("--since", help="for `catchup`: look back to this date instead of your last review")
    p.add_argument("--out", help="for `export`: write here (a .yaml file, or a directory that also takes notes/)")
    p.add_argument("--force", action="store_true", help="for `import`: replace an existing deck")
    p.add_argument("--strict", action="store_true", help="for `check`: fail on warnings as well as errors")
    p.add_argument("--errors-only", action="store_true", help="for `check`: print errors, not warnings")
    p.add_argument("--priority", type=int, choices=[1, 2, 3],
                   help="only cards at this priority (1 foundational, 2 core, 3 detail)")
    args = p.parse_args()
    # `learn` and `test` are review with the mode chosen up front.
    if args.command in ("learn", "test"):
        args.mode, args.command = args.command, "review"
    args.mode = args.mode or load_prefs().get("mode", "test")
    return {
        "review": cmd_review, "brief": cmd_brief, "topics": cmd_topics,
        "stats": cmd_stats, "list": cmd_list, "drift": cmd_drift, "flags": cmd_flags,
        "catchup": cmd_catchup, "check": cmd_check, "adopt": cmd_adopt,
        "export": cmd_export, "import": cmd_import,
        "register": cmd_register, "forget": cmd_forget, "repos": cmd_repos, "home": cmd_home,
    }[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
